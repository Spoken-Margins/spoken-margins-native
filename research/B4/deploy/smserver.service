# Rendered and installed by research/B4/deploy/deploy.sh (@PORT@ and
# @SERVER_ROOT@ are filled in there). Admin, on the box:
#   runuser -u smserver -- smserver block -state /var/lib/smserver TAG
#   runuser -u smserver -- smserver switch -public @SERVER_ROOT@ attest off
#   runuser -u smserver -- smserver publish-manifest -public @SERVER_ROOT@ FILE
#   runuser -u smserver -- smserver takedown-map -state /var/lib/smserver EPISODEKEY
#
# Listening maps (#551) need an AI provider key. Put one line,
# ANTHROPIC_API_KEY=..., in /etc/smserver/maps.env, owned by root with mode
# 0600: systemd reads it as root and hands only the variable to the service.
# Without the file the service still starts and refuses map uploads. The
# monthly spending cap and prices are the -maps-* flags below; they are
# private and never in config.json.
#
# The web app (#3020) is served from https://app.spokenmargins.com (#3062). During
# the move the old origin, https://app.spokenmargins.proximitytoprogress.com, stays
# listed beside it, because a page loaded there or an installed copy of the old app
# still calls this server; drop it once nothing uses that host.
# -relay-origins lets those origins, and only them, use the feed relay (#2985);
# the relay still answers 503 until the owner runs
#   runuser -u smserver -- smserver switch -public @SERVER_ROOT@ relay on
# and "relay off" stops it at once. -link-origins lets those origins read
# sealed share-link packets and previews (#3013); it creates no links, and
# with the links switch off those routes answer 503 anyway.
[Unit]
Description=Spoken Margins server (bridge and attestation)
After=network-online.target
Wants=network-online.target

[Service]
User=smserver
Group=smserver
ExecStart=/usr/local/bin/smserver serve -listen 127.0.0.1:@PORT@ -state /var/lib/smserver -public @SERVER_ROOT@ -behind-proxy -maps-cap-usd 10 -maps-model claude-haiku-5-5 -maps-input-usd-per-mtok 0.10 -maps-output-usd-per-mtok 0.50 -relay-origins https://app.spokenmargins.com,https://app.spokenmargins.proximitytoprogress.com -link-origins https://app.spokenmargins.com,https://app.spokenmargins.proximitytoprogress.com
EnvironmentFile=-/etc/smserver/maps.env
StateDirectory=smserver
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5

# The hourly request summary goes to its own journal namespace, so its
# retention (journald@smserver.conf) doesn't touch the rest of the box.
LogNamespace=smserver

# Keep a small service small, and contained if it is ever compromised. The
# public root is read-only to the service: config.json is created at install
# and changed only by the admin CLI running as smserver outside this sandbox.
MemoryMax=128M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/smserver
ReadOnlyPaths=@SERVER_ROOT@
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
