# NOT DEPLOYED. A template for the owner's VPS once hosting is decided.
# Validate with `caddy validate` before reloading.

# 1. Global options (top of /etc/caddy/Caddyfile). Caddy writes no access
#    log unless a site asks for one, and the existing Spoken Margins site
#    block doesn't. But Caddy's error logger (http.log.error) records the
#    full request, including the client IP and headers, whenever a handler
#    fails, for example when smserver is down. Headers carry the install's
#    key id, so strip those fields box-wide.
{
	log default {
		format filter {
			wrap console
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
			}
		}
	}
}

# 2. Inside the existing site block, before `file_server`:
spokenmargins.proximitytoprogress.com {
	root * /srv/www/spokenmargins
	encode gzip

	# Public, identical-for-everyone documents come straight from disk, so
	# they keep working (and the kill switch keeps being readable) when
	# smserver is stopped. The service reads the same config.json.
	@public path /api/v1/config.json /bridge/v1/manifest.json
	header @public Cache-Control "public, max-age=300"

	# Everything else under /api/ goes to the service on loopback.
	@api {
		path /api/*
		not path /api/v1/config.json
	}
	reverse_proxy @api 127.0.0.1:8787

	file_server
}
