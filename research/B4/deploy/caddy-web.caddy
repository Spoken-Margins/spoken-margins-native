app.spokenmargins.proximitytoprogress.com {
	# managed-by: spokenmargins-web (research/B4/deploy/deploy.sh)
	# The web app (Web/, a static Vite PWA, #3020), copied here by
	# deploy-web.sh. Its own host, because the feed relay and the share-link
	# reads answer only a listed Origin other than their own host. No log
	# directive, so Caddy writes no access log; the global filter strips
	# addresses and headers from its error log.
	root * /srv/www/spokenmargins-web
	encode gzip

	# The page, the service worker and the manifest are checked on every
	# visit, or an installed app never learns of a new build. Vite names
	# everything under /assets/ by its content, so those never change.
	@fresh path / /index.html /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options nosniff
		-Server
	}
	file_server
}
