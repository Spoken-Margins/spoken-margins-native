{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenmargins.local/schemas/watch-sync-event.schema.json",
  "title": "WatchSyncEvent",
  "type": "object",
  "required": ["schemaVersion", "id", "watchPackageId", "sessionId", "eventType", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "watch-sync-event.v1" },
    "id": { "type": "string", "minLength": 1 },
    "watchPackageId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "itemId": { "type": ["string", "null"] },
    "eventType": { "enum": ["playback_position", "interjection_recorded", "interjection_cancelled", "session_finished", "error"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mediaTimeMs": { "type": ["integer", "null"], "minimum": 0 },
        "chapterId": { "type": ["string", "null"] },
        "transcriptSegmentId": { "type": ["string", "null"] },
        "playbackRate": { "type": ["number", "null"], "minimum": 0.25, "maximum": 4 },
        "audioFileName": { "type": ["string", "null"] },
        "audioDurationMs": { "type": ["integer", "null"], "minimum": 0 },
        "error": { "type": ["string", "null"] }
      }
    }
  }
}
