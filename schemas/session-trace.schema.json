{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenmargins.local/schemas/session-trace.schema.json",
  "title": "SessionTrace",
  "type": "object",
  "required": ["schemaVersion", "name", "description", "fixtures", "steps", "assertions"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": "session-trace.v1" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "fixtures": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "null"]
      }
    },
    "controlProfile": { "type": "string" },
    "runtimeProfile": { "type": "string" },
    "requiresCapabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "event": { "type": "string" },
          "args": { "type": "object" },
          "expect": { "type": "object" }
        },
        "oneOf": [
          { "required": ["command", "expect"] },
          { "required": ["event", "expect"] }
        ]
      }
    },
    "assertions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
