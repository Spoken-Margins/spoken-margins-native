{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenmargins.local/schemas/conversation-turn.schema.json",
  "title": "ConversationTurn",
  "type": "object",
  "required": ["schemaVersion", "id", "sessionId", "role", "turnType", "status", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "conversation-turn.v1" },
    "id": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "role": { "enum": ["user", "assistant", "system"] },
    "turnType": {
      "enum": [
        "interjection_summary",
        "followup_question",
        "user_response",
        "assistant_response",
        "correction",
        "session_note",
        "addendum"
      ]
    },
    "status": { "enum": ["pending", "streaming", "complete", "failed", "cancelled"] },
    "summary": { "type": ["string", "null"] },
    "text": { "type": ["string", "null"] },
    "rawText": { "type": ["string", "null"] },
    "sourceInterjectionIds": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "error": { "type": ["string", "null"] }
  }
}
