{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenmargins.local/schemas/watch-audio-package.schema.json",
  "title": "WatchAudioPackage",
  "type": "object",
  "required": ["schemaVersion", "id", "itemId", "sessionId", "createdAt", "item", "audioAssets", "transcript", "chapters", "settings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "watch-audio-package.v1" },
    "id": { "type": "string", "minLength": 1 },
    "itemId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "item": {
      "type": "object",
      "required": ["title", "mediaType"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "mediaType": { "enum": ["text", "transcript_backed_media"] },
        "externalReference": { "type": ["string", "null"] }
      }
    },
    "audioAssets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["audioAssetId", "fileName", "durationMs"],
        "additionalProperties": false,
        "properties": {
          "audioAssetId": { "type": "string" },
          "fileName": { "type": "string" },
          "durationMs": { "type": "integer", "minimum": 0 },
          "sha256": { "type": ["string", "null"] }
        }
      }
    },
    "transcript": {
      "type": "object",
      "required": ["transcriptId", "segments"],
      "additionalProperties": false,
      "properties": {
        "transcriptId": { "type": "string" },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "startMs", "endMs", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "startMs": { "type": "integer", "minimum": 0 },
              "endMs": { "type": "integer", "minimum": 0 },
              "startChar": { "type": ["integer", "null"], "minimum": 0 },
              "endChar": { "type": ["integer", "null"], "minimum": 0 },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "startMs", "transcriptSegmentId"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "startMs": { "type": "integer", "minimum": 0 },
          "transcriptSegmentId": { "type": "string" }
        }
      }
    },
    "settings": {
      "type": "object",
      "required": ["rollbackUnit", "defaultPlaybackRate"],
      "additionalProperties": false,
      "properties": {
        "rollbackUnit": { "enum": ["previous_segment", "previous_sentence", "previous_paragraph", "time_15s", "none"] },
        "defaultPlaybackRate": { "type": "number", "minimum": 0.25, "maximum": 4 }
      }
    }
  }
}
