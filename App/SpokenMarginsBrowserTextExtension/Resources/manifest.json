{
  "manifest_version": 3,
  "name": "Spoken Margins Browser Text",
  "description": "Capture selected or readable page text and continue listening in Spoken Margins.",
  "version": "0.1",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "action": {
    "default_title": "Send to Spoken Margins",
    "default_popup": "popup.html"
  }
}
