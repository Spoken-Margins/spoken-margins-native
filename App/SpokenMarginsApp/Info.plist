			<string>com.spokenmargins.package</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>spokenmargins</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.spokenmargins.package+zip</string>
				</array>
			</dict>
		</dict>
	</array>
