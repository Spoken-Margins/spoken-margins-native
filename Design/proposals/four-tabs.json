{
 "name": "four-tabs",
 "title": "Four tabs: Library, Shows, Margins, Settings",
 "base": "../flow-map/flow-map.json",
 "base_commit": "32173207",
 "start": "ExperienceLibraryScreen",
 "summary": "Every home gets a name on the tab bar. Shows is a list of followed shows, sorted by newest episode, each row with its unplayed count and a play button for the newest; a show is a place you go, so a noisy one never floods anything, and Quiet shows sink to a collapsed group. The Library holds items only, one sortable list. Settings becomes a tab, which makes voice, storage, help and the import jobs cheap and gives feed management a visible neighbour. Following's stream and Manage feeds both go away.",
 "shared_fixes": [
  "Margins list newest first; a Margin row plays its moment and a chevron opens its details.",
  "Margin details offer Share this Margin (a one-Margin packet to the share sheet).",
  "Item details show the published date and the date added.",
  "Export all Margins is one toolbar button on the Margins tab that hands a Markdown bundle to the share sheet; the folder export moves under Settings.",
  "Settings is a tab. The Library's options menu is removed; Help lives in Settings.",
  "Clear reproducible audio is a button on Settings itself; Offline Storage keeps the detail.",
  "Unfollow lives on the Show screen with an Undo toast instead of a confirmation alert; no landing tab manages a feed.",
  "Settings sections: Voice, Storage, Notes folder, Import & export (collapsed to two rows), Help, About & legal (collapsed)."
 ],
 "groups": [
  "Library",
  "Shows",
  "Margins",
  "Now Playing",
  "Settings",
  "Sharing",
  "Outside the app"
 ],
