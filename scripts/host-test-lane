#!/usr/bin/env python3
"""Heavy host tests through the Mac-wide host-test slots (scripts/lane_slots.py, #350).

Usage: scripts/host-test-lane <command> [arguments]      e.g. scripts/host-test-lane swift test

- Waits for one of the two host-test slots (one while a simulator job runs), printing who holds
  them, then runs the command and exits with its exit code.
- Inside a run that already holds a slot (a verify-tests.py --plan fast run), it runs at once.
- A single-suite `swift test --filter` doesn't need it: after the first build it is incremental
  and short. Use it for a full `swift test` of the package.
"""
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lane_slots import host_test_slot  # noqa: E402


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__.strip())
        return 2
    with host_test_slot(f'host-test-lane {" ".join(argv)[:60]} in {Path.cwd()}'):
        return subprocess.call(argv)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
