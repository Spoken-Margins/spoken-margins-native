NO_CHECK = re.compile(
    r'^(?:none\s+(?:beyond|except|other than|apart from)\s+#\d+\b[^\n]*$|'
    r'(?:(?:none|n/?a|nothing)(?:\s+(?:this time|at this time|needed|required|for now|right now|now|yet|currently'
