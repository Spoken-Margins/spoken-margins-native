# ---- small helpers ------------------------------------------------------------------------------

def phone_dir() -> Path:
    return Path(os.environ.get('SM_PHONE_DIR') or Path.home() / 'SpokenMargins-phone')


def keep_count() -> int:
    return int(os.environ.get('SM_PHONE_KEEP', '3'))


def say(message: str) -> None:
    print(f'[phone-build] {message}', flush=True)


def git(*args, cwd=ROOT, check=True) -> str:
    done = subprocess.run(['git', *args], cwd=str(cwd), capture_output=True, text=True)
    if check and done.returncode != 0:
        raise RuntimeError(f'git {" ".join(args)} failed: {done.stderr.strip()}')
    return done.stdout.strip()


def gh(*args) -> str | None:
    """A gh call's output, or None when gh is missing, offline or refused (the plan says so)."""
    command = os.environ.get('SM_PHONE_GH', 'gh').split()
    try:
        done = subprocess.run([*command, *args], capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout if done.returncode == 0 else None


def free_disk_gb(path: Path) -> float:
    if os.environ.get('SM_PHONE_DISK_FREE_GB'):
        return float(os.environ['SM_PHONE_DISK_FREE_GB'])
    path.mkdir(parents=True, exist_ok=True)
    return shutil.disk_usage(str(path)).free / 1e9


def read_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def latest_build() -> dict:
    return read_json(phone_dir() / 'latest' / 'build.json')


def installed_sha() -> str | None:
    """The first word of installed.txt: the commit the Desktop installer last put on the phone."""
    try:
        words = (phone_dir() / 'installed.txt').read_text().split()
    except OSError:
        return None
    return words[0] if words and re.fullmatch(r'[0-9a-f]{7,40}', words[0]) else None


# ---- gates ---------------------------------------------------------------------------------------

def guard_reason() -> str | None:
    """Why a build shouldn't start now (memory, disk), or None."""
    level = lane_slots.memory_pressure_level()
    if level not in (1, None):
        return f'memory pressure is {lane_slots.PRESSURE_NAMES.get(level, level)}; a phone build needs normal'
    running = len(lane_slots.holders())
    needed = DISK_FLOOR_GB + DISK_PER_BUILD_GB * (running + 1)
    free = free_disk_gb(phone_dir())
    if free < needed:
        return (f'free disk is {free:.1f} GB; with {running} other build(s) running, a phone build needs '
                f'{needed} GB (10 plus 4 per build, this one included)')
    return None


# Each comment as one JSON line with the fields comment_trust reads (#1822).
COMMENT_JSON = '.[] | {body, author_association, user: {login: .user.login}} | @json'


def trusted_comment_lines(raw: str | None) -> list[dict]:
    """The comments of a `gh api ... --jq COMMENT_JSON` answer written by the owner, a collaborator or the bot."""
    found = []
    for line in (raw or '').split('\n'):  # not splitlines(): JSON leaves U+2028 and friends unescaped
        try:
            comment = json.loads(line)
        except ValueError:
            continue
        if isinstance(comment, dict):
            found.append(comment)
    return comment_trust.trusted_only(found)


def runner_tested(sha: str) -> str | None:
    """Evidence that the lane's host-test gate covers this commit, or None.

    The runner merges a PR as "Merge pull request #N: ..." and first posts a "Merge check (triage
    desk)" comment on it that says "Pushing `<sha7>` to next" (scripts/lane-runner.py merge_check).
    It can also safely re-merge an already-tested PR when next hasn't moved or its changes touch
    neither the PR's files nor build inputs. That report explicitly names the resulting re-merge;
    it is sufficient here too. The Test Desk checks interactions on next's merged tip.
    """
    subject = git('log', '-1', '--format=%s', sha)
    found = re.match(r'Merge pull request #(\d+): ', subject)
    if not found:
        return None
    raw = gh('api', f'repos/{REPO}/issues/{found.group(1)}/comments', '--paginate', '--jq', COMMENT_JSON)
    checks = [c.get('body') or '' for c in trusted_comment_lines(raw)
              if (c.get('body') or '').startswith('**Merge check (triage desk)')]
    if not checks:
        return None
    for body in '\n'.join(checks).split('**Merge check (triage desk)')[1:]:
        if f'Pushing `{sha[:7]}`' in body and ': PASS' in body.split('\n', 1)[0]:
            ran = re.search(r'- Ran: (.+?)\.?\n', body)
            return f'the lane runner tested this merge commit before pushing it (PR #{found.group(1)}' + \
                (f'; ran {ran.group(1)})' if ran else ')')
        if (': PASS, re-merged onto the newest next without re-testing.' in body.split('\n', 1)[0]
                and f'- So the re-merge `{sha[:7]}` goes to next not re-tested.' in body):
            return (f'the lane runner tested PR #{found.group(1)} and safely re-merged it without '
                    'repeating host tests; the Test Desk tests next\'s merged tip end to end')
    return None


def coalesce_reason(sha: str) -> str | None:
    """Hold automatic builds until an hour after the last start, without delaying an integration PASS.

    Fall back to last-attempt for existing installations that have not recorded a start yet.
    Timestamps without a zone are the old script's local times; timestamp() handles both formats.
    """
    previous = read_json(phone_dir() / 'last-start.json') or read_json(phone_dir() / 'last-attempt.json')
    try:
        started = datetime.datetime.fromisoformat(previous['at']).timestamp()
    except (KeyError, TypeError, ValueError, OverflowError, OSError):
        return None
    elapsed = datetime.datetime.now(datetime.timezone.utc).timestamp() - started
    if not 0 <= elapsed < BUILD_INTERVAL_SECONDS:
        return None
    verdict = latest_verdict(sha)
    if verdict and re.search(r' — PASS\b', verdict):
        return None
    minutes = int((BUILD_INTERVAL_SECONDS - elapsed + 59) // 60)
    return f'coalescing next\'s changes; next phone build in about {minutes} min, or after integration PASS'


# ---- test plan -----------------------------------------------------------------------------------

def plan_base(target: str) -> tuple[str | None, str]:
    """(base commit, how it was chosen) for "what changed since the owner's last install".

    The installed commit is the base whenever this checkout has it and it isn't ahead of the target, even when
    it isn't in next's history (a candidate built on this Mac before its changes reached next, #1100):
    merged_prs then lists what next has that the installed build lacks. A commit this checkout doesn't have,
    one newer than the target, or no installed.txt falls back to the last TestFlight build.
    """
    sha = installed_sha()

    def ancestor(older: str, newer: str) -> bool:
        return subprocess.run(['git', 'merge-base', '--is-ancestor', older, newer], cwd=str(ROOT),
                              capture_output=True).returncode == 0
    known = sha and subprocess.run(['git', 'cat-file', '-e', f'{sha}^{{commit}}'], cwd=str(ROOT),
                                   capture_output=True).returncode == 0
    behind = bool(known) and ancestor(sha, target)
    ahead = bool(known) and not behind and ancestor(target, sha)
    if known and not ahead:
        return sha, f'the build you last installed (`{sha[:7]}`, from installed.txt' + (
            ')' if behind else '; it isn\'t part of next\'s history, so this lists what next has beyond it)')
    tags = git('tag', '--list', 'testflight/*', '--sort=-creatordate', '--merged', target, check=False).split()
    if tags:
        why = ('nothing recorded in installed.txt yet' if not sha else
               f'installed.txt names `{sha[:7]}`, which is newer than this build' if ahead else
               f'installed.txt names `{sha[:7]}`, which this checkout doesn\'t have')
        return git('rev-list', '-1', tags[0]), f'the last TestFlight build, `{tags[0]}` ({why})'
    return None, 'no earlier build found'


def merged_prs(base: str | None, target: str) -> dict[int, str]:
    """{PR number: merge subject} for PRs merged into next between base and target, newest first."""
    span = f'{base}..{target}' if base else target
    merged: dict[int, str] = {}
    reverted = reverted_prs(target)  # merged and reverted since: not in this build (#1545)
    for subject in git('log', '--first-parent', '--format=%s', span, '-n', '400').splitlines():
        found = re.match(r'Merge pull request #(\d+)\b', subject)
        if found and int(found.group(1)) not in reverted:
            merged.setdefault(int(found.group(1)), subject)
    return merged


MERGE_SUBJECT = re.compile(r'Merge pull request #(\d+)\b')
REVERT_SUBJECT = re.compile(r'Revert #(\d+)\b')                 # ours and the lane runner's: "Revert #1371: ..."
REVERTS_BODY = re.compile(r'\bThis reverts (?:commit|merge) ([0-9a-f]{7,40})\b')
# A re-land lands every #N its subject names: "Re-land #1407 and ... (#1413)", "re-land episode map pins (#1183)".
RE_LAND = re.compile(r'\bre-?land(?:s|ed|ing)?\b', re.I)
_reverted: dict[str, set[int]] = {}


def reverted_prs(sha: str) -> set[int]:
    """The PRs merged into the build and then reverted, and not landed again (#1545: #1371 and #1404 were
    reverted inside #1482, so off the first-parent line, and the notes still asked for their checks).

    Every commit the build holds counts, oldest first. A revert is "Revert #N: ...", git's own
    'Revert "Merge pull request #N ..."', or a body "This reverts merge <sha>" naming a PR's merge. A
    revert of that revert, a "Re-land #N", or a later merge of #N lands it again.
    """
    if sha in _reverted:
        return _reverted[sha]
    # NUL and \x01 as separators: str.strip() treats \x1c-\x1f as whitespace and would eat an empty last body.
    log = git('log', '--topo-order', '--reverse', '--format=%H%x00%s%x00%b%x01', sha, check=False)
    merge_of: dict[str, int] = {}   # a PR's merge commit -> its number
    revert_of: dict[str, int] = {}  # a commit that reverted #N -> N
    state: dict[int, bool] = {}     # N -> reverted now

    def lookup(table: dict[str, int], short: str) -> int | None:
        return next((number for full, number in table.items() if full.startswith(short)), None)

    for record in log.split('\x01'):
        fields = record.strip('\n').split('\x00')
        if len(fields) < 3:
            continue
        commit, subject, body = fields[:3]
        rest, depth = subject, 0
        while rest.startswith('Revert "'):
            rest, depth = rest[len('Revert "'):], depth + 1
        merged, ours = MERGE_SUBJECT.match(rest), REVERT_SUBJECT.match(rest)
        number = None
        if ours:
            number, depth = int(ours.group(1)), depth + 1
        elif merged and depth:
            number = int(merged.group(1))
        elif REVERTS_BODY.search(body):
            short = REVERTS_BODY.search(body).group(1)
            if lookup(merge_of, short) is not None:
                number, depth = lookup(merge_of, short), 1
            elif lookup(revert_of, short) is not None:
                number, depth = lookup(revert_of, short), 2
        if number is not None:
            state[number] = depth % 2 == 1
            if state[number]:
                revert_of[commit] = number
            continue
        if merged:
            merge_of[commit] = int(merged.group(1))
            state[int(merged.group(1))] = False  # merged, or merged again
        if RE_LAND.search(subject):
            for again in re.findall(r'#(\d+)', subject):
                state[int(again)] = False
    _reverted[sha] = {number for number, now in state.items() if now}
    return _reverted[sha]


COMMENTS = 'comments(last:30){nodes{body authorAssociation author{login __typename}}}'  # a check written in a comment (#927)
PR_FIELDS = '''number title url mergedAt body labels(first:20){nodes{name}} files(first:100){nodes{path}}
closingIssuesReferences(first:5){nodes{number title url state body labels(first:20){nodes{name}} milestone{title state} %s}}''' % COMMENTS
ISSUE_FIELDS = 'number title url state body labels(first:20){nodes{name}} milestone{title state} ' + COMMENTS  # state: passed_on_phone (#1100)


def graphql(fields_by_alias: dict[str, str]) -> dict:
    """One GraphQL call for many items (aliases). {} when gh fails."""
    if not fields_by_alias:
        return {}
    owner, name = REPO.split('/')
    body = ' '.join(f'{alias}: {query}' for alias, query in fields_by_alias.items())
    raw = gh('api', 'graphql', '-f', f'query=query {{ repository(owner: "{owner}", name: "{name}") {{ {body} }} }}')
    try:
        return (json.loads(raw) if raw else {}).get('data', {}).get('repository', {}) or {}
    except ValueError:
        return {}


def linked_numbers(pr: dict) -> list[int]:
    """The issues a PR says it fixes: its title's "(#347, #355)" and its body's "Fixes #N" / "for #N"."""
    found = re.findall(r'#(\d+)', pr.get('title') or '') + re.findall(
        r'\b(?:fixes|fixed|closes|closed|resolves|for|part of|issue)\s+#(\d+)', pr.get('body') or '', re.I)
    return list(dict.fromkeys(int(n) for n in found if int(n) != pr.get('number')))


def fetch_prs(numbers: list[int]) -> dict[int, dict] | None:
    """PR details with their linked issues, or None when GitHub couldn't be reached."""
    prs: dict[int, dict] = {}
    for start in range(0, len(numbers), 25):
        chunk = numbers[start:start + 25]
        data = graphql({f'p{n}': f'pullRequest(number: {n}) {{ {PR_FIELDS} }}' for n in chunk})
        if not data:
            return None
        prs.update({int(alias[1:]): value for alias, value in data.items() if value})
    wanted = {}
    for pr in prs.values():
        linked = [issue['number'] for issue in pr['closingIssuesReferences']['nodes']]
        if not linked:
            # Closing keywords don't link issues on next (not the default branch), so read the
            # title's "(#347, #355)" and the body's "Fixes #N" / "for #N" by hand.
            linked = linked_numbers(pr)[:3]
            wanted.update({n: None for n in linked})
        pr['linked'] = linked
    issues = {issue['number']: issue for pr in prs.values() for issue in pr['closingIssuesReferences']['nodes']}
    missing = [n for n in wanted if n not in issues]
    for start in range(0, len(missing), 25):
        data = graphql({f'i{n}': f'issueOrPullRequest(number: {n}) {{ ... on Issue {{ {ISSUE_FIELDS} }} }}'
                        for n in missing[start:start + 25]})
        issues.update({int(alias[1:]): value for alias, value in data.items() if value and value.get('number')})
    for pr in prs.values():
        pr['issues'] = [issues[n] for n in pr['linked'] if n in issues]
    return prs


ITEM_FIELDS = '__typename ... on Issue { number title url state labels(first:20){nodes{name}} } ' \
    '... on PullRequest { number title url state }'


def fetch_items(numbers: list[int]) -> dict[int, dict]:
    """{number: issue or PR with its state} for the numbers a check names; {} when gh fails."""
    items: dict[int, dict] = {}
    for start in range(0, len(numbers), 25):
        batch = numbers[start:start + 25]
        data = graphql({f'n{n}': f'issueOrPullRequest(number: {n}) {{ {ITEM_FIELDS} }}' for n in batch})
        if not data and len(batch) > 1:  # gh fails the whole query when one number isn't an issue or PR
            for n in batch:
                data.update(graphql({f'n{n}': f'issueOrPullRequest(number: {n}) {{ {ITEM_FIELDS} }}'}))
        items.update({int(alias[1:]): value for alias, value in data.items() if value and value.get('number')})
    return items


WAITING_QUERY = '''query($cursor: String) { repository(owner: "%s", name: "%s") {
issues(states: %s, labels: ["%s"], first: 25, after: $cursor%s, orderBy: {field: CREATED_AT, direction: ASC}) {
pageInfo { hasNextPage endCursor }
nodes { %s createdAt closedAt
timelineItems(itemTypes: [CROSS_REFERENCED_EVENT], last: 25) { nodes { ... on CrossReferencedEvent {
source { ... on PullRequest { number title url body merged } } } } } } } } }'''

CLOSED_WINDOW_DAYS = 60  # a merged fix closes its issue and the label stays (owner, 2026-10-22), so look back this far


def fetch_waiting() -> list[dict] | None:
    """Issues marked `status: needs-human-validation` (dispatch adds it when their fix merges into the trunk),
    oldest first, with their comments and the PRs that mention them: the open ones, plus those closed in the
    last 60 days, because a merged fix closes its issue and the label stays on it (owner, 2026-10-22).
    None when GitHub can't be reached (#927)."""
    owner, name = REPO.split('/')
    since = (datetime.datetime.now(datetime.timezone.utc)
             - datetime.timedelta(days=CLOSED_WINDOW_DAYS)).strftime('%Y-%m-%dT%H:%M:%SZ')
    issues: list[dict] = []
    for states, extra in (('OPEN', ''), ('CLOSED', f', filterBy: {{since: "{since}"}}')):
        query = WAITING_QUERY % (owner, name, states, MERGED_ON_NEXT, extra, ISSUE_FIELDS)
        cursor = None
        for _ in range(20):  # 500 issues at most
            raw = gh('api', 'graphql', '-f', f'query={query}', *(['-f', f'cursor={cursor}'] if cursor else []))
            try:
                page = json.loads(raw)['data']['repository']['issues'] if raw else None
            except (ValueError, KeyError, TypeError):
                page = None
            if not isinstance(page, dict):
                return None
            issues += [issue for issue in page.get('nodes') or [] if issue and issue.get('number')
                       and (states == 'OPEN' or (issue.get('closedAt') or '') >= since)]
            info = page.get('pageInfo') or {}
            if not info.get('hasNextPage') or not info.get('endCursor'):
                break
            cursor = info['endCursor']
        else:
            return None  # Never publish a supposedly complete phone backlog after truncating it (#1600).
    return sorted(issues, key=lambda issue: issue.get('createdAt') or '')


def build_prs(sha: str) -> set[int]:
    """The PRs merged into the build: its first-parent "Merge pull request #N" subjects, less those reverted."""
    subjects = git('log', '--first-parent', '--format=%s', sha, check=False)
    return {int(n) for n in re.findall(r'(?m)^Merge pull request #(\d+)\b', subjects)} - reverted_prs(sha)


def held_for(issues: list[dict]) -> str | None:
    """The milestone a change waits for when it has issues and every one sits in a held milestone, else None."""
    titles = [(issue.get('milestone') or {}).get('title') for issue in issues]
    return titles[0] if titles and all(title in HELD_MILESTONES for title in titles) else None


def lead_tier(issue: dict, in_current: bool) -> int:
    """Where an issue's check goes among the owner's checks, 0 first: the current milestone's `priority` fixes,
    then its fixes found on his phone, then its others, then phone-found fixes elsewhere, then the rest. A
    `validate-by-use` fix is checked by his ordinary listening, so its labels don't move it up (AGENTS.md,
    2026-10-15)."""
    names = labels(issue)
    if VALIDATE_BY_USE in names:
        return 2 if in_current else 4
    if in_current:
        return 0 if PRIORITY in names else 1 if FIRST_ON_PHONE & names else 2
    return 3 if FIRST_ON_PHONE & names else 4


def leads(issues: list[dict]) -> bool:
    """A change or fix that leads the owner's checks: one of its issues is in the current milestone and marked
    `priority` or found on his phone (2026-10-16: #1708 and #1337 never reached his plans)."""
    return any(lead_tier(issue, (issue.get('milestone') or {}).get('title') == CURRENT_MILESTONE) <= 1
               for issue in issues)


def waiting_fixes(issues: list[dict], built: set[int], shown: set[int], named_in_build: set[int] = frozenset(),
                  reverted: set[int] = frozenset()) -> list[dict]:
    """The issues still waiting on the owner's check whose fix is in this build, in plan order by lead_tier
    (the current build milestone first, `priority` then found on the phone), then oldest (#927). `shown` holds
    the issue and PR numbers the plan already lists. Each is {'issue', 'prs': its fixing PRs in the build,
    'check': the check to try, or None, 'none': True when an issue says there is no check, and 'lead': True
    for the current milestone's priority and phone-found fixes, which the plan always lists}.

    `built` holds the build's merged PRs, `named_in_build` every #N its merge subjects name. The fix is in the
    build when a merged PR there says it fixes the issue (title "(#854)", "Closes #854"), the issue's
    comments name one ("Merged in #907", "PR #257"), or a merge names the issue ("Merge play-this-moment
    into next (#156, #158)"). The label alone isn't enough: the fix may have merged after this build
    (#927: the label had been read as "waiting on your phone").

    An issue is left out when any of its fixing PRs is in `reverted`: merged, then reverted and not landed
    again (#1545: #447's logic PR #1356 stayed but its screen PR #1371 was reverted, and the notes asked the
    owner to check a screen that wasn't there).
    """
    def build_number(issue):
        milestone = issue.get('milestone') or {}
        if milestone.get('title') == CURRENT_MILESTONE:
            return 0
        found = re.fullmatch(r'Build (\d+)', milestone.get('title') or '')
        return int(found.group(1)) if found and milestone.get('state', 'OPEN') == 'OPEN' else None
    current = min((n for n in map(build_number, issues) if n is not None), default=None)
    fixes = []
    for issue in issues:
        comments = [comment.get('body') or '' for comment in trusted_nodes(issue)]
        named = {int(a or b) for body in comments for a, b in FIXED_IN.findall(body)}
        sources = [(node or {}).get('source') or {} for node in (issue.get('timelineItems') or {}).get('nodes') or []]
        prs = {pr['number']: pr for pr in sources if pr.get('number') in built and pr.get('merged')
               and (issue['number'] in linked_numbers(pr) or pr['number'] in named)}
        if named & set(reverted) or any(pr.get('number') in reverted and pr.get('merged')
                                        and issue['number'] in linked_numbers(pr) for pr in sources):
            continue
        for number in sorted(named & built - set(prs)):
            prs[number] = {'number': number, 'title': '', 'body': '', 'url': f'https://github.com/{REPO}/pull/{number}'}
        if prs and set(prs) <= ACCEPTED_PR_CHECKS:
            continue
        prs = {number: pr for number, pr in prs.items() if number not in ACCEPTED_PR_CHECKS}
        if not (prs or issue['number'] in named_in_build) or issue['number'] in shown or shown & set(prs):
            continue
        body = next((pr.get('body') or '' for pr in prs.values() if check_field(pr.get('body') or '')), '')
        alone = {'issues': [issue], 'body': body}
        none = says_no_check(alone)
        check = None if none else owner_check(alone)
        tier = lead_tier(issue, current is not None and build_number(issue) == current)
        fixes.append({'issue': issue, 'prs': list(prs.values()), 'check': check, 'none': none,
                      'refused': [] if check or none else refused_in(alone), 'held': held_for([issue]),
                      'tier': tier, 'lead': tier <= 1})
    fixes.sort(key=lambda fix: (fix['tier'], fix['issue'].get('createdAt') or ''))
    return fixes


def built_numbers(sha: str) -> set[int]:
    """Every #N in the build's merge subjects: the PRs merged into it and the issues their titles name.
    A reverted PR's merge, and a revert, name nothing built (#1545)."""
    reverted = reverted_prs(sha)
    numbers: set[int] = set()
    for subject in git('log', '--first-parent', '--format=%s', sha, check=False).splitlines():
        merged = MERGE_SUBJECT.match(subject)
        if merged and int(merged.group(1)) in reverted or re.match(r'(?:Merge pull request #\d+: )?Revert\b', subject):
            continue
        numbers |= {int(n) for n in re.findall(r'#(\d+)', subject)}
    return numbers - reverted


def references(check: str) -> list[int]:
    return list(dict.fromkeys(int(a or b) for a, b in REFERENCE.findall(check)))


def waiting_on(check: str, own: set[int], built: set[int], items: dict[int, dict]) -> list[dict]:
    """The issues and PRs a check names that aren't on the phone yet ("after #547 is also on the phone").

    Its own issues and PRs don't count, nor anything a merge in this build names. An issue stays
    open after its PR merges into next, so an open issue counts as built once dispatch has marked it
    `status: needs-human-validation`. A PR counts once it is in this build; one closed unmerged never
    will be, so it doesn't hold the check back. A number GitHub didn't answer for doesn't either.
    """
    waiting = []
    for number in references(check):
        item = items.get(number)
        if number in own or number in built or not item:
            continue
        if item.get('__typename') == 'PullRequest':
            pending = item['state'] != 'CLOSED'
        else:
            pending = item['state'] == 'OPEN' and MERGED_ON_NEXT not in labels(item)
        if pending:
            waiting.append(item)
    return waiting


def listener_facing(pr: dict) -> bool:
    """Changes something a listener sees or hears: the scorecard's rule on #337, made mechanical.

    App code or SessionKit sources changed (tests and fixtures don't count), the title isn't a pure
    move, test or tooling change, and it isn't lane work (#374 touched SessionKit only to build on Linux).
    """
    if NOT_LISTENER_LABELS & labels(pr):
        return False
    paths = [node['path'] for node in pr['files']['nodes']]
    touches = any(p.startswith(LISTENER_PATHS) and not p.startswith(NOT_LISTENER_PATHS) for p in paths)
    return touches and not NOT_LISTENER_TITLE.search(pr['title'])


def check_field(text: str, field: re.Pattern = CHECK_FIELD) -> str | None:
    """A body's "Owner check" field (or another `field`): its line, plus the numbered steps, bullets,
    quote or fenced block right under it (#847: "after #551 is deployed:" lost its three steps), up to
    the next field. Written as a heading ("## Steps"), the field is the section under it (#927)."""
    lines = text.splitlines()
    heading = HEADINGS.get(field)
    for index, line in enumerate(lines):
        match = field.search(line)
        if match:
            break
        found = heading and heading.match(line)
        if found:
            return heading_section(lines[index + 1:], (found.groups() or ('',))[0] or '')
    else:
        return None
    first = NEXT_FIELD_ON_LINE.sub('', next((group for group in match.groups() if group), '')).strip()
    # "4. Owner check: ..." in a numbered Done when list: item 5 is the next item, not its step (#927).
    item = LIST_MARKER.match(line)
    item_indent = len(item.group(1)) if item and not line[item.end():match.start()].strip() else None
    rest: list[str] = []
    fenced = False
    last = 0  # the last number among the steps: "4. Owner check:" may be followed by "1. ..." at the same indent
    for line in lines[index + 1:]:
        sibling = LIST_MARKER.match(line)
        number = re.match(r'\s*(\d+)[.)]\s', line)
        if sibling and number and (int(number.group(1)) == 1 or int(number.group(1)) == last + 1 > 1) and \
                len(sibling.group(1)) <= (item_indent or 0) and item_indent is not None:
            last = int(number.group(1))
            rest.append(line.rstrip())
            continue
        if fenced:
            rest.append(line.rstrip())
            fenced = not line.strip().startswith('```')
        elif FIELD_START.match(line):
            break
        elif item_indent is not None and sibling and len(sibling.group(1)) <= item_indent:
            break
        elif not line.strip():
            if not rest and first and not first.endswith(':'):
                break
            continue  # a blank line inside the steps, or between "...:" and them
        elif STEP_LINE.match(line):
            rest.append(line.rstrip())
            fenced = line.strip().startswith('```')
        elif not first and not rest:
            first = line.strip()  # "**Owner check:**" alone on its line, the check on the next
        else:
            break
    return '\n'.join([first] + rest).strip() or None


def heading_section(lines: list[str], first: str = '') -> str | None:
    """The section under a "## Owner check" or "## Steps" heading: its first paragraph and the steps, bullets
    or fenced block after it, up to the next heading, rule, bold field or other paragraph (#811's PR
    footer isn't a step). Blank lines go, except inside a fenced block. `first` is text on the heading line
    itself ("## Owner check: none")."""
    if NO_CHECK.match(first.strip()):
        return first.strip()  # "## Owner check: none" is the whole answer
    kept: list[str] = [first.strip()] if first.strip() else []
    fenced = gap = False
    for line in lines:
        if fenced:
            kept.append(line.rstrip())
            fenced = not line.strip().startswith('```')
        elif re.match(r'\s{0,3}(?:#{1,6}\s|---)', line) or re.match(r'\s*(?:[-*+]\s+)?' + FIELD, line):
            break
        elif not line.strip():
            gap = bool(kept)
        elif gap and not STEP_LINE.match(line):
            break
        else:
            kept.append(line.rstrip())
            fenced = line.strip().startswith('```')
    return '\n'.join(kept).strip() or None


def trusted_nodes(issue: dict) -> list[dict]:
    """An issue's GraphQL comment nodes written by the owner, a collaborator or a member (#1822), oldest first.

    A stranger's "Owner check: none" or "Merged in #N" is data: it must not take a fix off the owner's plan.
    """
    return comment_trust.trusted_only([node for node in (issue.get('comments') or {}).get('nodes') or [] if node])


def comment_check(issue: dict) -> str | None:
    """The newest "Owner check" or "Phone check" in an issue's comments (#927: #180's, #158's and #237's
    checks were written there), or "none (...)" when the newest such comment takes it off the plans
    (#288: "Leave this off the owner's plans until ..."). The hourly dispatch's prose counts too ("This needs
    the owner's Bluetooth headphones: ..."): #1708's only check was written that way. GitHub lists comments
    oldest first."""
    for comment in reversed(trusted_nodes(issue)):
        body = comment.get('body') or ''
        off = next((line.strip() for line in body.splitlines() if OFF_PLANS.search(line)), None)
        if off:
            return f'none ({off})'
        check = check_field(body) or dispatch_check(body)
        if check:
            return check
    return None


def dispatch_check(body: str) -> str | None:
    """The check in a dispatch comment's "This needs the owner's <phone or headphones>: <steps>", without its
    closing "Stays open in Solid Ground until he confirms."; None when there is none."""
    found = DISPATCH_CHECK.search(body)
    return DISPATCH_TAIL.sub('', found.group(2)).strip() or None if found else None


def issue_check(issue: dict) -> str | None:
    """An issue's check: the newest one in its comments wins over its body's (#927)."""
    return comment_check(issue) or check_field(issue.get('body') or '')


def written_checks(pr: dict) -> list[str]:
    """Every "Owner check" field, issues first, then the PR's own."""
    checks = [issue_check(issue) for issue in pr['issues']] + [check_field(pr.get('body') or '')]
    return [check for check in checks if check]


def taken_off(pr: dict) -> bool:
    """A linked issue's newest comment says there's no check, and no other issue's comment gives one: a
    later call than any body, the PR's included."""
    checks = [check for check in map(comment_check, pr['issues']) if check]
    return bool(checks) and all(NO_CHECK.match(check) for check in checks)


def says_no_check(pr: dict) -> bool:
    """An issue or the PR says "Owner check: none" and nothing gives a real one."""
    checks = written_checks(pr)
    return taken_off(pr) or bool(checks) and all(NO_CHECK.match(check) for check in checks)


def unusable_check(check: str) -> str | None:
    """Why the owner can't use a check in his ten minutes on the phone (#1476), or None when he can.

    A lane or agent procedure (a script, a simulator, a commit to run at, a log file), or a reading of
    diagnostics, an export or a log, which an agent judges unless the check says what the result should be.
    Or a pointer to steps written somewhere else.
    """
    if POINTER_ONLY.match(check):
        return 'it points to steps written elsewhere ("the step above"); write the steps in the check itself'
    if LANE_PROCEDURE.search(check):
        return 'it names a script, simulator, commit to run at or log file, which the lane and the Test Desk run'
    if DIAGNOSTICS_READING.search(check):
        return 'it asks him to read a diagnostics field, which an agent does'
    if EXPORT_READING.search(check) and not EXPECTED_RESULT.search(check):
        return 'it says to read an export or log but not what it should show: write the expected result, or let an agent judge it'
    return None


def refused_in(pr: dict) -> list[str]:
    """The written checks of a PR's issues and its own body that unusable_check refuses, as
    "#N (why)" so the run can name which "Owner check:" line to rewrite (#1476)."""
    named = [(f'#{issue["number"]}', issue_check(issue)) for issue in pr['issues']]
    named.append((f'PR #{pr["number"]}' if pr.get('number') else 'the PR', check_field(pr.get('body') or '')))
    return [f'{who} ({unusable_check(check)})' for who, check in named
            if check and not NO_CHECK.match(check) and unusable_check(check)]


def owner_check(pr: dict) -> str | None:
    """The issue's "Owner check" line; else a bug report's Steps and Expected; else the PR's own.

    "Owner check: none" counts as no check, so it never reaches the plan as a thing to try; said in an
    issue's newest comment, it holds even when the PR's body has one (#927). A check he can't run is no
    check (#1476): the next one that he can wins.
    """
    if taken_off(pr):
        return None
    for check in written_checks(pr):
        if not NO_CHECK.match(check) and not unusable_check(check):
            return check
    texts = [issue.get('body') or '' for issue in pr['issues']] + [pr.get('body') or '']
    for text in texts:
        steps, expected = check_field(text, STEPS_FIELD), check_field(text, EXPECTED_FIELD)
        if steps and expected:  # numbered Steps keep every step (#847: #585 lost the swipe in step 2)
            numbered = chr(10) in steps or STEP_LINE.match(steps)
            found = f'{steps}{chr(10) if numbered else " "}Expected: {expected}'
            if not unusable_check(found):
                return found
    return None


def plan_entries(facing: list[dict]) -> list[list[dict]]:
    """Listener-facing PRs grouped into one entry per feature, in the order given (#427).

    PRs that link the same issue, or whose owner check reads the same, are one thing to try: two
    Follow PRs once gave the owner the same check twice. An entry is its PRs, first one leading.
    """
    entries: list[list[dict]] = []
    by_key: dict[object, list[dict]] = {}
    for pr in facing:
        check = owner_check(pr)
        keys = [('issue', issue['number']) for issue in pr['issues']]
        if check:
            keys.append(('check', ' '.join(check.lower().split())))
        entry = next((by_key[key] for key in keys if key in by_key), None)
        if entry is None:
            entry = []
            entries.append(entry)
        entry.append(pr)
        for key in keys:
            by_key.setdefault(key, entry)
    return entries


def screens_of(entry: list[dict]) -> set[str]:
    """The screens an entry's PRs change: those whose view files they touch (SCREEN_FILES)."""
    return {name for pr in entry for node in pr['files']['nodes'] for name, pattern in SCREEN_FILES.items()
            if pattern.match(node['path'])}


def screen_changes(entries: list[list[dict]]) -> tuple[list[dict], list[list[dict]]]:
    """Pull out of the entries the screens that several merges changed (#1476). Returns
    ([{'screen': name, 'prs': [...]}], the entries that stay), the screens in SCREEN_FILES order.

    A screen counts when SCREEN_MERGES or more PRs touch its view files. Those PRs leave their entries (a PR
    that only shares an issue with them stays, with its own title and check), so no PR's title hides behind
    another's and the owner meets the whole redesign as one item.
    """
    groups = []
    stay = [list(entry) for entry in entries]
    for name in SCREEN_FILES:
        touching = [pr for entry in stay for pr in entry if name in screens_of([pr])]
        if len(touching) >= SCREEN_MERGES:
            groups.append({'screen': name, 'prs': touching})
            stay = [kept for kept in ([pr for pr in entry if not any(pr is gone for gone in touching)]
                                      for entry in stay) if kept]
    return groups, stay


def found_on_phone(entry: list[dict]) -> bool:
    return any(FIRST_ON_PHONE & labels(issue) for pr in entry for issue in pr['issues'])


STILL_UNCHECKED = {'found-on-phone', 'needs-human-validation', MERGED_ON_NEXT}


def passed_on_phone(entry: list[dict]) -> bool:
    """Every issue the entry fixes is closed and carries no phone-validation label, so it never goes on a
    plan again (#1100). An entry with no linked issue has nothing to close and stays.

    Since 2026-10-22 a merged fix closes its issue and `found-on-phone` or `needs-human-validation` stays on
    it, so closed alone no longer means the owner passed it; a failed check reopens the issue instead.

    No timestamps: a follow-up PR can merge after its issue closed (#223 closed 10-04, PR #677 merged 10-05) and
    the owner records the pass as a comment, so closedAt never moves past the merge."""
    issues = [issue for pr in entry for issue in pr['issues']]
    return bool(issues) and all(issue.get('state') == 'CLOSED' and not STILL_UNCHECKED & labels(issue)
                                for issue in issues)


def labels(item: dict) -> set[str]:
    return {node['name'] for node in item.get('labels', {}).get('nodes', [])}


def report_comments() -> list[str] | None:
    """The bodies of the comments on #184, oldest first; None when gh fails (the plan says unknown)."""
    raw = gh('api', f'repos/{REPO}/issues/{REPORTS_ISSUE}/comments', '--paginate', '--jq', COMMENT_JSON)
    if raw is None:
        return None
    return [c['body'] for c in trusted_comment_lines(raw) if isinstance(c.get('body'), str)]


def report_lines(bodies: list[str], kind: str, sha: str) -> list[str] | None:
    """The lines of the newest `Lane report <kind>-<sha7>` report, starting at its first line, if any.

    The reports are posted inside a ```text fence, so the fence and blank lines before it are skipped.
    """
    wanted = f'Lane report {kind}-{sha[:7]}'
    for body in reversed(bodies):
        lines = [line.strip().replace('**', '') for line in body.splitlines()]
        start = next((i for i, line in enumerate(lines) if line and not line.startswith('```')), None)
        first = lines[start] if start is not None else ''
        if first.startswith(wanted) and first[len(wanted):len(wanted) + 1] in ('', ' '):
            return lines[start:]
    return None


def report_line(bodies: list[str], kind: str, sha: str) -> str | None:
    """The first line of the newest `Lane report <kind>-<sha7>` report, if any."""
    lines = report_lines(bodies, kind, sha)
    return lines[0] if lines else None


def integration_skip(bodies: list[str], sha: str) -> str | None:
    """Why the Test Desk skipped --plan app on this commit, from its journeys report's
    `integration: skipped (<why>)` line (#627), if it did."""
    for line in report_lines(bodies, 'journeys', sha) or []:
        if line.startswith('```'):
            break
        match = re.fullmatch(r'integration: skipped \((.+)\)', line)
        if match:
            return match.group(1).rstrip('.')
    return None


# Lines of a lane report that say something was left out, failed or went wrong: the plan carries them
# whole, not just the report's first line (#1465).
CARRIED_LINES = re.compile(r'(failing|flaky|crashes|why inconclusive|merges since the last PASS|not run|not verified'
                           r'|integration: skipped)\b', re.I)
QUIET_LINE = re.compile(r':\s*(none( this run| recorded)?|n/a)?\.?$', re.I)  # "failing:", "flaky: none this run"
OUTCOME_WORDS = {'PASS': 'pass', 'FAIL': 'fail', 'INCONCLUSIVE': 'not run (inconclusive)'}


def report_body(bodies: list[str], kind: str, sha: str) -> list[str]:
    """The lines of a `Lane report <kind>-<sha7>` report up to its closing fence, or []."""
    body = []
    for line in report_lines(bodies, kind, sha) or []:
        if line.startswith('```'):
            break
        body.append(line)
    return body


def report_verdict(lines: list[str]) -> str | None:
    match = re.search(r'\u2014 (PASS|FAIL|INCONCLUSIVE)\b', lines[0]) if lines else None
    return match.group(1) if match else None


def scripted_journeys_outcome(lines: list[str]) -> tuple[str, str]:
    line = next((l for l in lines if l.startswith('scripted journeys')), None)
    if line is None:
        return 'not run', 'the integration report lists no scripted journeys'
    detail = line.split(':', 1)[-1].strip()
    if re.search(r'\b(failed|missing)\b', detail):
        return 'fail', detail
    # Only an all-passed line is a pass: a journey that was skipped or never ran leaves the rest unproven.
    unproven = re.search(r'\b(not_run|skipped)\b', detail)
    return ('pass' if re.search(r'\bpassed\b', detail) and not unproven else 'not run'), detail


def commit_record(reports: list[str] | None, sha: str) -> list[tuple[str, str, str]]:
    """One record per exact commit: (what, pass | fail | not run, detail) for each kind of check, the
    integration run and the journeys report read for this commit only (#1465). A kind nobody reported on
    is `not run`, never left out."""
    if reports is None:
        unknown = f'GitHub could not be reached, so #{REPORTS_ISSUE} is unread'
        return [('App tests', 'unknown', unknown), ('Release device build', 'pass', 'this build, signed'),
                ('Scripted journeys', 'unknown', unknown), ('Attended journeys', 'unknown', unknown),
                ('Upgrade from the last shipped build', 'unknown', unknown),
                ('Phone checks', 'not run', 'yours: the checks below')]
    integration = report_body(reports, 'integration', sha)
    journeys = report_body(reports, 'journeys', sha)
    verdict = report_verdict(integration)
    ran = next((l for l in integration if re.match(r'(\d+\. )?(ran: )?--plan app', l)), '')
    skip = integration_skip(reports, sha)
    app = (OUTCOME_WORDS[verdict], ran or integration[0]) if verdict else \
        ('not run', f'skipped by the Test Desk: {skip}' if skip else 'no integration report for this commit')
    scripted = scripted_journeys_outcome(integration) if verdict in ('PASS', 'FAIL') else \
        ('not run', 'the integration run did not finish' if verdict else 'no integration run')
    attended_verdict = report_verdict(journeys)
    attended = (OUTCOME_WORDS[attended_verdict], journeys[0]) if attended_verdict else \
        ('not run', 'agent-driven journeys need an attended session')
    upgrade_line = next((l for l in [*integration, *journeys] if re.match(r'upgrade\b', l, re.I)), None)
    # Pass or fail only when the line says so; "skipped", "blocked", "not run" and the rest are not run.
    if upgrade_line is None:
        upgrade = ('not run', 'no upgrade check was reported for this commit')
    elif re.search(r'\b(not run|skipped|blocked|inconclusive)\b|\b0 failed\b', upgrade_line, re.I) is None \
            and re.search(r'\bfail', upgrade_line, re.I):
        upgrade = ('fail', upgrade_line)
    elif re.search(r'\b(not run|skipped|blocked|inconclusive|fail\w*)\b', upgrade_line, re.I) is None \
            and re.search(r'\bpass', upgrade_line, re.I):
        upgrade = ('pass', upgrade_line)
    else:
        upgrade = ('not run', upgrade_line)
    return [('App tests', *app), ('Release device build', 'pass', 'this build, signed'),
            ('Scripted journeys', *scripted), ('Attended journeys', *attended),
            ('Upgrade from the last shipped build', *upgrade), ('Phone checks', 'not run', 'yours: the checks below')]


def outcome_lines(reports: list[str] | None, sha: str) -> list[str]:
    """The plan's section on what was and wasn't tested on this commit, with every exclusion and failure the
    reports name, not only their first lines (#1465)."""
    lines = ['## What was tested on this commit', '']
    lines += [f'- {what}: **{status}**' + (f' ({detail})' if detail else '')
              for what, status, detail in commit_record(reports, sha)]
    carried = []
    for kind in ('integration', 'journeys') if reports is not None else ():
        for line in report_body(reports, kind, sha)[1:]:
            if CARRIED_LINES.match(line) and not QUIET_LINE.search(line) and line not in carried:
                carried.append(line)
    if carried:
        lines += ['', 'The reports also say:', ''] + [f'- {line}' for line in carried]
    return lines + ['']


def latest_verdict(sha: str, bodies: list[str] | None = None) -> str | None:
    """The newest integration report on #184 for this commit, whoever ran it (#444)."""
    bodies = report_comments() if bodies is None else bodies
    return report_line(bodies, 'integration', sha) if bodies is not None else None


def step_lines(check: str, sha: str, folder: Path) -> list[str]:
    """A check as plan lines that carry what it needs (#847): its steps under it, a URL in code as a
    link, and a repo file it names (a packet, a PDF) copied into the build's files/ folder, which
    share_files puts next to the plan in iCloud Drive."""
    head, *tail = CODE_URL.sub(r'<\1>', check).split('\n')
    if STEP_LINE.match(head):
        head, tail = '', [head, *tail]
    lines = [f'   - Check: {head}'.rstrip()] + [f'     {line}'.rstrip() for line in tail]
    for name in attach_files(check, sha, folder):
        lines.append(f'   - File: `{name}` comes with this plan. On the phone: Files > iCloud Drive > '
                     f'Spoken Margins test plans > Test plan {sha[:7]} files. On the Mac: the files folder '
                     'next to this plan.')
    return lines


def repo_files(check: str, sha: str) -> list[str]:
    """The repo files a check names in backticks that exist, as files, in the built commit."""
    paths = []
    for path in dict.fromkeys(REPO_FILE.findall(check)):
        spec = f'{sha}:{path}'
        size = git('cat-file', '-s', spec, check=False)
        if git('cat-file', '-t', spec, check=False) == 'blob' and size.isdigit() and int(size) <= ATTACH_LIMIT:
            paths.append(path)
    return paths


def missing_material(check: str, sha: str) -> str | None:
    """The kind of test file a check asks for ("PDF", "packet") when it carries no link and names no repo
    file to attach, so the owner would have nothing to test with (#1038); None when it needs none."""
    found = MATERIAL.search(check)
    if not found and NAMED_DOCUMENT.search(check) and not (SUPPLIED_URL.search(check) or repo_files(check, sha)):
        return 'document'  # "the arXiv paper" with no link (#1476)
    if not found or SUPPLIED_URL.search(check) or repo_files(check, sha):
        return None
    kind = (found.group(1) or 'packet').lower()
    return {'pdf': 'PDF', 'epub': 'EPUB'}.get(kind, kind)


def attach_files(check: str, sha: str, folder: Path) -> list[str]:
    """Copy the repo files a check names in backticks, as of the built commit, into folder/files."""
    names = []
    for path in repo_files(check, sha):
        data = subprocess.run(['git', 'cat-file', 'blob', f'{sha}:{path}'], cwd=str(ROOT), capture_output=True).stdout
        (folder / 'files').mkdir(exist_ok=True)
        (folder / 'files' / Path(path).name).write_bytes(data)
        names.append(Path(path).name)
    return names


def icloud_dir() -> Path:
    """The iCloud Drive folder the Desktop installer copies plans to (scripts/install-phone-build.command)."""
    return Path(os.environ.get('SM_PHONE_ICLOUD') or Path.home() / 'Library/Mobile Documents/com~apple~CloudDocs'
                / 'Spoken Margins test plans')


def share_files(folder: Path, sha: str) -> None:
    """Put the plan's files/ in iCloud Drive as "Test plan <sha7> files", where the plan's steps say they are.

    Done here, not by the installer, so the owner's Desktop copy of the installer needn't change (#847).
    A files folder goes once its plan has left iCloud Drive (the installer keeps five) and its build has
    left ~/SpokenMargins-phone. Trouble here never fails the build: the files are still in the folder.
    """
    icloud = icloud_dir()
    if not icloud.parent.is_dir():
        return  # no iCloud Drive on this Mac
    try:
        target = icloud / f'Test plan {sha[:7]} files'
        shutil.rmtree(str(target), ignore_errors=True)
        if (folder / 'files').is_dir():
            icloud.mkdir(exist_ok=True)
            shutil.copytree(str(folder / 'files'), str(target))
        if not icloud.is_dir():
            return
        kept = {build.name.rsplit('-', 1)[-1] for build in phone_dir().iterdir() if build.is_dir()}
        for old in icloud.glob('Test plan * files'):
            sha7 = old.name[len('Test plan '):-len(' files')]
            ours = re.fullmatch(r'[0-9a-f]{7}', sha7) and old.is_dir()  # never the owner's own folders
            if ours and sha7 not in kept and not (icloud / f'Test plan {sha7}.md').exists():
                shutil.rmtree(str(old), ignore_errors=True)
    except OSError as error:
        say(f"couldn't copy the plan's files to iCloud Drive ({error}); they are in {folder / 'files'}")


def write_plan(folder: Path, sha: str, checks: str, commit_in_app: bool = True) -> Path:
    base, base_why = plan_base(sha)
    merged = merged_prs(base, sha)
    prs = fetch_prs(list(merged)) if merged else {}
    where = (f'Settings > Version ends with `{sha[:7]}`' if commit_in_app else
             'Settings > Version shows only the build number: this commit predates the key that names the commit')
    lines = [f'# Phone build `{sha[:7]}`: what to try', '',
             f'Built {datetime.datetime.now().strftime("%Y-%m-%d %H:%M")} from next at `{sha[:7]}`. {where}.', '',
             f'Changes since {base_why}.', '',
             f'Checks before this build: {checks}.', '']
    reports = report_comments()
    verdict = latest_verdict(sha, reports) if reports is not None else None
    skip = integration_skip(reports, sha) if reports is not None and not verdict else None
    lines += [f'Latest integration run for this commit: {verdict}.' if verdict else
              f'Integration run skipped by the Test Desk: {skip}.' if skip else
              'No integration run has reported on this commit yet.' if reports is not None else
              f'GitHub could not be reached, so the integration verdict (on #{REPORTS_ISSUE}) is unknown.']
    journeys = report_line(reports, 'journeys', sha) if reports is not None else None
    if journeys:
        lines.append(f'Latest journeys run for this commit: {journeys}.')
    lines += ['', *outcome_lines(reports, sha)]
    path = folder / 'test-plan.md'
    shutil.rmtree(str(folder / 'files'), ignore_errors=True)  # --plan-only rewrites: only this plan's files
    if prs is None:
        lines += ['GitHub could not be reached, so here are the merges by title only:', '']
        lines += [f'- {subject}' for subject in list(merged.values())[:20]]
        path.write_text('\n'.join(lines) + '\n')
        return path
    ordered = [prs[n] for n in merged if n in prs]
    facing = [pr for pr in ordered if listener_facing(pr)]
    behind = len(ordered) - len(facing)
    accepted = [pr for pr in facing if pr['number'] in ACCEPTED_PR_CHECKS]
    facing = [pr for pr in facing if pr['number'] not in ACCEPTED_PR_CHECKS]
    # The current milestone's priority and phone-found fixes first, then phone-found bugs, then changes with a
    # written check, then the rest; newest first within each.
    facing.sort(key=lambda pr: (0 if leads(pr['issues']) else 1,
                                0 if any(FIRST_ON_PHONE & labels(i) for i in pr['issues']) else 1,
                                0 if owner_check(pr) else 1))
    entries = plan_entries(facing)
    passed = [entry for entry in entries if passed_on_phone(entry)]
    entries = [entry for entry in entries if not any(entry is gone for gone in passed)]
    # Several merges to one screen are one item at the top of the ten minutes (#1476).
    screens, entries = screen_changes(entries)
    # Only what the owner can check goes in the ten minutes: a written check (#504). A bug his phone found
    # with none goes with the unchecked changes, and the run names its issues so one gets written (#847);
    # "repeat what you did" sent him back to the issue for his own steps and content.
    check_of = {id(entry): next((found for found in map(owner_check, entry) if found), None) for entry in entries}
    unchecked = [entry for entry in entries if not check_of[id(entry)]]
    needs_check = [issue['number'] for entry in unchecked
                   if found_on_phone(entry) and not all(map(says_no_check, entry))
                   for pr in entry for issue in pr['issues'] if FIRST_ON_PHONE & labels(issue)]
    if needs_check:
        say('found on the phone but no "Owner check:" line, so not in the ten minutes; add one to: '
            + ', '.join(f'#{n}' for n in dict.fromkeys(needs_check)))
    # A lead fix with no steps yet isn't "nothing to test" (fdda29c: #1709 for #1708, before dispatch wrote its
    # check). It gets its own section, so the owner sees it is on his phone and waits on steps.
    no_steps = [entry for entry in unchecked if not all(map(says_no_check, entry))
                and leads([issue for pr in entry for issue in pr['issues']])]
    unchecked = [entry for entry in unchecked if not any(entry is lead for lead in no_steps)]
    refused = [who for entry in [*entries, *([pr] for screen in screens for pr in screen['prs'])]
               for pr in entry for who in refused_in(pr)]
    if refused:
        say("a check can't be run on the phone, so it was skipped; rewrite its \"Owner check:\" line: "
            + '; '.join(dict.fromkeys(refused)))
    # A check that needs another change still open waits for it (#847: step 2 needed #547).
    checkable = [entry for entry in entries if check_of[id(entry)]]
    # A change for a milestone that hasn't started waits for it, not in the ten minutes.
    held = {id(entry): held_for([issue for pr in entry for issue in pr['issues']]) for entry in checkable}
    later = [entry for entry in checkable if held[id(entry)]]
    checkable = [entry for entry in checkable if not held[id(entry)]]
    # Fixes from earlier builds still waiting on his check go after these (#927: the 887c560 plan had
    # none while ten Build 30 fixes on the phone waited on him).
    pending = fetch_waiting()
    shown = {number for entry in [*entries, *([pr] for screen in screens for pr in screen['prs'])] for pr in entry
             for number in [pr['number'], *pr.get('linked', ()), *(issue['number'] for issue in pr['issues'])]}
    fixes = waiting_fixes(pending, build_prs(sha), shown, built_numbers(sha), reverted_prs(sha)) if pending else []
    unwritten = [fix['issue']['number'] for fix in fixes if not fix['check'] and not fix['none']
                 and not fix['refused']]
    if unwritten:
        say('waiting on the owner\'s check but no "Owner check:" written, so not in the plan; add one to: '
            + ', '.join(f'#{n}' for n in unwritten))
    cannot_run = [who for fix in fixes for who in fix['refused']]
    if cannot_run:
        say("waiting on the owner's check but it can't be run on the phone, so not in the plan; rewrite its "
            '"Owner check:" line: ' + '; '.join(dict.fromkeys(cannot_run)))
    no_steps_waiting = [fix for fix in fixes if fix['lead'] and not fix['check'] and not fix['none']]
    fixes = [fix for fix in fixes if fix['check']]
    named = [n for entry in checkable for n in references(check_of[id(entry)])]
    named += [n for fix in fixes for n in references(fix['check'])]
    built = built_numbers(sha) if named or pending else set()
    items = fetch_items(list(dict.fromkeys(n for n in named if n not in built))) if named else {}
    waits = {}
    for entry in checkable:
        own = {number for pr in entry for number in [pr['number'], *pr.get('linked', ())]}
        own |= {issue['number'] for pr in entry for issue in pr['issues']}
        waits[id(entry)] = waiting_on(check_of[id(entry)], own, built, items)
    for fix in fixes:
        fix['needs'] = waiting_on(fix['check'], {fix['issue']['number'], *(pr['number'] for pr in fix['prs'])},
                                  built, items)
    # A check that asks for a PDF or packet it doesn't supply waits for one (#1038), and the run names it.
    lacks = {id(entry): missing_material(check_of[id(entry)], sha) for entry in checkable}
    for fix in fixes:
        fix['lacks'] = missing_material(fix['check'], sha)
    unsupplied = [issue['number'] for entry in checkable if lacks[id(entry)] for pr in entry for issue in pr['issues']]
    unsupplied += [fix['issue']['number'] for fix in fixes if fix['lacks']]
    if unsupplied:
        say('a check asks for a test file it doesn\'t supply, so not in the ten minutes; add the file to the repo '
            'and name its path in backticks in the check, or link it: '
            + ', '.join(f'#{n}' for n in dict.fromkeys(unsupplied)))
    waiting = [entry for entry in checkable if waits[id(entry)] or lacks[id(entry)]]
    checkable = [entry for entry in checkable if not (waits[id(entry)] or lacks[id(entry)])]
    room = max(0, PLAN_CHECKS - len(screens))
    ready = [fix for fix in fixes if not (fix['needs'] or fix['lacks'] or fix.get('held'))]
    # The lead fixes keep their place until they're closed, even when new changes would fill the ten minutes
    # (ca6bbd9: #1708 and #1337 were missing while #1073 was listed).
    lead = [fix for fix in ready if fix['lead']]
    budget = checkable[:max(0, room - len(lead))]
    rest = checkable[len(budget):]
    # They share the ten minutes, new changes first; the rest are listed with their links.
    still = ready[:max(len(lead), room - len(budget))]
    also_waiting = [fix for fix in fixes if fix not in still]
    also_waiting.sort(key=lambda fix: bool(fix.get('held')))  # what could be checked now first
    if not ordered:
        lines += ['Nothing new since that build: this is the same code, rebuilt.', '']
    left_out = f' {len(passed)} changes whose issues are already closed are left out.' if passed else ''
    if accepted:
        left_out += f' {len(accepted)} changes whose phone checks were already accepted are left out.'
    lines += [f'{len(ordered)} pull requests merged; {len(facing) + len(accepted)} change something you see or hear.{left_out}', '',
              '## Try these (about ten minutes)', '']
    if not (screens or budget) and still:
        lines += ['No change new in this build has a phone check. The fixes below, from earlier builds, '
                  'still wait on yours.', '']
    elif not (screens or budget):
        lines += ['Nothing is ready to check on the phone yet; the changes you might notice are listed below.'
                  if (waiting or later) and not (unchecked or no_steps) else
                  'No phone checks were written for this build; the changes you might notice are listed below.'
                  if unchecked or no_steps else 'Nothing a listener would notice changed. Use the app as usual for ten minutes.', '']
    for index, screen in enumerate(screens, 1):
        lines += [f'{index}. **The {screen["screen"]} changed** ({len(screen["prs"])} changes)',
                  f'   - Check: {SCREEN_CHECKS.get(screen["screen"], "Use it and say if it is usable.")}',
                  '   - What changed:']
        for pr in screen['prs']:  # each keeps its title, issue links and own check (#1476)
            found = owner_check(pr)
            links = [f'[PR #{pr["number"]}]({pr["url"]})'] + [f'[issue #{issue["number"]}]({issue["url"]})'
                                                              for issue in pr['issues']]
            tag = ' (found on your phone)' if found_on_phone([pr]) else ''
            lines.append(f'     - {pr["title"]}{tag} ({", ".join(links)})'
                         + (f': {found.splitlines()[0]}' if found else ''))
        lines.append('')
    for index, entry in enumerate(budget, len(screens) + 1):
        pr = entry[0]
        issues = list({issue['number']: issue for member in entry for issue in member['issues']}.values())
        tag = ' (found on your phone)' if found_on_phone(entry) else ''
        links = [f'[PR #{member["number"]}]({member["url"]})' for member in entry]
        links += [f'[issue #{issue["number"]}]({issue["url"]})' for issue in issues]
        # A PR keeps its own title even when it shares an issue with another (#1476).
        others = [f'   - Also in this change: {member["title"]} ([PR #{member["number"]}]({member["url"]}))'
                  for member in entry[1:] if member['title'] != pr['title']]
        lines += [f'{index}. **{pr["title"]}**{tag}', *step_lines(check_of[id(entry)], sha, folder), *others,
                  f'   - Links: {", ".join(links)}', '']

    def fix_links(fix, label=True):
        issue = fix['issue']
        return [f'[{"issue " if label else ""}#{issue["number"]}]({issue["url"]})'] + \
            [f'[{"PR " if label else ""}#{pr["number"]}]({pr["url"]})' for pr in fix['prs']]

    def fix_tag(fix):
        return ' (found on your phone)' if FIRST_ON_PHONE & labels(fix['issue']) else ''
    if still:
        lines += ['## Still waiting on your check', '',
                  'Fixed in an earlier build and on your phone now, but nobody has checked them yet.', '']
        for index, fix in enumerate(still, len(screens) + len(budget) + 1):
            lines += [f'{index}. **{fix["issue"]["title"]}**{fix_tag(fix)}', *step_lines(fix['check'], sha, folder),
                      f'   - Links: {", ".join(fix_links(fix))}', '']

    def bullets(entry):
        """One bullet per title in the entry: a PR that shares an issue keeps its own title (#1476)."""
        by_title: dict[str, list[dict]] = {}
        for pr in entry:
            by_title.setdefault(pr['title'], []).append(pr)
        return [f'- {title}' + (' (found on your phone)' if found_on_phone(entry) else '') + ' ('
                + ', '.join(f'[#{pr["number"]}]({pr["url"]})' for pr in members) + ')'
                for title, members in by_title.items()]

    def titles(group):
        return [bullet for entry in group for bullet in bullets(entry)]
    if no_steps or no_steps_waiting:
        lines += ['## Important, but no phone steps written yet', '',
                  f'These {CURRENT_MILESTONE} fixes are on your phone and marked priority or found on your phone, '
                  "but nobody has written steps you can run to check them, so they aren't numbered above.", '']
        lines += [bullet for entry in no_steps for bullet in bullets(entry)]
        lines += [f'- {fix["issue"]["title"]}{fix_tag(fix)} ({", ".join(fix_links(fix, label=False))})'
                  for fix in no_steps_waiting]
        lines.append('')
    if also_waiting:
        lines += ['## Also waiting on your check (not in the ten minutes)', '']
        for fix in also_waiting[:ALSO_WAITING]:
            needs = ', '.join(f'[#{item["number"]}]({item["url"]})' for item in fix['needs'])
            lines.append(f'- {fix["issue"]["title"]}{fix_tag(fix)} ({", ".join(fix_links(fix, label=False))})'
                         + (f': waits for {fix["held"]}' if fix.get('held') else
                            f': needs {needs} on your phone first' if needs else
                            f': needs a test {fix["lacks"]}, not supplied yet' if fix.get('lacks') else ''))
        if len(also_waiting) > ALSO_WAITING:
            query = 'is%3Aissue+label%3A%22' + MERGED_ON_NEXT.replace(':', '%3A').replace(' ', '+') + '%22'
            lines.append(f'- and {len(also_waiting) - ALSO_WAITING} more: '
                         f'[every fix waiting on a check](https://github.com/{REPO}/issues?q={query})')
        lines.append('')
    if pending is None:
        lines += ["GitHub could not be reached, so earlier fixes still waiting on your check aren't listed.", '']

    if rest:
        lines += ['## Also changed (not in the ten minutes)', ''] + titles(rest) + ['']
    if later:
        lines += ['## Waiting for a later milestone (not in the ten minutes)', '',
                  f'These belong to work that starts after {CURRENT_MILESTONE} ships.', '']
        lines += [f'{bullet}: waits for {held[id(entry)]}' for entry in later for bullet in bullets(entry)]
        lines.append('')
    if waiting:
        lines += ['## Waiting on another change or a test file (not in the ten minutes)', '',
                  'Their checks need something that is not on your phone yet.', '']
        for entry in waiting:
            needed = [f'[#{item["number"]}]({item["url"]}) ({item["title"]})' for item in waits[id(entry)]]
            if lacks[id(entry)]:
                needed.append(f'a test {lacks[id(entry)]}, not supplied yet')
            lines += [f'{bullet}: needs {", ".join(needed)}' for bullet in bullets(entry)]
        lines.append('')
    if unchecked:
        lines += ['## Also changed (no phone check written)', '',
                  "You don't need to test these. If one seems off while you use the app, open a "
                  '`found-on-phone` issue.', ''] + titles(unchecked) + ['']
    lines += [f'Behind the scenes: {behind} more pull requests changed only tests, scripts, docs or the test lane.', '',
              '## If something is wrong', '',
              f'Open an issue labelled `found-on-phone` and name this build: commit `{sha[:7]}`.', '']
    path.write_text('\n'.join(lines))
    return path


# ---- build ---------------------------------------------------------------------------------------

def signing_advice(log: str) -> str | None:
    for needle, advice in SIGNING_HINTS:
        if needle in log:
            return advice
    return None


def remove_worktree(src: Path) -> None:
    """Remove a temporary build worktree of ours: its tool links first, then the worktree itself."""
    for link in ('.venv', 'node_modules'):
        if (src / link).is_symlink():
            (src / link).unlink()
    if src.exists():
        # --force: this is a detached scratch checkout this script made; nobody works in it.
        git('worktree', 'remove', '--force', str(src), check=False)
    shutil.rmtree(src, ignore_errors=True)
    git('worktree', 'prune', check=False)


def clear_work() -> None:
    work = phone_dir() / '.work'
    for leftover in sorted(work.glob('*')) if work.exists() else []:
        say(f'removing a leftover scratch folder: {leftover}')
        remove_worktree(leftover / 'src')
        shutil.rmtree(leftover, ignore_errors=True)


def run_logged(command: list[str], cwd: Path, log: Path, env=None) -> int:
    with open(log, 'a') as handle:
        handle.write(f'\n$ {" ".join(command)}\n')
        handle.flush()
        return subprocess.call(command, cwd=str(cwd), stdout=handle, stderr=subprocess.STDOUT, env=env)


def tail(path: Path, count: int = 30) -> str:
    try:
        return '\n'.join(path.read_text(errors='replace').splitlines()[-count:])
    except OSError:
        return ''


def prune() -> None:
    builds = sorted(p for p in phone_dir().iterdir() if p.is_dir() and re.match(r'\d{8}-\d{6}-[0-9a-f]{7}$', p.name))
    for old in builds[:-keep_count()] if keep_count() > 0 else []:
        if old.resolve() == (phone_dir() / 'daily-ready').resolve():
            continue  # one pinned daily pass survives the rolling build's retention window (#1600)
        say(f'deleting an older build: {old.name}')
        shutil.rmtree(old, ignore_errors=True)


def point_latest(folder: Path) -> None:
    link = phone_dir() / 'latest'
    temporary = phone_dir() / '.latest-new'
    if temporary.is_symlink() or temporary.exists():
        temporary.unlink()
    os.symlink(folder.name, temporary)
    os.replace(temporary, link)


def notify(title: str, message: str) -> None:
    """Post a macOS notification (Notification Center keeps it). Never fails the build."""
    command = os.environ.get('SM_PHONE_NOTIFY', 'osascript')
    if command == 'off':
        return
    script = ['-e', 'on run argv', '-e',
              'display notification (item 1 of argv) with title (item 2 of argv) sound name "Glass"', '-e', 'end run']
    try:
        subprocess.run([*command.split(), *script, message, title], capture_output=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        pass


def notify_ready(sha: str, plan: Path) -> None:
    try:
        text = plan.read_text()
    except OSError:
        text = ''
    count = len(re.findall(r'(?m)^\d+\. \*\*', text))
    things = (f'{count} thing{"" if count == 1 else "s"} to try' if count else
              'nothing a listener would notice changed' if 'Nothing a listener would notice' in text else
              'nothing to check on the phone this time')
    notify('Spoken Margins: new phone build',
           f'Commit {sha[:7]} is ready: {things}. Plug in your iPhone and double-click '
           '"Install Spoken Margins on iPhone" on the Desktop.')


def release_issue() -> tuple[bool, dict | None]:
    """(known, the open item this script owns): `known` is False when gh failed, so nobody files twice."""
    # A plain list, not --search: GitHub's search index lags a created or closed issue by minutes.
    raw = gh('issue', 'list', '--repo', REPO, '--state', 'open', *[a for label in RELEASE_ISSUE_LABELS.split(',')
                                                                    for a in ('--label', label)],
             '--json', 'number,title,body', '--limit', '100')
    try:
        found = json.loads(raw) if raw else None
    except ValueError:
        found = None
    if not isinstance(found, list):
        return False, None
    return True, next((i for i in found if i.get('title') == RELEASE_ISSUE_TITLE), None)


def release_failure_body(sha: str, failure: str, log_tail: str) -> str:
    good = latest_build()
    last_good = (f"`{good['sha7']}` ({good.get('subject', '')}), built {good.get('built_at', 'unknown')}; "
                 'it is the build the Desktop installer still offers' if good.get('sha7') else
                 'none on this Mac yet')
    subject = git('log', '-1', '--format=%s', sha, check=False)
    return '\n'.join([
        f'The signed Release build for the iPhone of `{sha[:7]}` ({subject}) failed on the Mac, so no phone '
        'build was made for it. Debug builds and the integration run can pass while this fails.', '',
        f'- Failed commit: `{sha}`',
        f'- When: {datetime.datetime.now().isoformat(timespec="seconds")} (Mac local time)',
        f'- What failed: {failure[:400]}',
        f'- Last good binary: {last_good}',
        f'- Log: `{phone_dir() / "last-failure.log"}` on the Mac', '',
        '```text', log_tail.strip().replace(str(Path.home()), '~')[-1500:], '```', '',
        'This item is updated by `scripts/phone-build` when another commit fails the same way and is '
        'closed by it when a Release build succeeds. Nothing else needs to open or close it.',
        '', '---', '_Filed by scripts/phone-build (#1465)_', ''])


def report_release_failure(sha: str, failure: str, log_tail: str) -> None:
    """Open the one owned item for a failed Release build, or update it with the newer failed commit.
    Never fails the build; says so when GitHub can't be reached."""
    known, item = release_issue()
    if not known:
        say('could not reach GitHub to report the Release failure; the next failure will try again')
        return
    body = release_failure_body(sha, failure, log_tail)
    if item is None:
        made = gh('issue', 'create', '--repo', REPO, '--title', RELEASE_ISSUE_TITLE, '--label', RELEASE_ISSUE_LABELS,
                  '--body', body)
        if made is None:  # a label missing here would otherwise hide the failure; file it without them
            made = gh('issue', 'create', '--repo', REPO, '--title', RELEASE_ISSUE_TITLE, '--body', body)
        if made is None:
            say('could not file the Release failure on GitHub')
        return
    if sha[:7] in (item.get('body') or ''):
        return
    if gh('issue', 'edit', str(item['number']), '--repo', REPO, '--body', body) is None \
            or gh('issue', 'comment', str(item['number']), '--repo', REPO,
                  '--body', f'Another commit fails the Release build: `{sha[:7]}`. {failure[:300]}') is None:
        say(f'could not update #{item["number"]} with the Release failure of {sha[:7]}')


def close_release_failure(sha: str) -> None:
    """A Release build succeeded: close the owned item, if one is open."""
    known, item = release_issue()
    if known and item:
        if gh('issue', 'close', str(item['number']), '--repo', REPO, '--reason', 'completed', '--comment',
              f'Fixed: the Release build of `{sha[:7]}` succeeded on the Mac. The phone build is current again.') is None:
            say(f'could not close #{item["number"]}; close it by hand')


def record_attempt(sha: str, result: str) -> None:
    (phone_dir() / 'last-attempt.json').write_text(json.dumps(
        {'sha': sha, 'result': result, 'at': datetime.datetime.now().isoformat(timespec='seconds')}) + '\n')


def check_app(app: Path, sha: str, cwd: Path, log: Path) -> dict:
    """The checks every phone build passes before the installer may see it; returns its Info.plist."""
    if not (app / 'embedded.mobileprovision').exists():
        raise BuildFailed(f'{app} is missing or has no provisioning profile, so a phone would refuse it')
    if run_logged(['codesign', '--verify', '--strict', str(app)], cwd, log) != 0:
        raise BuildFailed('the app\'s signature does not verify (codesign --verify)')
    info = plistlib.loads((app / 'Info.plist').read_bytes())
    if 'SMBuildCommit' in info and info['SMBuildCommit'] != sha:
        raise BuildFailed(f'the app says it was built from {info["SMBuildCommit"]!r}, not {sha}')
    return info


def deliver(app: Path, info: dict, sha: str, stamp: str, log: Path, seconds: int, checks: str,
            built_at: str | None = None, extra: dict | None = None) -> Path:
    """Put a checked app where the Desktop installer looks, with its build.json and test plan."""
    folder = phone_dir() / f'{stamp}-{sha[:7]}'
    folder.mkdir()
    subprocess.check_call(['ditto', str(app), str(folder / APP_NAME)])
    shutil.copy(log, folder / 'build.log')
    size = int(subprocess.check_output(['du', '-sk', str(folder / APP_NAME)]).split()[0]) * 1024
    details = {'sha': sha, 'sha7': sha[:7], 'subject': git('log', '-1', '--format=%s', sha),
               'built_at': built_at or datetime.datetime.now().isoformat(timespec='seconds'), 'build_seconds': seconds,
               'app': APP_NAME, 'app_bytes': size, 'bundle_version': info.get('CFBundleVersion'),
               'commit_in_app': info.get('SMBuildCommit') or None, 'checks': checks, **(extra or {})}
    (folder / 'build.json').write_text(json.dumps(details, indent=2) + '\n')
    plan = write_plan(folder, sha, checks, commit_in_app=bool(info.get('SMBuildCommit')))
    point_latest(folder)
    record_attempt(sha, 'built')
    prune()
    share_files(folder, sha)
    say(f'done: {folder}')
    say(f'app {size / 1e6:.0f} MB, built in {seconds} s; test plan: {plan}')
    notify_ready(sha, plan)
    return folder


# ---- the hosted build (#2357) ----------------------------------------------------------------------

def source() -> str:
    """Where the phone build comes from: `mac` (build here) or `hosted` (download .github/workflows/phone-build.yml's).

    SM_PHONE_SOURCE wins, then the first word of ~/SpokenMargins-phone/source, then `mac`. The file lets the
    launchd job switch without being reinstalled; deleting it goes back to building here."""
    chosen = os.environ.get('SM_PHONE_SOURCE', '').strip()
    if not chosen:
        try:
            chosen = ((phone_dir() / 'source').read_text().split() or [''])[0]
        except OSError:
            chosen = ''
    return chosen if chosen in SOURCES else 'mac'


def gh_json(*args):
    raw = gh(*args)
    try:
        return json.loads(raw) if raw else None
    except ValueError:
        return None


def hosted_build(commit: str | None = None) -> dict | None:
    """The newest unexpired hosted phone build of the trunk (or of `commit`): {sha, run_id, artifact, built_at}.

    Only a successful run of the phone-build workflow file itself, started by its schedule or by hand on the
    trunk, counts: those are the runs its main-only environment lets sign. None when there is none or GitHub
    is unreachable."""
    runs = gh_json('api', f'repos/{REPO}/actions/workflows/{HOSTED_WORKFLOW}/runs?branch={BRANCH}&status=success&per_page=20')
    for run in (runs or {}).get('workflow_runs', []):
        if (run.get('path') != f'.github/workflows/{HOSTED_WORKFLOW}' or run.get('event') not in HOSTED_EVENTS
                or run.get('head_branch') != BRANCH or run.get('conclusion') != 'success'):
            continue
        sha = run.get('head_sha') or ''
        if not re.fullmatch(r'[0-9a-f]{40}', sha) or (commit and sha != commit):
            continue
        artifacts = gh_json('api', f'repos/{REPO}/actions/runs/{run["id"]}/artifacts')
        for artifact in (artifacts or {}).get('artifacts', []):
            if artifact.get('name') == f'phone-build-{sha}' and not artifact.get('expired'):
                return {'sha': sha, 'run_id': run['id'], 'artifact': artifact['name'],
                        'run_url': run.get('html_url'), 'built_at': artifact.get('created_at')}
    return None


def local_time(stamp: str | None) -> str | None:
    """GitHub's UTC time as the naive local time the installer compares build.json's built_at with."""
    try:
        moment = datetime.datetime.fromisoformat((stamp or '').replace('Z', '+00:00'))
    except ValueError:
        return None
    return moment.astimezone().replace(tzinfo=None).isoformat(timespec='seconds') if moment.tzinfo else None


def fetch_hosted(hosted: dict) -> int:
    """Download a hosted phone build, check it as a Mac build is checked, and hand it to the installer."""
    sha = hosted['sha']
    stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
    work = phone_dir() / '.work' / f'{stamp}-{sha[:7]}'
    log = work / 'build.log'
    work.mkdir(parents=True)
    try:
        say(f'downloading the hosted phone build of {sha[:7]} ({hosted.get("run_url")})')
        command = [*os.environ.get('SM_PHONE_GH', 'gh').split(), 'run', 'download', str(hosted['run_id']),
                   '-R', REPO, '-n', hosted['artifact'], '-D', str(work / 'download')]
        if run_logged(command, work, log) != 0:
            raise BuildFailed('gh run download failed')
        archive = work / 'download' / f'{APP_NAME}.zip'
        if not archive.is_file():
            raise BuildFailed(f'the hosted build has no {archive.name}')
        if run_logged(['ditto', '-x', '-k', str(archive), str(work / 'app')], work, log) != 0:
            raise BuildFailed(f'could not unpack {archive.name}')
        app = work / 'app' / APP_NAME
        info = check_app(app, sha, work, log)
        hosted_info = read_json(work / 'download' / 'build.json')
        if hosted_info.get('sha') not in (None, sha):
            raise BuildFailed(f'the hosted build.json names {hosted_info.get("sha")!r}, not {sha}')
        if (work / 'download' / 'build.log').is_file():
            with open(log, 'a') as handle:
                handle.write('\n--- the hosted build log ---\n')
                handle.write((work / 'download' / 'build.log').read_text(errors='replace'))
        evidence = runner_tested(sha)
        checks = (f'{evidence}; built and signed on a GitHub-hosted Mac ({hosted.get("run_url")})' if evidence else
                  f'built and signed on a GitHub-hosted Mac ({hosted.get("run_url")}); no lane host-test evidence '
                  'was found for this commit')
        deliver(app, info, sha, stamp, log, int(hosted_info.get('build_seconds') or 0), checks,
                built_at=local_time(hosted.get('built_at')) or local_time(hosted_info.get('built_at')),
                extra={'built_on': 'github-hosted', 'run_url': hosted.get('run_url')})
        return 0
    except (BuildFailed, subprocess.CalledProcessError, OSError) as failure:
        record_attempt(sha, f'failed: {failure}')
        if log.exists():
            shutil.copy(log, phone_dir() / 'last-failure.log')
        say(f'FAILED to take the hosted build of {sha[:7]}: {failure}')
        say(f'log: {phone_dir() / "last-failure.log"}; its end:\n{tail(log)}')
        return 1
    finally:
        shutil.rmtree(work, ignore_errors=True)


def build(sha: str) -> int:
    stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
    work = phone_dir() / '.work' / f'{stamp}-{sha[:7]}'
    cache = phone_dir() / '.cache'
    src, derived, log = cache / 'src', cache / 'dd-release', work / 'build.log'
    release = 'not started'  # 'started' until the Release app is built and verified, then 'built' (#1465)
    work.mkdir(parents=True)
    try:
        cache.mkdir(exist_ok=True)
        say(f'checking out {sha[:7]} in the persistent phone-build worktree')
        if src.exists():
            git('checkout', '--detach', sha, cwd=src)
        else:
            git('worktree', 'add', '--detach', str(src), sha)
        # Kitten is the voice model the app still bundles; Supertonic's is a download since #1820.
        pointers = [p for p in (src / 'App/SpokenMarginsApp/Resources/Kitten').glob('*.onnx')
                    if p.stat().st_size < 1024 and p.read_bytes().startswith(b'version https://git-lfs')]
        if pointers:
            run_logged(['git', 'lfs', 'pull'], src, log)
            if any(p.stat().st_size < 1024 for p in pointers):
                raise RuntimeError('the voice models are still Git LFS pointers after `git lfs pull`')
        run_logged(['bash', str(src / 'scripts/setup-worktree.sh')], src, log)
        lane = [sys.executable, str(PUBLIC / 'scripts' / 'xcodebuild-lane')]
        project = ['-project', 'SpokenMarginsNative.xcodeproj', '-scheme', 'SpokenMarginsApp']
        checks = runner_tested(sha)
        if not checks:
            say('no lane host-test evidence for this commit; running host tests and the simulator build here first')
            # The hot-file ratchet is a merge rule, not a build check: an unmerged PR that grows a hot file still
            # goes on the phone (#2175, #2180 audit). The lane judges it, with the PR's labels, before merging.
            if run_logged([str(src / '.venv/bin/python'), 'scripts/verify-tests.py', '--plan', 'fast',
                           '--output', str(work / 'fast')], src, log,
                          env={**os.environ, 'SM_HOT_FILE_OK': '1'}) != 0:
                raise BuildFailed('host tests (--plan fast) failed')
            if run_logged([*lane, *project, '-destination', 'generic/platform=iOS Simulator',
                           '-derivedDataPath', str(work / 'dd-sim'), 'build-for-testing'], src, log) != 0:
                raise BuildFailed('the simulator build failed')
            shutil.rmtree(work / 'dd-sim', ignore_errors=True)
            checks = 'host tests (--plan fast) and the simulator build passed here, on this exact commit'
        say(f'checks: {checks}')
        say('building the signed Release app for iPhone (waits for a build slot)')
        release = 'started'
        started = datetime.datetime.now()
        if run_logged([*lane, *project, '-configuration', 'Release', '-destination', 'generic/platform=iOS',
                       '-derivedDataPath', str(derived), '-allowProvisioningUpdates',
                       f'SM_BUILD_COMMIT={sha}', 'build'], src, log) != 0:
            advice = signing_advice(log.read_text(errors='replace'))
            raise BuildFailed('the iPhone build failed' + (f'. Signing needs the owner: {advice}' if advice else ''))
        seconds = int((datetime.datetime.now() - started).total_seconds())
        app = derived / 'Build/Products/Release-iphoneos' / APP_NAME
        info = check_app(app, sha, src, log)
        release = 'built'
        deliver(app, info, sha, stamp, log, seconds, checks)
        try:
            close_release_failure(sha)  # only once the new build is the latest one
        except Exception as failure:  # noqa: BLE001 - reporting never fails a build
            say(f'could not close the Release failure item: {failure}')
        return 0
    except (BuildFailed, RuntimeError, subprocess.CalledProcessError, OSError) as failure:
        record_attempt(sha, f'failed: {failure}')
        if log.exists():
            shutil.copy(log, phone_dir() / 'last-failure.log')
        say(f'FAILED on {sha[:7]}: {failure}')
        say(f'log: {phone_dir() / "last-failure.log"}; its end:\n{tail(log)}')
        if 'Signing needs the owner' in str(failure):
            # Only signing waits on the owner; other failures clear with the next change on next.
            notify('Spoken Margins: phone build needs you', str(failure).split('Signing needs the owner: ', 1)[-1])
        elif release == 'started':  # signing already told the owner; any other Release failure is filed (#1465)
            try:
                report_release_failure(sha, str(failure), tail(log))
            except Exception as reporting:  # noqa: BLE001 - reporting never fails a build
                say(f'could not report the Release failure: {reporting}')
        return 1
    finally:
        shutil.rmtree(work, ignore_errors=True)


class BuildFailed(Exception):
    pass


def take_hosted(commit: str | None, if_changed: bool) -> int:
    """--source hosted: no xcodebuild here. Take the newest hosted build (of `commit`, when one is named)."""
    hosted = hosted_build(commit)
    if not hosted:
        say(f'no hosted phone build {"of " + commit[:7] if commit else "of " + BRANCH} yet (or GitHub is '
            'unreachable); the phone-build workflow makes one')
        return 0 if if_changed else 1
    sha = hosted['sha']
    if latest_build().get('sha') == sha and (if_changed or not commit):
        say(f'latest is already the hosted build of {sha[:7]}; nothing to do')
        return 0
    attempt = read_json(phone_dir() / 'last-attempt.json')
    if if_changed and attempt.get('sha') == sha and str(attempt.get('result', '')).startswith('failed'):
        say(f'{sha[:7]} already failed ({attempt["result"]}); waiting for a newer hosted build')
        return 0
    free, needed = free_disk_gb(phone_dir()), DISK_FLOOR_GB
    if free < needed:
        say(f'skipped: free disk is {free:.1f} GB; taking a phone build needs {needed} GB')
        return EXIT_SKIPPED
    clear_work()
    return fetch_hosted(hosted)


def main(argv) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--commit', help='build this commit instead of the trunk\'s tip')
    parser.add_argument('--if-changed', action='store_true', help='coalesce changed tips to hourly, or after integration PASS')
    parser.add_argument('--plan-only', action='store_true', help="rewrite latest's test-plan.md and stop")
    parser.add_argument('--source', choices=SOURCES,
                        help='mac builds here; hosted downloads the GitHub-hosted build (default: SM_PHONE_SOURCE, '
                             'then ~/SpokenMargins-phone/source, then mac)')
    args = parser.parse_args(argv)
    phone_dir().mkdir(parents=True, exist_ok=True)
    if args.plan_only:
        folder = (phone_dir() / 'latest').resolve()
        info = read_json(folder / 'build.json')
        if not info:
            say('no latest build yet')
            return 1
        say(f'rewrote {write_plan(folder, info["sha"], info.get("checks", "unknown"), bool(info.get("commit_in_app")))}')
        share_files(folder, info['sha'])
        return 0
    with open(phone_dir() / '.phone-build.lock', 'a+') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            say('another phone build is running; nothing to do')
            return 0
        if not os.environ.get('SM_PHONE_NO_FETCH'):
            git('fetch', 'origin', BRANCH, '-q', check=False)
        sha = git('rev-parse', f'{args.commit or "origin/" + BRANCH}^{{commit}}')
        if (args.source or source()) == 'hosted':
            return take_hosted(sha if args.commit else None, args.if_changed)
        if args.if_changed:
            if latest_build().get('sha') == sha:
                say(f'latest is already {sha[:7]}; nothing to do')
                return 0
            attempt = read_json(phone_dir() / 'last-attempt.json')
            if attempt.get('sha') == sha and str(attempt.get('result', '')).startswith('failed'):
                say(f'{sha[:7]} already failed ({attempt["result"]}); waiting for a newer next')
                return 0
            reason = coalesce_reason(sha)
            if reason:
                say(reason)
                return 0
        reason = guard_reason()
        if reason:
            say(f'skipped: {reason}')
            return EXIT_SKIPPED
        clear_work()
        (phone_dir() / 'last-start.json').write_text(json.dumps({
            'sha': sha, 'at': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds')}) + '\n')
        return build(sha)


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
