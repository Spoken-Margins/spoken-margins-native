#!/usr/bin/env python3
"""Build next's tip for the owner's iPhone, ready for the Desktop installer (#384).

Usage:
  scripts/phone-build                 build origin/next's tip now
  scripts/phone-build --commit <sha>  build that commit instead
  scripts/phone-build --if-changed    build only if next's tip differs from `latest` (for launchd or a tick)
  scripts/phone-build --plan-only     rewrite latest's test-plan.md against the build installed now

What it does:
- Builds a signed Release app for a physical iPhone in a temporary detached worktree, through
  scripts/xcodebuild-lane (so it waits for a Mac-wide build slot), with its own DerivedData,
  automatic signing and -allowProvisioningUpdates. SM_BUILD_COMMIT puts the commit in the app's
  Info.plist, so Settings > Version names it once that key is on next.
- Output: ~/SpokenMargins-phone/<date-time>-<sha7>/ with the .app, build.json, build.log and
  test-plan.md, and a `latest` symlink to the newest good build. Keeps the three newest builds;
  older ones, the temporary worktree and its DerivedData are deleted.
- test-plan.md lists the listener-facing PRs merged since the build the owner last installed
  (~/SpokenMargins-phone/installed.txt, written by scripts/install-phone-build.command; a commit built
  on the Mac before it reached next still counts), each with
  its issue's "Owner check" line, sized to about ten minutes. A change whose issues are all closed
  is left out: the owner has passed it (#1100). Only written checks go in the ten minutes:
  a phone-found bug without one is listed with the other unchecked changes and the run names its issue
  (#847), and a check that names an issue or PR not on the phone yet waits in its own section. A step
  carries the check's own numbered steps, its URLs as links, and the repo files it names (copied to
  files/ and to iCloud Drive as "Test plan <sha7> files", beside the plan the installer puts there).
  A check that asks for a PDF, EPUB, audiobook or packet with no link and no repo file to attach waits
  with the run naming its issue (#1038); test PDFs live in TestPlans/phone-files/.
  After those, "Still waiting on your check" lists open issues labelled `status: needs-human-validation` whose
  fix is in this build but wasn't in the changes above, for as long as nobody has checked them (#927). A check
  is read from the issue body or the PR as "Owner check", "Phone check" or a "## Steps" heading, and the newest
  one in the issue's comments wins; a comment saying "Owner check: none" or "leave this off the owner's plans"
  keeps the issue out. They share the ten minutes with the new changes; the rest are listed with links.

Gates (the owner's rule, 2026-09-30: rebuild whenever next's tip changes and the automated checks
pass; bugs are fine, crashes the runners would catch are not):
- One phone build at a time (a lock in ~/SpokenMargins-phone). A second run exits at once.
- Memory pressure must be normal, and free disk at least 10 GB plus 4 GB per running build
  (counting this one). Otherwise it skips and exits 75; the next trigger tries again.
- Checks on the exact commit: a tip the lane runner pushed after testing it (its "Merge check"
  comment says so) has passed host tests; its author built both targets, and the iPhone build
  below compiles it again (the lane builds no app per PR since 2026-10-09). Any other commit (a
  merge by hand) gets `verify-tests.py --plan fast` and a simulator build-for-testing here first.
- A commit that failed once isn't retried by --if-changed; a newer tip is.

The owner gets a macOS notification when a new build is ready, and when signing needs him (#500).

Environment (tests): SM_PHONE_DIR (default ~/SpokenMargins-phone), SM_PHONE_KEEP (3),
SM_PHONE_NOTIFY (the notification command, default osascript; `off` skips it),
SM_PHONE_DISK_FREE_GB (instead of measuring), SM_LANE_* (scripts/lane_slots.py, xcodebuild-lane),
SM_PHONE_GH (the gh command), SM_PHONE_NO_FETCH=1 (skip the fetch), SM_PHONE_REPO (the repo to
build from; default this checkout), SM_PHONE_ICLOUD (the iCloud Drive plans folder, as the installer).
Stdlib only, Python 3.9-compatible: launchd runs it under /usr/bin/python3.
"""
from __future__ import annotations

import argparse
import datetime
import fcntl
import json
import os
from pathlib import Path
import plistlib
import re
import shutil
import subprocess
import sys

SCRIPTS = Path(__file__).resolve().parent
ROOT = Path(os.environ.get('SM_PHONE_REPO') or SCRIPTS.parent)  # tests use a scratch repo
sys.path.insert(0, str(SCRIPTS))
import lane_slots  # noqa: E402

REPO = 'uncomposed/spoken-margins-native'
BRANCH = 'next'
REPORTS_ISSUE = 184      # where the integration run and the Test Desk post their lane reports
DISK_FLOOR_GB = 10
DISK_PER_BUILD_GB = 4
PLAN_CHECKS = 8          # about a minute each, plus the install: roughly ten minutes
EXIT_SKIPPED = 75        # EX_TEMPFAIL: a guard said not now
APP_NAME = 'SpokenMarginsApp.app'
SIGNING_HINTS = [
    ('errSecInternalComponent', 'The keychain is locked or asked for permission. Unlock the Mac, run '
     'scripts/phone-build once from Terminal, and click "Always Allow" when macOS asks for the keychain.'),
    ('No Accounts', 'Xcode has no Apple ID signed in. Open Xcode > Settings > Accounts and sign in with the '
     'developer account.'),
    ('No signing certificate', 'The Mac has no Apple Development certificate for the team. Open Xcode > '
     'Settings > Accounts, pick the team and click "Manage Certificates", then "+" > Apple Development.'),
    ('No profiles for', 'Xcode could not make a provisioning profile. Open the project in Xcode once, pick '
     'the SpokenMarginsApp target > Signing & Capabilities, and let it fix signing.'),
    ('has not been registered', 'The iPhone is not registered with the team. Plug it in, open Xcode > '
     'Window > Devices and Simulators once so Xcode registers it, then run the build again.'),
    ('Unable to log in with account', 'Xcode\'s Apple ID session expired. Open Xcode > Settings > Accounts '
     'and sign in again.'),
]
LISTENER_PATHS = ('App/', 'Packages/SessionKit/Sources/')
NOT_LISTENER_PATHS = ('App/SpokenMarginsAppTests/', 'App/SpokenMarginsAppUITests/', 'App/TestFixtures/')
NOT_LISTENER_TITLE = re.compile(r'to its own file|^(tests?|docs|lane|runner|verify-tests)\b|^test ', re.I)
FIRST_ON_PHONE = {'found-on-phone', 'regression'}
NOT_LISTENER_LABELS = {'stream:A1'}  # the test lane: its SessionKit edits are compile guards, not behaviour
# "Owner check: none." (or "n/a", "nothing (lane only)") isn't a check; "Nothing plays twice ..." is (#504).
# "None this time: ..." and "none needed." aren't either (#927: #811's heading section), nor "none now;
# ..." / "none at the moment" / "not needed" / "no owner check" (#1193: #177 reached the plan as a check).
NO_CHECK = re.compile(
    r'^(?:(?:none|n/?a|nothing)(?:\s+(?:this time|at this time|needed|required|for now|right now|now|yet|currently'
    r'|at the moment|at all))*'
    r'|not needed|no (?:(?:owner|phone) )?checks?(?:\s+needed)?)'
    r'\s*(?:[.;:,(\u2014\u2013]|-\s|$)', re.I)
# "#547" or a link to issue/PR 547 in a check: something it may need on the phone first (#847).
REFERENCE = re.compile(r'(?<![\w&/])#(\d+)\b|github\.com/' + re.escape(REPO) + r'/(?:issues|pull)/(\d+)\b')
# "**Owner check:**", "**Owner check (phone):**", "4. Owner check:", "**Phone check:**" (#927). Plain text
# only at the start of a line or list item: "the phone check covers that" in prose isn't one.
CHECK_LABEL = r'(?i:owner check(?: \([^)\n]*\))?|phone check)'
LIST_ITEM = r'\s*(?:(?:\d+[.)]|[-*+])\s+)?'
CHECK_FIELD = re.compile(r'\*\*' + CHECK_LABEL + r'(?::\*\*|\*\*:|\*\*\s*$)\s*(.*)|^' + LIST_ITEM + CHECK_LABEL
                         + r':\s*(.*)')
STEPS_FIELD = re.compile(r'\*\*Steps:?\*\*:?\s*(.*)')     # a bug report's Steps and Expected (#504)
EXPECTED_FIELD = re.compile(r'\*\*Expected:?\*\*:?\s*(.*)')
# The same fields written as a heading, the section under it being the field (#927: #854's "## Steps").
CHECK_HEADING = re.compile(r'\s{0,3}#{1,6}\s+' + CHECK_LABEL + r'\s*(?::\s*(.*))?$')  # "## Owner check: none"
STEPS_HEADING = re.compile(r'\s{0,3}#{1,6}\s+Steps\b[^\n]*$')
EXPECTED_HEADING = re.compile(r'\s{0,3}#{1,6}\s+Expected\b[^\n]*$')
HEADINGS = {CHECK_FIELD: CHECK_HEADING, STEPS_FIELD: STEPS_HEADING, EXPECTED_FIELD: EXPECTED_HEADING}
LIST_MARKER = re.compile(r'(\s*)(?:\d+[.)]|[-*+])\s')
# A later comment taking an issue off the plans without the words "Owner check: none" (#288, #927).
OFF_PLANS = re.compile(r"\bleave (?:this|it) off (?:the owner's|his|your|the) (?:phone )?(?:test )?plans?\b", re.I)
# A comment naming the PR that fixed the issue: dispatch's "Merged in #907", #180's "PR #257 (merged as ...)".
FIXED_IN = re.compile(r'\b(?:merged|fixed|landed) (?:in|by|with) #(\d+)\b|\bPR #(\d+) \(merged\b', re.I)
ALSO_WAITING = 10  # the "Also waiting" list stays short; the rest are one link away
FIELD = r'\*\*[A-Z][\w /()-]{0,30}(?::\*\*|\*\*:)'                    # "**Taken by:**", "**Done when**:"
NEXT_FIELD_ON_LINE = re.compile(r'\s+' + FIELD + '.*$')                # "none. **Taken by:** nobody yet."
FIELD_START = re.compile(r'\s*(?:[-*+]\s+)?' + FIELD + r'|[A-Z][\w ]{0,30}:\s|\s*(?:#|---)')  # "Related: #5"
STEP_LINE = re.compile(r'\s*(?:\d+[.)]|[-*+]|>)\s|\s{2,}\S|\s*```')
CODE_URL = re.compile(r'`(https?://[^`\s]+)`')                       # a URL in code: not tappable
REPO_FILE = re.compile(r'`([\w.-]+(?:/[\w.-]+)+)`')                     # `Contracts/fixtures/x.spokenmargins`
ATTACH_LIMIT = 50_000_000
# A check that asks for a test file must hand it over (#1038): "import a book PDF that has bookmarks" with
# no file left the owner with nothing to test, twice (2026-09-30, 2026-10-07).
MATERIAL = re.compile(r'\b(PDF|EPUB|audiobook|packet)s?\b|\.spokenmargins\b', re.I)
# A link that supplies the file: any URL except an issue or PR, which is a prerequisite, not content.
SUPPLIED_URL = re.compile(r'https?://(?!(?:www\.)?github\.com/' + re.escape(REPO) + r'/(?:issues|pull)/)\S+')
MERGED_ON_NEXT = 'status: needs-human-validation'  # dispatch adds it when a PR for the issue merges into next


# ---- small helpers ------------------------------------------------------------------------------

def phone_dir() -> Path:
    return Path(os.environ.get('SM_PHONE_DIR') or Path.home() / 'SpokenMargins-phone')


def keep_count() -> int:
    return int(os.environ.get('SM_PHONE_KEEP', '3'))


def say(message: str) -> None:
    print(f'[phone-build] {message}', flush=True)


def git(*args, cwd=ROOT, check=True) -> str:
    done = subprocess.run(['git', *args], cwd=str(cwd), capture_output=True, text=True)
    if check and done.returncode != 0:
        raise RuntimeError(f'git {" ".join(args)} failed: {done.stderr.strip()}')
    return done.stdout.strip()


def gh(*args) -> str | None:
    """A gh call's output, or None when gh is missing, offline or refused (the plan says so)."""
    command = os.environ.get('SM_PHONE_GH', 'gh').split()
    try:
        done = subprocess.run([*command, *args], capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout if done.returncode == 0 else None


def free_disk_gb(path: Path) -> float:
    if os.environ.get('SM_PHONE_DISK_FREE_GB'):
        return float(os.environ['SM_PHONE_DISK_FREE_GB'])
    path.mkdir(parents=True, exist_ok=True)
    return shutil.disk_usage(str(path)).free / 1e9


def read_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def latest_build() -> dict:
    return read_json(phone_dir() / 'latest' / 'build.json')


def installed_sha() -> str | None:
    """The first word of installed.txt: the commit the Desktop installer last put on the phone."""
    try:
        words = (phone_dir() / 'installed.txt').read_text().split()
    except OSError:
        return None
    return words[0] if words and re.fullmatch(r'[0-9a-f]{7,40}', words[0]) else None


# ---- gates ---------------------------------------------------------------------------------------

def guard_reason() -> str | None:
    """Why a build shouldn't start now (memory, disk), or None."""
    level = lane_slots.memory_pressure_level()
    if level not in (1, None):
        return f'memory pressure is {lane_slots.PRESSURE_NAMES.get(level, level)}; a phone build needs normal'
    running = len(lane_slots.holders())
    needed = DISK_FLOOR_GB + DISK_PER_BUILD_GB * (running + 1)
    free = free_disk_gb(phone_dir())
    if free < needed:
        return (f'free disk is {free:.1f} GB; with {running} other build(s) running, a phone build needs '
                f'{needed} GB (10 plus 4 per build, this one included)')
    return None


def runner_tested(sha: str) -> str | None:
    """How the lane runner tested this exact commit before pushing it to next, or None.

    The runner merges a PR as "Merge pull request #N: ..." and first posts a "Merge check (triage
    desk)" comment on it that says "Pushing `<sha7>` to next" (scripts/lane-runner.py merge_check).
    """
    subject = git('log', '-1', '--format=%s', sha)
    found = re.match(r'Merge pull request #(\d+): ', subject)
    if not found:
        return None
    raw = gh('api', f'repos/{REPO}/issues/{found.group(1)}/comments', '--paginate',
             '--jq', '.[] | select(.body | startswith("**Merge check (triage desk)")) | .body')
    if not raw:
        return None
    for body in raw.split('**Merge check (triage desk)')[1:]:
        if f'Pushing `{sha[:7]}`' in body and ': PASS' in body.split('\n', 1)[0]:
            ran = re.search(r'- Ran: (.+?)\.?\n', body)
            return f'the lane runner tested this merge commit before pushing it (PR #{found.group(1)}' + \
                (f'; ran {ran.group(1)})' if ran else ')')
    return None


# ---- test plan -----------------------------------------------------------------------------------

def plan_base(target: str) -> tuple[str | None, str]:
    """(base commit, how it was chosen) for "what changed since the owner's last install".

    The installed commit is the base whenever this checkout has it and it isn't ahead of the target, even when
    it isn't in next's history (a candidate built on this Mac before its changes reached next, #1100):
    merged_prs then lists what next has that the installed build lacks. A commit this checkout doesn't have,
    one newer than the target, or no installed.txt falls back to the last TestFlight build.
    """
    sha = installed_sha()

    def ancestor(older: str, newer: str) -> bool:
        return subprocess.run(['git', 'merge-base', '--is-ancestor', older, newer], cwd=str(ROOT),
                              capture_output=True).returncode == 0
    known = sha and subprocess.run(['git', 'cat-file', '-e', f'{sha}^{{commit}}'], cwd=str(ROOT),
                                   capture_output=True).returncode == 0
    behind = bool(known) and ancestor(sha, target)
    ahead = bool(known) and not behind and ancestor(target, sha)
    if known and not ahead:
        return sha, f'the build you last installed (`{sha[:7]}`, from installed.txt' + (
            ')' if behind else '; it isn\'t part of next\'s history, so this lists what next has beyond it)')
    tags = git('tag', '--list', 'testflight/*', '--sort=-creatordate', '--merged', target, check=False).split()
    if tags:
        why = ('nothing recorded in installed.txt yet' if not sha else
               f'installed.txt names `{sha[:7]}`, which is newer than this build' if ahead else
               f'installed.txt names `{sha[:7]}`, which this checkout doesn\'t have')
        return git('rev-list', '-1', tags[0]), f'the last TestFlight build, `{tags[0]}` ({why})'
    return None, 'no earlier build found'


def merged_prs(base: str | None, target: str) -> dict[int, str]:
    """{PR number: merge subject} for PRs merged into next between base and target, newest first."""
    span = f'{base}..{target}' if base else target
    merged: dict[int, str] = {}
    for subject in git('log', '--first-parent', '--format=%s', span, '-n', '400').splitlines():
        found = re.match(r'Merge pull request #(\d+)\b', subject)
        if found:
            merged.setdefault(int(found.group(1)), subject)
    return merged


COMMENTS = 'comments(last:30){nodes{body}}'  # a check written in a comment (#927)
PR_FIELDS = '''number title url mergedAt body labels(first:20){nodes{name}} files(first:100){nodes{path}}
closingIssuesReferences(first:5){nodes{number title url state body labels(first:20){nodes{name}} %s}}''' % COMMENTS
ISSUE_FIELDS = 'number title url state body labels(first:20){nodes{name}} ' + COMMENTS  # state: passed_on_phone (#1100)


def graphql(fields_by_alias: dict[str, str]) -> dict:
    """One GraphQL call for many items (aliases). {} when gh fails."""
    if not fields_by_alias:
        return {}
    owner, name = REPO.split('/')
    body = ' '.join(f'{alias}: {query}' for alias, query in fields_by_alias.items())
    raw = gh('api', 'graphql', '-f', f'query=query {{ repository(owner: "{owner}", name: "{name}") {{ {body} }} }}')
    try:
        return (json.loads(raw) if raw else {}).get('data', {}).get('repository', {}) or {}
    except ValueError:
        return {}


def linked_numbers(pr: dict) -> list[int]:
    """The issues a PR says it fixes: its title's "(#347, #355)" and its body's "Fixes #N" / "for #N"."""
    found = re.findall(r'#(\d+)', pr.get('title') or '') + re.findall(
        r'\b(?:fixes|fixed|closes|closed|resolves|for|part of|issue)\s+#(\d+)', pr.get('body') or '', re.I)
    return list(dict.fromkeys(int(n) for n in found if int(n) != pr.get('number')))


def fetch_prs(numbers: list[int]) -> dict[int, dict] | None:
    """PR details with their linked issues, or None when GitHub couldn't be reached."""
    prs: dict[int, dict] = {}
    for start in range(0, len(numbers), 25):
        chunk = numbers[start:start + 25]
        data = graphql({f'p{n}': f'pullRequest(number: {n}) {{ {PR_FIELDS} }}' for n in chunk})
        if not data:
            return None
        prs.update({int(alias[1:]): value for alias, value in data.items() if value})
    wanted = {}
    for pr in prs.values():
        linked = [issue['number'] for issue in pr['closingIssuesReferences']['nodes']]
        if not linked:
            # Closing keywords don't link issues on next (not the default branch), so read the
            # title's "(#347, #355)" and the body's "Fixes #N" / "for #N" by hand.
            linked = linked_numbers(pr)[:3]
            wanted.update({n: None for n in linked})
        pr['linked'] = linked
    issues = {issue['number']: issue for pr in prs.values() for issue in pr['closingIssuesReferences']['nodes']}
    missing = [n for n in wanted if n not in issues]
    for start in range(0, len(missing), 25):
        data = graphql({f'i{n}': f'issueOrPullRequest(number: {n}) {{ ... on Issue {{ {ISSUE_FIELDS} }} }}'
                        for n in missing[start:start + 25]})
        issues.update({int(alias[1:]): value for alias, value in data.items() if value and value.get('number')})
    for pr in prs.values():
        pr['issues'] = [issues[n] for n in pr['linked'] if n in issues]
    return prs


ITEM_FIELDS = '__typename ... on Issue { number title url state labels(first:20){nodes{name}} } ' \
    '... on PullRequest { number title url state }'


def fetch_items(numbers: list[int]) -> dict[int, dict]:
    """{number: issue or PR with its state} for the numbers a check names; {} when gh fails."""
    items: dict[int, dict] = {}
    for start in range(0, len(numbers), 25):
        batch = numbers[start:start + 25]
        data = graphql({f'n{n}': f'issueOrPullRequest(number: {n}) {{ {ITEM_FIELDS} }}' for n in batch})
        if not data and len(batch) > 1:  # gh fails the whole query when one number isn't an issue or PR
            for n in batch:
                data.update(graphql({f'n{n}': f'issueOrPullRequest(number: {n}) {{ {ITEM_FIELDS} }}'}))
        items.update({int(alias[1:]): value for alias, value in data.items() if value and value.get('number')})
    return items


WAITING_QUERY = '''query($cursor: String) { repository(owner: "%s", name: "%s") {
issues(states: OPEN, labels: ["%s"], first: 25, after: $cursor, orderBy: {field: CREATED_AT, direction: ASC}) {
pageInfo { hasNextPage endCursor }
nodes { %s createdAt milestone { title state }
timelineItems(itemTypes: [CROSS_REFERENCED_EVENT], last: 25) { nodes { ... on CrossReferencedEvent {
source { ... on PullRequest { number title url body merged } } } } } } } } }'''


def fetch_waiting() -> list[dict] | None:
    """Open issues marked `status: needs-human-validation` (dispatch adds it when their fix merges into next),
    oldest first, with their comments and the PRs that mention them; None when GitHub can't be reached (#927)."""
    owner, name = REPO.split('/')
    query = WAITING_QUERY % (owner, name, MERGED_ON_NEXT, ISSUE_FIELDS)
    issues: list[dict] = []
    cursor = None
    for _ in range(20):  # 500 issues at most
        raw = gh('api', 'graphql', '-f', f'query={query}', *(['-f', f'cursor={cursor}'] if cursor else []))
        try:
            page = json.loads(raw)['data']['repository']['issues'] if raw else None
        except (ValueError, KeyError, TypeError):
            page = None
        if not isinstance(page, dict):
            return None
        issues += [issue for issue in page.get('nodes') or [] if issue and issue.get('number')]
        info = page.get('pageInfo') or {}
        if not info.get('hasNextPage') or not info.get('endCursor'):
            break
        cursor = info['endCursor']
    return issues


def build_prs(sha: str) -> set[int]:
    """The PRs merged into the build: its first-parent "Merge pull request #N" subjects."""
    subjects = git('log', '--first-parent', '--format=%s', sha, check=False)
    return {int(n) for n in re.findall(r'(?m)^Merge pull request #(\d+)\b', subjects)}


def waiting_fixes(issues: list[dict], built: set[int], shown: set[int], named_in_build: set[int] = frozenset()) \
        -> list[dict]:
    """The issues still waiting on the owner's check whose fix is in this build, in plan order: the current
    build milestone first, then found on the phone, then oldest (#927). `shown` holds the issue and PR
    numbers the plan already lists. Each is {'issue', 'prs': its fixing PRs in the build, 'check': the
    check to try, or None, and 'none': True when an issue says there is no check}.

    `built` holds the build's merged PRs, `named_in_build` every #N its merge subjects name. The fix is in the
    build when a merged PR there says it fixes the issue (title "(#854)", "Closes #854"), the issue's
    comments name one ("Merged in #907", "PR #257"), or a merge names the issue ("Merge play-this-moment
    into next (#156, #158)"). The label alone isn't enough: the fix may have merged after this build
    (#927: the label had been read as "waiting on your phone").
    """
    def build_number(issue):
        milestone = issue.get('milestone') or {}
        found = re.fullmatch(r'Build (\d+)', milestone.get('title') or '')
        return int(found.group(1)) if found and milestone.get('state', 'OPEN') == 'OPEN' else None
    current = min(filter(None, map(build_number, issues)), default=None)
    fixes = []
    for issue in issues:
        comments = [(comment or {}).get('body') or '' for comment in (issue.get('comments') or {}).get('nodes') or []]
        named = {int(a or b) for body in comments for a, b in FIXED_IN.findall(body)}
        sources = [(node or {}).get('source') or {} for node in (issue.get('timelineItems') or {}).get('nodes') or []]
        prs = {pr['number']: pr for pr in sources if pr.get('number') in built and pr.get('merged')
               and (issue['number'] in linked_numbers(pr) or pr['number'] in named)}
        for number in sorted(named & built - set(prs)):
            prs[number] = {'number': number, 'title': '', 'body': '', 'url': f'https://github.com/{REPO}/pull/{number}'}
        if not (prs or issue['number'] in named_in_build) or issue['number'] in shown or shown & set(prs):
            continue
        body = next((pr.get('body') or '' for pr in prs.values() if check_field(pr.get('body') or '')), '')
        alone = {'issues': [issue], 'body': body}
        none = says_no_check(alone)
        check = None if none else owner_check(alone)
        fixes.append({'issue': issue, 'prs': list(prs.values()), 'check': check, 'none': none})
    fixes.sort(key=lambda fix: (0 if current and build_number(fix['issue']) == current else 1,
                                0 if FIRST_ON_PHONE & labels(fix['issue']) else 1,
                                fix['issue'].get('createdAt') or ''))
    return fixes


def built_numbers(sha: str) -> set[int]:
    """Every #N in the build's merge subjects: the PRs merged into it and the issues their titles name."""
    subjects = git('log', '--first-parent', '--format=%s', sha, check=False)
    return {int(n) for n in re.findall(r'#(\d+)', subjects)}


def references(check: str) -> list[int]:
    return list(dict.fromkeys(int(a or b) for a, b in REFERENCE.findall(check)))


def waiting_on(check: str, own: set[int], built: set[int], items: dict[int, dict]) -> list[dict]:
    """The issues and PRs a check names that aren't on the phone yet ("after #547 is also on the phone").

    Its own issues and PRs don't count, nor anything a merge in this build names. An issue stays
    open after its PR merges into next, so an open issue counts as built once dispatch has marked it
    `status: needs-human-validation`. A PR counts once it is in this build; one closed unmerged never
    will be, so it doesn't hold the check back. A number GitHub didn't answer for doesn't either.
    """
    waiting = []
    for number in references(check):
        item = items.get(number)
        if number in own or number in built or not item:
            continue
        if item.get('__typename') == 'PullRequest':
            pending = item['state'] != 'CLOSED'
        else:
            pending = item['state'] == 'OPEN' and MERGED_ON_NEXT not in labels(item)
        if pending:
            waiting.append(item)
    return waiting


def listener_facing(pr: dict) -> bool:
    """Changes something a listener sees or hears: the scorecard's rule on #337, made mechanical.

    App code or SessionKit sources changed (tests and fixtures don't count), the title isn't a pure
    move, test or tooling change, and it isn't lane work (#374 touched SessionKit only to build on Linux).
    """
    if NOT_LISTENER_LABELS & labels(pr):
        return False
    paths = [node['path'] for node in pr['files']['nodes']]
    touches = any(p.startswith(LISTENER_PATHS) and not p.startswith(NOT_LISTENER_PATHS) for p in paths)
    return touches and not NOT_LISTENER_TITLE.search(pr['title'])


def check_field(text: str, field: re.Pattern = CHECK_FIELD) -> str | None:
    """A body's "Owner check" field (or another `field`): its line, plus the numbered steps, bullets,
    quote or fenced block right under it (#847: "after #551 is deployed:" lost its three steps), up to
    the next field. Written as a heading ("## Steps"), the field is the section under it (#927)."""
    lines = text.splitlines()
    heading = HEADINGS.get(field)
    for index, line in enumerate(lines):
        match = field.search(line)
        if match:
            break
        found = heading and heading.match(line)
        if found:
            return heading_section(lines[index + 1:], (found.groups() or ('',))[0] or '')
    else:
        return None
    first = NEXT_FIELD_ON_LINE.sub('', next((group for group in match.groups() if group), '')).strip()
    # "4. Owner check: ..." in a numbered Done when list: item 5 is the next item, not its step (#927).
    item = LIST_MARKER.match(line)
    item_indent = len(item.group(1)) if item and not line[item.end():match.start()].strip() else None
    rest: list[str] = []
    fenced = False
    last = 0  # the last number among the steps: "4. Owner check:" may be followed by "1. ..." at the same indent
    for line in lines[index + 1:]:
        sibling = LIST_MARKER.match(line)
        number = re.match(r'\s*(\d+)[.)]\s', line)
        if sibling and number and (int(number.group(1)) == 1 or int(number.group(1)) == last + 1 > 1) and \
                len(sibling.group(1)) <= (item_indent or 0) and item_indent is not None:
            last = int(number.group(1))
            rest.append(line.rstrip())
            continue
        if fenced:
            rest.append(line.rstrip())
            fenced = not line.strip().startswith('```')
        elif FIELD_START.match(line):
            break
        elif item_indent is not None and sibling and len(sibling.group(1)) <= item_indent:
            break
        elif not line.strip():
            if not rest and first and not first.endswith(':'):
                break
            continue  # a blank line inside the steps, or between "...:" and them
        elif STEP_LINE.match(line):
            rest.append(line.rstrip())
            fenced = line.strip().startswith('```')
        elif not first and not rest:
            first = line.strip()  # "**Owner check:**" alone on its line, the check on the next
        else:
            break
    return '\n'.join([first] + rest).strip() or None


def heading_section(lines: list[str], first: str = '') -> str | None:
    """The section under a "## Owner check" or "## Steps" heading: its first paragraph and the steps, bullets
    or fenced block after it, up to the next heading, rule, bold field or other paragraph (#811's PR
    footer isn't a step). Blank lines go, except inside a fenced block. `first` is text on the heading line
    itself ("## Owner check: none")."""
    if NO_CHECK.match(first.strip()):
        return first.strip()  # "## Owner check: none" is the whole answer
    kept: list[str] = [first.strip()] if first.strip() else []
    fenced = gap = False
    for line in lines:
        if fenced:
            kept.append(line.rstrip())
            fenced = not line.strip().startswith('```')
        elif re.match(r'\s{0,3}(?:#{1,6}\s|---)', line) or re.match(r'\s*(?:[-*+]\s+)?' + FIELD, line):
            break
        elif not line.strip():
            gap = bool(kept)
        elif gap and not STEP_LINE.match(line):
            break
        else:
            kept.append(line.rstrip())
            fenced = line.strip().startswith('```')
    return '\n'.join(kept).strip() or None


def comment_check(issue: dict) -> str | None:
    """The newest "Owner check" or "Phone check" in an issue's comments (#927: #180's, #158's and #237's
    checks were written there), or "none (...)" when the newest such comment takes it off the plans
    (#288: "Leave this off the owner's plans until ..."). GitHub lists comments oldest first."""
    for comment in reversed((issue.get('comments') or {}).get('nodes') or []):
        body = (comment or {}).get('body') or ''
        off = next((line.strip() for line in body.splitlines() if OFF_PLANS.search(line)), None)
        if off:
            return f'none ({off})'
        check = check_field(body)
        if check:
            return check
    return None


def issue_check(issue: dict) -> str | None:
    """An issue's check: the newest one in its comments wins over its body's (#927)."""
    return comment_check(issue) or check_field(issue.get('body') or '')


def written_checks(pr: dict) -> list[str]:
    """Every "Owner check" field, issues first, then the PR's own."""
    checks = [issue_check(issue) for issue in pr['issues']] + [check_field(pr.get('body') or '')]
    return [check for check in checks if check]


def taken_off(pr: dict) -> bool:
    """A linked issue's newest comment says there's no check, and no other issue's comment gives one: a
    later call than any body, the PR's included."""
    checks = [check for check in map(comment_check, pr['issues']) if check]
    return bool(checks) and all(NO_CHECK.match(check) for check in checks)


def says_no_check(pr: dict) -> bool:
    """An issue or the PR says "Owner check: none" and nothing gives a real one."""
    checks = written_checks(pr)
    return taken_off(pr) or bool(checks) and all(NO_CHECK.match(check) for check in checks)


def owner_check(pr: dict) -> str | None:
    """The issue's "Owner check" line; else a bug report's Steps and Expected; else the PR's own.

    "Owner check: none" counts as no check, so it never reaches the plan as a thing to try; said in an
    issue's newest comment, it holds even when the PR's body has one (#927).
    """
    if taken_off(pr):
        return None
    for check in written_checks(pr):
        if not NO_CHECK.match(check):
            return check
    texts = [issue.get('body') or '' for issue in pr['issues']] + [pr.get('body') or '']
    for text in texts:
        steps, expected = check_field(text, STEPS_FIELD), check_field(text, EXPECTED_FIELD)
        if steps and expected:  # numbered Steps keep every step (#847: #585 lost the swipe in step 2)
            numbered = chr(10) in steps or STEP_LINE.match(steps)
            return f'{steps}{chr(10) if numbered else " "}Expected: {expected}'
    return None


def plan_entries(facing: list[dict]) -> list[list[dict]]:
    """Listener-facing PRs grouped into one entry per feature, in the order given (#427).

    PRs that link the same issue, or whose owner check reads the same, are one thing to try: two
    Follow PRs once gave the owner the same check twice. An entry is its PRs, first one leading.
    """
    entries: list[list[dict]] = []
    by_key: dict[object, list[dict]] = {}
    for pr in facing:
        check = owner_check(pr)
        keys = [('issue', issue['number']) for issue in pr['issues']]
        if check:
            keys.append(('check', ' '.join(check.lower().split())))
        entry = next((by_key[key] for key in keys if key in by_key), None)
        if entry is None:
            entry = []
            entries.append(entry)
        entry.append(pr)
        for key in keys:
            by_key.setdefault(key, entry)
    return entries


def found_on_phone(entry: list[dict]) -> bool:
    return any(FIRST_ON_PHONE & labels(issue) for pr in entry for issue in pr['issues'])


def passed_on_phone(entry: list[dict]) -> bool:
    """Every issue the entry fixes is closed, which only happens after the owner's pass, so it never goes on a
    plan again (#1100). An entry with no linked issue has nothing to close and stays.

    No timestamps: a follow-up PR can merge after its issue closed (#223 closed 10-04, PR #677 merged 10-05) and
    the owner records the pass as a comment, so closedAt never moves past the merge."""
    issues = [issue for pr in entry for issue in pr['issues']]
    return bool(issues) and all(issue.get('state') == 'CLOSED' for issue in issues)


def labels(item: dict) -> set[str]:
    return {node['name'] for node in item.get('labels', {}).get('nodes', [])}


def report_comments() -> list[str] | None:
    """The bodies of the comments on #184, oldest first; None when gh fails (the plan says unknown)."""
    raw = gh('api', f'repos/{REPO}/issues/{REPORTS_ISSUE}/comments', '--paginate', '--jq', '.[] | .body | @json')
    if raw is None:
        return None
    bodies = []
    for line in raw.split('\n'):  # not splitlines(): JSON leaves U+2028 and friends unescaped
        try:
            body = json.loads(line)
        except ValueError:
            continue
        if isinstance(body, str):
            bodies.append(body)
    return bodies


def report_lines(bodies: list[str], kind: str, sha: str) -> list[str] | None:
    """The lines of the newest `Lane report <kind>-<sha7>` report, starting at its first line, if any.

    The reports are posted inside a ```text fence, so the fence and blank lines before it are skipped.
    """
    wanted = f'Lane report {kind}-{sha[:7]}'
    for body in reversed(bodies):
        lines = [line.strip().replace('**', '') for line in body.splitlines()]
        start = next((i for i, line in enumerate(lines) if line and not line.startswith('```')), None)
        first = lines[start] if start is not None else ''
        if first.startswith(wanted) and first[len(wanted):len(wanted) + 1] in ('', ' '):
            return lines[start:]
    return None


def report_line(bodies: list[str], kind: str, sha: str) -> str | None:
    """The first line of the newest `Lane report <kind>-<sha7>` report, if any."""
    lines = report_lines(bodies, kind, sha)
    return lines[0] if lines else None


def integration_skip(bodies: list[str], sha: str) -> str | None:
    """Why the Test Desk skipped --plan app on this commit, from its journeys report's
    `integration: skipped (<why>)` line (#627), if it did."""
    for line in report_lines(bodies, 'journeys', sha) or []:
        if line.startswith('```'):
            break
        match = re.fullmatch(r'integration: skipped \((.+)\)', line)
        if match:
            return match.group(1).rstrip('.')
    return None


def latest_verdict(sha: str, bodies: list[str] | None = None) -> str | None:
    """The newest integration report on #184 for this commit, whoever ran it (#444)."""
    bodies = report_comments() if bodies is None else bodies
    return report_line(bodies, 'integration', sha) if bodies is not None else None


def step_lines(check: str, sha: str, folder: Path) -> list[str]:
    """A check as plan lines that carry what it needs (#847): its steps under it, a URL in code as a
    link, and a repo file it names (a packet, a PDF) copied into the build's files/ folder, which
    share_files puts next to the plan in iCloud Drive."""
    head, *tail = CODE_URL.sub(r'<\1>', check).split('\n')
    if STEP_LINE.match(head):
        head, tail = '', [head, *tail]
    lines = [f'   - Check: {head}'.rstrip()] + [f'     {line}'.rstrip() for line in tail]
    for name in attach_files(check, sha, folder):
        lines.append(f'   - File: `{name}` comes with this plan. On the phone: Files > iCloud Drive > '
                     f'Spoken Margins test plans > Test plan {sha[:7]} files. On the Mac: the files folder '
                     'next to this plan.')
    return lines


def repo_files(check: str, sha: str) -> list[str]:
    """The repo files a check names in backticks that exist, as files, in the built commit."""
    paths = []
    for path in dict.fromkeys(REPO_FILE.findall(check)):
        spec = f'{sha}:{path}'
        size = git('cat-file', '-s', spec, check=False)
        if git('cat-file', '-t', spec, check=False) == 'blob' and size.isdigit() and int(size) <= ATTACH_LIMIT:
            paths.append(path)
    return paths


def missing_material(check: str, sha: str) -> str | None:
    """The kind of test file a check asks for ("PDF", "packet") when it carries no link and names no repo
    file to attach, so the owner would have nothing to test with (#1038); None when it needs none."""
    found = MATERIAL.search(check)
    if not found or SUPPLIED_URL.search(check) or repo_files(check, sha):
        return None
    kind = (found.group(1) or 'packet').lower()
    return {'pdf': 'PDF', 'epub': 'EPUB'}.get(kind, kind)


def attach_files(check: str, sha: str, folder: Path) -> list[str]:
    """Copy the repo files a check names in backticks, as of the built commit, into folder/files."""
    names = []
    for path in repo_files(check, sha):
        data = subprocess.run(['git', 'cat-file', 'blob', f'{sha}:{path}'], cwd=str(ROOT), capture_output=True).stdout
        (folder / 'files').mkdir(exist_ok=True)
        (folder / 'files' / Path(path).name).write_bytes(data)
        names.append(Path(path).name)
    return names


def icloud_dir() -> Path:
    """The iCloud Drive folder the Desktop installer copies plans to (scripts/install-phone-build.command)."""
    return Path(os.environ.get('SM_PHONE_ICLOUD') or Path.home() / 'Library/Mobile Documents/com~apple~CloudDocs'
                / 'Spoken Margins test plans')


def share_files(folder: Path, sha: str) -> None:
    """Put the plan's files/ in iCloud Drive as "Test plan <sha7> files", where the plan's steps say they are.

    Done here, not by the installer, so the owner's Desktop copy of the installer needn't change (#847).
    A files folder goes once its plan has left iCloud Drive (the installer keeps five) and its build has
    left ~/SpokenMargins-phone. Trouble here never fails the build: the files are still in the folder.
    """
    icloud = icloud_dir()
    if not icloud.parent.is_dir():
        return  # no iCloud Drive on this Mac
    try:
        target = icloud / f'Test plan {sha[:7]} files'
        shutil.rmtree(str(target), ignore_errors=True)
        if (folder / 'files').is_dir():
            icloud.mkdir(exist_ok=True)
            shutil.copytree(str(folder / 'files'), str(target))
        if not icloud.is_dir():
            return
        kept = {build.name.rsplit('-', 1)[-1] for build in phone_dir().iterdir() if build.is_dir()}
        for old in icloud.glob('Test plan * files'):
            sha7 = old.name[len('Test plan '):-len(' files')]
            ours = re.fullmatch(r'[0-9a-f]{7}', sha7) and old.is_dir()  # never the owner's own folders
            if ours and sha7 not in kept and not (icloud / f'Test plan {sha7}.md').exists():
                shutil.rmtree(str(old), ignore_errors=True)
    except OSError as error:
        say(f"couldn't copy the plan's files to iCloud Drive ({error}); they are in {folder / 'files'}")


def write_plan(folder: Path, sha: str, checks: str, commit_in_app: bool = True) -> Path:
    base, base_why = plan_base(sha)
    merged = merged_prs(base, sha)
    prs = fetch_prs(list(merged)) if merged else {}
    where = (f'Settings > Version ends with `{sha[:7]}`' if commit_in_app else
             'Settings > Version shows only the build number: this commit predates the key that names the commit')
    lines = [f'# Phone build `{sha[:7]}`: what to try', '',
             f'Built {datetime.datetime.now().strftime("%Y-%m-%d %H:%M")} from next at `{sha[:7]}`. {where}.', '',
             f'Changes since {base_why}.', '',
             f'Checks before this build: {checks}.', '']
    reports = report_comments()
    verdict = latest_verdict(sha, reports) if reports is not None else None
    skip = integration_skip(reports, sha) if reports is not None and not verdict else None
    lines += [f'Latest integration run for this commit: {verdict}.' if verdict else
              f'Integration run skipped by the Test Desk: {skip}.' if skip else
              'No integration run has reported on this commit yet.' if reports is not None else
              f'GitHub could not be reached, so the integration verdict (on #{REPORTS_ISSUE}) is unknown.']
    journeys = report_line(reports, 'journeys', sha) if reports is not None else None
    if journeys:
        lines.append(f'Latest journeys run for this commit: {journeys}.')
    lines.append('')
    path = folder / 'test-plan.md'
    shutil.rmtree(str(folder / 'files'), ignore_errors=True)  # --plan-only rewrites: only this plan's files
    if prs is None:
        lines += ['GitHub could not be reached, so here are the merges by title only:', '']
        lines += [f'- {subject}' for subject in list(merged.values())[:20]]
        path.write_text('\n'.join(lines) + '\n')
        return path
    ordered = [prs[n] for n in merged if n in prs]
    facing = [pr for pr in ordered if listener_facing(pr)]
    behind = len(ordered) - len(facing)
    # Phone-found bugs first, then changes with a written check, then the rest; newest first within each.
    facing.sort(key=lambda pr: (0 if any(FIRST_ON_PHONE & labels(i) for i in pr['issues']) else 1,
                                0 if owner_check(pr) else 1))
    entries = plan_entries(facing)
    passed = [entry for entry in entries if passed_on_phone(entry)]
    entries = [entry for entry in entries if not any(entry is gone for gone in passed)]
    # Only what the owner can check goes in the ten minutes: a written check (#504). A bug his phone found
    # with none goes with the unchecked changes, and the run names its issues so one gets written (#847);
    # "repeat what you did" sent him back to the issue for his own steps and content.
    check_of = {id(entry): next((found for found in map(owner_check, entry) if found), None) for entry in entries}
    unchecked = [entry for entry in entries if not check_of[id(entry)]]
    needs_check = [issue['number'] for entry in unchecked
                   if found_on_phone(entry) and not all(map(says_no_check, entry))
                   for pr in entry for issue in pr['issues'] if FIRST_ON_PHONE & labels(issue)]
    if needs_check:
        say('found on the phone but no "Owner check:" line, so not in the ten minutes; add one to: '
            + ', '.join(f'#{n}' for n in dict.fromkeys(needs_check)))
    # A check that needs another change still open waits for it (#847: step 2 needed #547).
    checkable = [entry for entry in entries if check_of[id(entry)]]
    # Fixes from earlier builds still waiting on his check go after these (#927: the 887c560 plan had
    # none while ten Build 30 fixes on the phone waited on him).
    pending = fetch_waiting()
    shown = {number for entry in entries for pr in entry
             for number in [pr['number'], *pr.get('linked', ()), *(issue['number'] for issue in pr['issues'])]}
    fixes = waiting_fixes(pending, build_prs(sha), shown, built_numbers(sha)) if pending else []
    unwritten = [fix['issue']['number'] for fix in fixes if not fix['check'] and not fix['none']]
    if unwritten:
        say('waiting on the owner\'s check but no "Owner check:" written, so not in the plan; add one to: '
            + ', '.join(f'#{n}' for n in unwritten))
    fixes = [fix for fix in fixes if fix['check']]
    named = [n for entry in checkable for n in references(check_of[id(entry)])]
    named += [n for fix in fixes for n in references(fix['check'])]
    built = built_numbers(sha) if named or pending else set()
    items = fetch_items(list(dict.fromkeys(n for n in named if n not in built))) if named else {}
    waits = {}
    for entry in checkable:
        own = {number for pr in entry for number in [pr['number'], *pr.get('linked', ())]}
        own |= {issue['number'] for pr in entry for issue in pr['issues']}
        waits[id(entry)] = waiting_on(check_of[id(entry)], own, built, items)
    for fix in fixes:
        fix['needs'] = waiting_on(fix['check'], {fix['issue']['number'], *(pr['number'] for pr in fix['prs'])},
                                  built, items)
    # A check that asks for a PDF or packet it doesn't supply waits for one (#1038), and the run names it.
    lacks = {id(entry): missing_material(check_of[id(entry)], sha) for entry in checkable}
    for fix in fixes:
        fix['lacks'] = missing_material(fix['check'], sha)
    unsupplied = [issue['number'] for entry in checkable if lacks[id(entry)] for pr in entry for issue in pr['issues']]
    unsupplied += [fix['issue']['number'] for fix in fixes if fix['lacks']]
    if unsupplied:
        say('a check asks for a test file it doesn\'t supply, so not in the ten minutes; add the file to the repo '
            'and name its path in backticks in the check, or link it: '
            + ', '.join(f'#{n}' for n in dict.fromkeys(unsupplied)))
    waiting = [entry for entry in checkable if waits[id(entry)] or lacks[id(entry)]]
    checkable = [entry for entry in checkable if not (waits[id(entry)] or lacks[id(entry)])]
    budget = checkable[:PLAN_CHECKS]
    rest = checkable[PLAN_CHECKS:]
    # They share the ten minutes, new changes first; the rest are listed with their links.
    still = [fix for fix in fixes if not fix['needs'] and not fix['lacks']][:PLAN_CHECKS - len(budget)]
    also_waiting = [fix for fix in fixes if fix not in still]
    if not ordered:
        lines += ['Nothing new since that build: this is the same code, rebuilt.', '']
    left_out = f' {len(passed)} changes whose issues are already closed are left out.' if passed else ''
    lines += [f'{len(ordered)} pull requests merged; {len(facing)} change something you see or hear.{left_out}', '',
              '## Try these (about ten minutes)', '']
    if not budget and still:
        lines += ['No change new in this build has a phone check. The fixes below, from earlier builds, '
                  'still wait on yours.', '']
    elif not budget:
        lines += ['Nothing is ready to check on the phone yet; the changes you might notice are listed below.'
                  if waiting and not unchecked else
                  'No phone checks were written for this build; the changes you might notice are listed below.'
                  if unchecked else 'Nothing a listener would notice changed. Use the app as usual for ten minutes.', '']
    for index, entry in enumerate(budget, 1):
        pr = entry[0]
        issues = list({issue['number']: issue for member in entry for issue in member['issues']}.values())
        tag = ' (found on your phone)' if found_on_phone(entry) else ''
        links = [f'[PR #{member["number"]}]({member["url"]})' for member in entry]
        links += [f'[issue #{issue["number"]}]({issue["url"]})' for issue in issues]
        lines += [f'{index}. **{pr["title"]}**{tag}', *step_lines(check_of[id(entry)], sha, folder),
                  f'   - Links: {", ".join(links)}', '']

    def fix_links(fix, label=True):
        issue = fix['issue']
        return [f'[{"issue " if label else ""}#{issue["number"]}]({issue["url"]})'] + \
            [f'[{"PR " if label else ""}#{pr["number"]}]({pr["url"]})' for pr in fix['prs']]

    def fix_tag(fix):
        return ' (found on your phone)' if FIRST_ON_PHONE & labels(fix['issue']) else ''
    if still:
        lines += ['## Still waiting on your check', '',
                  'Fixed in an earlier build and on your phone now, but nobody has checked them yet.', '']
        for index, fix in enumerate(still, len(budget) + 1):
            lines += [f'{index}. **{fix["issue"]["title"]}**{fix_tag(fix)}', *step_lines(fix['check'], sha, folder),
                      f'   - Links: {", ".join(fix_links(fix))}', '']
    if also_waiting:
        lines += ['## Also waiting on your check (not in the ten minutes)', '']
        for fix in also_waiting[:ALSO_WAITING]:
            needs = ', '.join(f'[#{item["number"]}]({item["url"]})' for item in fix['needs'])
            lines.append(f'- {fix["issue"]["title"]}{fix_tag(fix)} ({", ".join(fix_links(fix, label=False))})'
                         + (f': needs {needs} on your phone first' if needs else
                            f': needs a test {fix["lacks"]}, not supplied yet' if fix.get('lacks') else ''))
        if len(also_waiting) > ALSO_WAITING:
            query = 'is%3Aissue+is%3Aopen+label%3A%22' + MERGED_ON_NEXT.replace(':', '%3A').replace(' ', '+') + '%22'
            lines.append(f'- and {len(also_waiting) - ALSO_WAITING} more: '
                         f'[every fix waiting on a check](https://github.com/{REPO}/issues?q={query})')
        lines.append('')
    if pending is None:
        lines += ["GitHub could not be reached, so earlier fixes still waiting on your check aren't listed.", '']

    def titles(group):
        return [f'- {entry[0]["title"]}' + (' (found on your phone)' if found_on_phone(entry) else '') + ' ('
                + ', '.join(f'[#{pr["number"]}]({pr["url"]})' for pr in entry) + ')' for entry in group]
    if rest:
        lines += ['## Also changed (not in the ten minutes)', ''] + titles(rest) + ['']
    if waiting:
        lines += ['## Waiting on another change or a test file (not in the ten minutes)', '',
                  'Their checks need something that is not on your phone yet.', '']
        for entry, title in zip(waiting, titles(waiting)):
            needed = [f'[#{item["number"]}]({item["url"]}) ({item["title"]})' for item in waits[id(entry)]]
            if lacks[id(entry)]:
                needed.append(f'a test {lacks[id(entry)]}, not supplied yet')
            lines.append(f'{title}: needs {", ".join(needed)}')
        lines.append('')
    if unchecked:
        lines += ['## Also changed (no phone check written)', '',
                  "You don't need to test these. If one seems off while you use the app, open a "
                  '`found-on-phone` issue.', ''] + titles(unchecked) + ['']
    lines += [f'Behind the scenes: {behind} more pull requests changed only tests, scripts, docs or the test lane.', '',
              '## If something is wrong', '',
              f'Open an issue labelled `found-on-phone` and name this build: commit `{sha[:7]}`.', '']
    path.write_text('\n'.join(lines))
    return path


# ---- build ---------------------------------------------------------------------------------------

def signing_advice(log: str) -> str | None:
    for needle, advice in SIGNING_HINTS:
        if needle in log:
            return advice
    return None


def remove_worktree(src: Path) -> None:
    """Remove a temporary build worktree of ours: its tool links first, then the worktree itself."""
    for link in ('.venv', 'node_modules'):
        if (src / link).is_symlink():
            (src / link).unlink()
    if src.exists():
        # --force: this is a detached scratch checkout this script made; nobody works in it.
        git('worktree', 'remove', '--force', str(src), check=False)
    shutil.rmtree(src, ignore_errors=True)
    git('worktree', 'prune', check=False)


def clear_work() -> None:
    work = phone_dir() / '.work'
    for leftover in sorted(work.glob('*')) if work.exists() else []:
        say(f'removing a leftover scratch folder: {leftover}')
        remove_worktree(leftover / 'src')
        shutil.rmtree(leftover, ignore_errors=True)


def run_logged(command: list[str], cwd: Path, log: Path, env=None) -> int:
    with open(log, 'a') as handle:
        handle.write(f'\n$ {" ".join(command)}\n')
        handle.flush()
        return subprocess.call(command, cwd=str(cwd), stdout=handle, stderr=subprocess.STDOUT, env=env)


def tail(path: Path, count: int = 30) -> str:
    try:
        return '\n'.join(path.read_text(errors='replace').splitlines()[-count:])
    except OSError:
        return ''


def prune() -> None:
    builds = sorted(p for p in phone_dir().iterdir() if p.is_dir() and re.match(r'\d{8}-\d{6}-[0-9a-f]{7}$', p.name))
    for old in builds[:-keep_count()] if keep_count() > 0 else []:
        say(f'deleting an older build: {old.name}')
        shutil.rmtree(old, ignore_errors=True)


def point_latest(folder: Path) -> None:
    link = phone_dir() / 'latest'
    temporary = phone_dir() / '.latest-new'
    if temporary.is_symlink() or temporary.exists():
        temporary.unlink()
    os.symlink(folder.name, temporary)
    os.replace(temporary, link)


def notify(title: str, message: str) -> None:
    """Post a macOS notification (Notification Center keeps it). Never fails the build."""
    command = os.environ.get('SM_PHONE_NOTIFY', 'osascript')
    if command == 'off':
        return
    script = ['-e', 'on run argv', '-e',
              'display notification (item 1 of argv) with title (item 2 of argv) sound name "Glass"', '-e', 'end run']
    try:
        subprocess.run([*command.split(), *script, message, title], capture_output=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        pass


def notify_ready(sha: str, plan: Path) -> None:
    try:
        text = plan.read_text()
    except OSError:
        text = ''
    count = len(re.findall(r'(?m)^\d+\. \*\*', text))
    things = (f'{count} thing{"" if count == 1 else "s"} to try' if count else
              'nothing a listener would notice changed' if 'Nothing a listener would notice' in text else
              'nothing to check on the phone this time')
    notify('Spoken Margins: new phone build',
           f'Commit {sha[:7]} is ready: {things}. Plug in your iPhone and double-click '
           '"Install Spoken Margins on iPhone" on the Desktop.')


def record_attempt(sha: str, result: str) -> None:
    (phone_dir() / 'last-attempt.json').write_text(json.dumps(
        {'sha': sha, 'result': result, 'at': datetime.datetime.now().isoformat(timespec='seconds')}) + '\n')


def build(sha: str) -> int:
    stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
    work = phone_dir() / '.work' / f'{stamp}-{sha[:7]}'
    src, derived, log = work / 'src', work / 'dd', work / 'build.log'
    work.mkdir(parents=True)
    try:
        say(f'checking out {sha[:7]} in a temporary worktree')
        git('worktree', 'add', '--detach', str(src), sha)
        pointers = [p for p in (src / 'App/SpokenMarginsApp/Resources/Supertonic/onnx').glob('*.onnx')
                    if p.stat().st_size < 1024 and p.read_bytes().startswith(b'version https://git-lfs')]
        if pointers:
            run_logged(['git', 'lfs', 'pull'], src, log)
            if any(p.stat().st_size < 1024 for p in pointers):
                raise RuntimeError('the voice models are still Git LFS pointers after `git lfs pull`')
        run_logged(['bash', str(src / 'scripts/setup-worktree.sh')], src, log)
        lane = [sys.executable, str(SCRIPTS / 'xcodebuild-lane')]
        project = ['-project', 'SpokenMarginsNative.xcodeproj', '-scheme', 'SpokenMarginsApp']
        checks = runner_tested(sha)
        if not checks:
            say('the runner did not test this exact commit; running host tests and the simulator build here first')
            if run_logged([str(src / '.venv/bin/python'), 'scripts/verify-tests.py', '--plan', 'fast',
                           '--output', str(work / 'fast')], src, log) != 0:
                raise BuildFailed('host tests (--plan fast) failed')
            if run_logged([*lane, *project, '-destination', 'generic/platform=iOS Simulator',
                           '-derivedDataPath', str(work / 'dd-sim'), 'build-for-testing'], src, log) != 0:
                raise BuildFailed('the simulator build failed')
            shutil.rmtree(work / 'dd-sim', ignore_errors=True)
            checks = 'host tests (--plan fast) and the simulator build passed here, on this exact commit'
        say(f'checks: {checks}')
        say('building the signed Release app for iPhone (waits for a build slot)')
        started = datetime.datetime.now()
        if run_logged([*lane, *project, '-configuration', 'Release', '-destination', 'generic/platform=iOS',
                       '-derivedDataPath', str(derived), '-allowProvisioningUpdates',
                       f'SM_BUILD_COMMIT={sha}', 'build'], src, log) != 0:
            advice = signing_advice(log.read_text(errors='replace'))
            raise BuildFailed('the iPhone build failed' + (f'. Signing needs the owner: {advice}' if advice else ''))
        seconds = int((datetime.datetime.now() - started).total_seconds())
        app = derived / 'Build/Products/Release-iphoneos' / APP_NAME
        if not (app / 'embedded.mobileprovision').exists():
            raise BuildFailed(f'{app} is missing or has no provisioning profile, so a phone would refuse it')
        if run_logged(['codesign', '--verify', '--strict', str(app)], src, log) != 0:
            raise BuildFailed('the app\'s signature does not verify (codesign --verify)')
        info = plistlib.loads((app / 'Info.plist').read_bytes())
        if 'SMBuildCommit' in info and info['SMBuildCommit'] != sha:
            raise BuildFailed(f'the app says it was built from {info["SMBuildCommit"]!r}, not {sha}')
        folder = phone_dir() / f'{stamp}-{sha[:7]}'
        folder.mkdir()
        subprocess.check_call(['ditto', str(app), str(folder / APP_NAME)])
        shutil.copy(log, folder / 'build.log')
        size = int(subprocess.check_output(['du', '-sk', str(folder / APP_NAME)]).split()[0]) * 1024
        details = {'sha': sha, 'sha7': sha[:7], 'subject': git('log', '-1', '--format=%s', sha),
                   'built_at': datetime.datetime.now().isoformat(timespec='seconds'), 'build_seconds': seconds,
                   'app': APP_NAME, 'app_bytes': size, 'bundle_version': info.get('CFBundleVersion'),
                   'commit_in_app': info.get('SMBuildCommit') or None, 'checks': checks}
        (folder / 'build.json').write_text(json.dumps(details, indent=2) + '\n')
        plan = write_plan(folder, sha, checks, commit_in_app=bool(info.get('SMBuildCommit')))
        point_latest(folder)
        record_attempt(sha, 'built')
        prune()
        share_files(folder, sha)
        say(f'done: {folder}')
        say(f'app {size / 1e6:.0f} MB, built in {seconds} s; test plan: {plan}')
        notify_ready(sha, plan)
        return 0
    except (BuildFailed, RuntimeError, subprocess.CalledProcessError, OSError) as failure:
        record_attempt(sha, f'failed: {failure}')
        if log.exists():
            shutil.copy(log, phone_dir() / 'last-failure.log')
        say(f'FAILED on {sha[:7]}: {failure}')
        say(f'log: {phone_dir() / "last-failure.log"}; its end:\n{tail(log)}')
        if 'Signing needs the owner' in str(failure):
            # Only signing waits on the owner; other failures clear with the next change on next.
            notify('Spoken Margins: phone build needs you', str(failure).split('Signing needs the owner: ', 1)[-1])
        return 1
    finally:
        remove_worktree(src)
        shutil.rmtree(work, ignore_errors=True)


class BuildFailed(Exception):
    pass


def main(argv) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--commit', help='build this commit instead of origin/next')
    parser.add_argument('--if-changed', action='store_true', help='skip unless next moved since latest')
    parser.add_argument('--plan-only', action='store_true', help="rewrite latest's test-plan.md and stop")
    args = parser.parse_args(argv)
    phone_dir().mkdir(parents=True, exist_ok=True)
    if args.plan_only:
        folder = (phone_dir() / 'latest').resolve()
        info = read_json(folder / 'build.json')
        if not info:
            say('no latest build yet')
            return 1
        say(f'rewrote {write_plan(folder, info["sha"], info.get("checks", "unknown"), bool(info.get("commit_in_app")))}')
        share_files(folder, info['sha'])
        return 0
    lock = open(phone_dir() / '.phone-build.lock', 'a+')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        say('another phone build is running; nothing to do')
        return 0
    if not os.environ.get('SM_PHONE_NO_FETCH'):
        git('fetch', 'origin', BRANCH, '-q', check=False)
    sha = git('rev-parse', f'{args.commit or "origin/" + BRANCH}^{{commit}}')
    if args.if_changed:
        if latest_build().get('sha') == sha:
            say(f'latest is already {sha[:7]}; nothing to do')
            return 0
        attempt = read_json(phone_dir() / 'last-attempt.json')
        if attempt.get('sha') == sha and str(attempt.get('result', '')).startswith('failed'):
            say(f'{sha[:7]} already failed ({attempt["result"]}); waiting for a newer next')
            return 0
    reason = guard_reason()
    if reason:
        say(f'skipped: {reason}')
        return EXIT_SKIPPED
    clear_work()
    return build(sha)


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
