<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Five-minute lightweight tick. Script gates 08:00/17:00 America/Chicago, including DST.
     Deployment and project-chat relay setup: docs/workstreams/daily-phone-plan.md.
     Runs from the ops checkout, which scripts/ops_checkout.py keeps on main (#2372), so a session's branch
     switch in the development checkout cannot change what the job runs.
     No token goes in this file (2026-11-04): the script reads the Claude token (Keychain service claude-code-oauth)
     and the relay token (sm-daily-relay-token) from the login Keychain. Only SM_DAILY_RELAY_URL is added here. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.spokenmargins.daily-phone-plan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>@HOME@/SpokenMarginsOps/repo/scripts/daily-phone-plan</string>
  </array>
  <key>WorkingDirectory</key><string>@HOME@/SpokenMarginsOps/repo</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>SM_PIN_CHECKOUT</key><string>@HOME@/SpokenMarginsOps/repo</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>@HOME@/SpokenMargins-phone/daily-plan.log</string>
  <key>StandardErrorPath</key><string>@HOME@/SpokenMargins-phone/daily-plan.log</string>
</dict>
</plist>
