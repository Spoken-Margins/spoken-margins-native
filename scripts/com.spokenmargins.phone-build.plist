<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The rolling phone build's poll (#384, #1329): every 10 minutes, check the trunk's tip. scripts/phone-build
  coalesces changed tips to at most one start per hour, or sooner after an integration PASS. Owner
  requests that leave out the if-changed flag build immediately. The script keeps its Release cache and handles
  one build at a time, memory/disk guards, test evidence and failed-tip suppression. Not installed by the PR.

  Install (once, from the main checkout):
    run ops/install-launchd.py with its install option and the job name phone-build (this file holds
    a home-folder placeholder; copying it into ~/Library/LaunchAgents/ as is would load a broken job)
  Remove:
    the same script with its remove option (see docs/scheduled-jobs.md)

  It runs the main checkout's copy, which the hourly Mac tick fast-forwards to origin/main. A
  LaunchAgent runs in the owner's login session, so signing can use his login keychain.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.spokenmargins.phone-build</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>@HOME@/Documents/GitHub/spoken-margins-native/scripts/phone-build</string>
    <string>--if-changed</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@HOME@/Documents/GitHub/spoken-margins-native</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/SpokenMargins-phone/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/SpokenMargins-phone/launchd.log</string>
</dict>
</plist>
