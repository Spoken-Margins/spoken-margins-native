#!/usr/bin/env python3
"""xcodebuild through the Mac-wide build semaphore, with this worktree's own DerivedData.

Usage: scripts/xcodebuild-lane <xcodebuild arguments>

- Waits for one of the two Mac-wide build slots (scripts/lane_slots.py), so stream sessions and
  the lane never run more than two builds at once. Queued builds print who holds the slots.
- Adds `-derivedDataPath <worktree>/.build/dd` unless the arguments already name one. A shared
  DerivedData across branches produces false "does not conform" errors (AGENTS.md).
- Adds `ARCHS=arm64` to a generic iOS Simulator build on Apple silicon, unless the arguments set
  ARCHS or -arch. A generic destination builds every architecture: each Swift file, packages
  included, was compiled for x86_64 too, a simulator no Mac here runs (#1326).
- Information-only calls (-version, -list, -showBuildSettings, -exportArchive, ...) skip all three.
"""
import os
from pathlib import Path
import platform
import signal
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lane_slots import build_slot  # noqa: E402

NO_BUILD_FLAGS = {'-version', '-list', '-showsdks', '-showBuildSettings', '-showdestinations',
                  '-showTestPlans', '-help', '-h', '-usage', '-license', '-checkFirstLaunchStatus',
                  '-runFirstLaunch', '-exportArchive', '-importLocalizations', '-exportNotarizedApp',
                  '-create-xcframework'}


def worktree_root():
    try:
        return Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True,
                                            stderr=subprocess.DEVNULL).strip())
    except (OSError, subprocess.CalledProcessError):
        return Path.cwd()


def simulator_arch(args, machine=None):
    """['ARCHS=arm64'] for a generic iOS Simulator build on Apple silicon that sets no architecture, else []."""
    destinations = [args[i + 1].replace(' ', '') for i, arg in enumerate(args[:-1]) if arg == '-destination']
    if (machine or platform.machine()) != 'arm64' or '-arch' in args or any(a.startswith('ARCHS=') for a in args):
        return []
    return ['ARCHS=arm64'] if any(d.startswith('generic/platform=iOSSimulator') for d in destinations) else []


def main(argv):
    xcodebuild = os.environ.get('SM_LANE_XCODEBUILD', 'xcodebuild')
    if any(arg in NO_BUILD_FLAGS for arg in argv):
        os.execvp(xcodebuild, [xcodebuild, *argv])
    args = list(argv)
    if '-derivedDataPath' not in args:
        args += ['-derivedDataPath', str(worktree_root() / '.build/dd')]
    args += simulator_arch(args)
    derived = args[args.index('-derivedDataPath') + 1]
    action = next((a for a in reversed(argv) if not a.startswith('-') and '=' not in a
                   and a in {'build', 'build-for-testing', 'archive', 'test', 'test-without-building',
                             'analyze', 'clean', 'install', 'installsrc', 'docbuild'}), 'build')
    label = f'xcodebuild {action}'
    with build_slot(label):
        print(f'[lane] DerivedData: {derived}', file=sys.stderr, flush=True)
        process = subprocess.Popen([xcodebuild, *args])

        def forward(signum, _frame):
            process.send_signal(signum)

        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(signum, forward)
        result = process.wait()
    return 128 - result if result < 0 else result


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
