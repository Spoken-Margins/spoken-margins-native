#!/usr/bin/env python3
"""Boot a lane simulator under the lane's rules, watch it, and remove it (scripts/lane_sim.py).

  scripts/lane-sim-boot --pool                          take a Test Desk pool device (erased, or new while the pool has room), boot it, print its UDID
  scripts/lane-sim-boot --fresh "SM Lane Desk pr220"   create a fresh iOS 26 iPhone, boot it, print its UDID
  scripts/lane-sim-boot <udid>                          boot an existing device
  scripts/lane-sim-boot --done <udid>                   stop its watcher, shut it down, delete it (a pool device is erased and kept)
  scripts/lane-sim-boot --retire <udid> <reason>        after a crash flood: mark it unsafe, shut it down at once, stop its watcher, delete it
  scripts/lane-sim-boot --second-slot status|on|off [reason]   the second simulator slot's switch

It first takes a simulator slot and the device's background watcher keeps it until --done. A job can
always start when no other simulator job runs; it may join one only while memory pressure is normal
and the second slot is on (on this 16 GB Mac two simulators plus builds filled swap, #184). While
any simulator job runs, builds get one slot. The lane goes back to one simulator by itself when a
two-simulator run times out or pressure stays at warn for 10 minutes with two up, and back to two
after a cooldown once pressure is normal (4 h, doubling per repeat trip that week, at most 24 h).
One boot at a time Mac-wide, no builds while it boots, never a retry after a failed boot, and a stop
at the first SpringBoard crash. A boot stall (SpringBoard restarted or vanished while booting) of a --pool or
--fresh device gets one fresh device in its place: the stalled one is retired, never booted again, and the
stall is logged on #1802 (no retry when a crash report names the stalled device). A named <udid> gets no retry. After the boot, the watcher keeps watching SpringBoard and shuts the
device down (and marks it unsafe) at the first crash; its log is next to the lane's state
(~/Library/Caches/SpokenMarginsLane/watch-<udid>.log). A device that failed is marked unsafe: remove
it with --done and start again (--pool or --fresh).
The Test Desk uses --pool: up to three devices named "SM Lane Desk pool N" that the owner approves once
in the simulator panel (the approval survives an erase). Each run erases the least recently used free one
instead of creating a device; --done shuts it down, erases it and keeps it. A device marked unsafe is
retired instead (deleted and dropped), and a replacement is created when the next run needs one
(scripts/lane_sim_pool.py, #688). --fresh stays for one-off devices.
Always finish with --done: until then the device keeps the simulator slot.
Exit 0 when ready; the UDID is the only thing printed on stdout.
"""
import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
import lane_sim  # noqa: E402
import lane_sim_pool  # noqa: E402
from lane_slots import acquire_simulator_slot, release_handle  # noqa: E402

SLOT_WAIT = 7200


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    target = parser.add_mutually_exclusive_group(required=True)
    target.add_argument('udid', nargs='?')
    target.add_argument('--fresh', metavar='NAME', help='create a fresh temporary device with this name first')
    target.add_argument('--pool', action='store_true',
                        help="take one of the Test Desk's pool devices, erased and ready to boot (or create it while the pool has room)")
    target.add_argument('--done', metavar='UDID', help='stop the watcher and shut the device down, then delete it (a pool device is erased and kept)')
    target.add_argument('--retire', nargs='+', metavar=('UDID', 'REASON'),
                        help='mark the device unsafe (say why), then stop its watcher, shut it down and delete it; for a crash flood')
    target.add_argument('--watch', metavar='UDID', help=argparse.SUPPRESS)  # the background watcher itself
    target.add_argument('--second-slot', nargs='+', metavar=('status|on|off', 'REASON'),
                        help='show or switch the second simulator slot; "off" needs a reason')
    parser.add_argument('--crash-window', nargs=2, type=float, help=argparse.SUPPRESS)  # the boot, for the late check
    parser.add_argument('--timeout', type=float, default=lane_sim.FIRST_BOOT_TIMEOUT,
                        help='seconds to wait for readiness (default %(default).0f)')
    args = parser.parse_args(argv)
    if args.second_slot:
        import lane_slots
        action, reason = args.second_slot[0], ' '.join(args.second_slot[1:])
        if action == 'on':
            lane_slots.enable_second_slot()
        elif action == 'off':
            if not reason:
                parser.error('--second-slot off needs a reason')
            lane_sim.back_to_one_simulator(f'{reason} (switched off by hand)', by_hand=True)
        elif action != 'status':
            parser.error('--second-slot takes status, on or off')
        allowed, why = lane_slots.second_slot_status()
        print(f'second simulator slot: {"available" if allowed else "not available"} ({why}); '
              f'simulator jobs running: {lane_slots.simulator_jobs_running()}')
        return 0
    if args.watch:
        print(f'[lane] watching {args.watch}', flush=True)
        window = tuple(args.crash_window) if args.crash_window else None
        print(f'[lane] watcher for {args.watch} ended: {lane_sim.watch(args.watch, crash_window=window)}', flush=True)
        return 0
    if args.retire:
        udid, reason = args.retire[0], ' '.join(args.retire[1:]) or 'retired by hand'
        lane_sim.mark_unsafe(udid, reason)  # first, so nothing erases or boots it again; the lane guard blocks it after
        lane_sim.record_event(udid, f'marked unsafe by --retire: {reason}')
        lane_sim_pool.shut_down(udid)  # at once: --done below can wait for the pool lock behind another run's erase
        args.done = udid
    if args.done:
        if lane_sim_pool.in_pool(args.done):
            outcome = lane_sim_pool.release(args.done)
            print(f'[lane] {args.done} '
                  + {'kept': 'released: watcher stopped, shut down, erased and kept in the desk pool',
                     'retired': 'released: watcher stopped, shut down; marked unsafe, so deleted and dropped from the pool',
                     'idle': 'is not held by any run (already released), so it was left alone'}[outcome],
                  file=sys.stderr)
            return 0
        lane_sim.release(args.done)
        print(f'[lane] {args.done} released: watcher stopped, shut down, deleted', file=sys.stderr)
        return 0
    name = args.fresh or args.udid or 'a desk pool device'
    try:
        slot = acquire_simulator_slot(f'lane-sim-boot {name} (its watcher holds it until --done)',
                                      max_wait=SLOT_WAIT)
    except TimeoutError as error:
        print(f'[lane] STOP: the simulator slot stayed busy: {error}', file=sys.stderr)
        return 4
    pooled = None
    try:
        if args.pool:
            udid = pooled = lane_sim_pool.take('lane-sim-boot --pool')
        else:
            udid = lane_sim.create_temporary(args.fresh) if args.fresh else args.udid
        if args.fresh:
            print(f'[lane] created {args.fresh}: {udid}', file=sys.stderr)
        info = {}

        def replace(stalled):
            nonlocal pooled
            if args.pool:
                lane_sim_pool.unclaim(stalled)  # marked unsafe, so take() retires it
                pooled = None
                pooled = lane_sim_pool.take('lane-sim-boot --pool (retry after a boot stall)')
                return pooled
            lane_sim.release(stalled)
            return lane_sim.create_temporary(args.fresh)

        # An erased pool device migrates its data like a new one, so its first boot gets the same tolerance.
        try:
            udid, seconds = lane_sim.boot_with_retry(udid, f'lane-sim-boot {udid}', replace if (args.fresh or args.pool)
                                                     else None, timeout=args.timeout, info=info,
                                                     first_boot=bool(args.fresh or args.pool))
        except lane_sim.BootError:
            if args.fresh and info.get('udid', udid) != udid:
                lane_sim.release(info['udid'])  # the fresh retry device this run made; the first is already deleted
            raise
        lane_sim.start_watcher(udid, Path(__file__).resolve(), slot=slot, crash_window=info.get('boot_window'))
        if pooled:
            lane_sim_pool.unclaim(pooled)  # from here the Booted state and the watcher keep the device busy
        if info.get('tolerated'):
            print(f'[lane] tolerated one SpringBoard change during the first boot ({info["tolerated"]}); the watcher '
                  'rechecks crash reports for the next few minutes and marks the device unsafe if one names it',
                  file=sys.stderr)
    except lane_sim.BootError as error:
        release_handle(slot)
        if pooled:
            lane_sim_pool.unclaim(pooled)  # marked unsafe, the next --pool retires it
        print(f'[lane] STOP: {error}', file=sys.stderr)
        return 3
    except BaseException:
        release_handle(slot)
        if pooled:
            lane_sim_pool.unclaim(pooled)
        raise
    slot.close()  # the watcher inherited the slot and holds it, holder note included, until --done
    print(f'[lane] {udid} is ready after {seconds:.0f}s; its watcher holds the simulator slot until --done',
          file=sys.stderr)
    print(udid)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
