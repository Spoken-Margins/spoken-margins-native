{
  "about": "Listener tap costs from the likely starting screen (#2396). A swipe counts as one tap; typing and speaking cost nothing; choosing a destination in a system sheet costs one. budget is the most taps the route may take: lower it when a change makes the route cheaper, and raise it only on purpose, in the diff that adds the step. docs/task-cost-map.md says how to read it.",
  "countedKinds": [
    "tap",
    "swipe",
    "system"
  ],
  "freeKinds": [
    "type",
    "speak"
  ],
  "actions": [
    {
      "id": "mark-complete",
      "action": "Mark an item complete",
      "recheck": "Library keeps its scroll position by row id (FollowingScrollMemory); about 0.3 s jump on return, 0 taps.",
      "routes": [
        {
          "route": "Swipe the Library row",
          "start": "Library tab",
          "budget": 1,
          "leavesScreen": false,
          "steps": [
            {
              "do": "swipe",
              "label": "Swipe right on the row (Mark Complete)",
              "marker": "\"library.complete.",
              "file": "ExperienceLibraryScreen.swift"
            }
          ]
        },
        {
          "route": "From the playing item, back to Library, swipe",
          "start": "Playback screen",
          "budget": 2,
          "leavesScreen": false,
          "steps": [
            {
              "do": "tap",
              "label": "Library",
              "marker": "\"playback.home.button",
              "file": "PlaybackScreen.swift"
            },
            {
              "do": "swipe",
              "label": "Swipe right on the pinned Continue row",
              "marker": "\"library.complete.",
              "file": "ExperienceLibraryScreen.swift"
            }
          ]
        },
        {
          "route": "From the playing item, via Item options",
          "start": "Playback screen",
          "budget": 4,
          "leavesScreen": true,
          "steps": [
            {
              "do": "tap",
              "label": "More",
              "marker": "\"playback.options.button",
              "file": "PlaybackScreen.swift"
            },
            {
              "do": "tap",
              "label": "Item",
              "marker": "\"playback.item.button",
              "file": "PlaybackScreen.swift"
            },
            {
              "do": "tap",
              "label": "Item options menu",
              "marker": "Item options",
              "file": "ExperienceItemDetailScreen.swift"
            },
            {
              "do": "tap",
              "label": "Mark Complete",
              "marker": "\"item.markComplete.button",
              "file": "ExperienceItemDetailScreen.swift"
            }
          ],
          "note": "Expensive: the menu has no identifier of its own; #2393 asks for a cheaper way from playback."
        }
      ]
    },
