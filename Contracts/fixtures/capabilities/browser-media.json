{
  "schemaVersion": "runtime-capability-profile.v1",
  "id": "browser-media",
  "displayName": "Browser Media Runtime",
  "surface": "browser_extension",
  "connectivity": "browser_page",
  "mediaOwnership": "browser_owned",
  "capabilities": {
    "playback": ["browser_owned_media"],
    "timeline": ["transcript_segments", "media_time", "chapter_timing", "playback_rate_observation"],
    "interjection": ["record_audio", "capture_transcript_anchor", "capture_media_anchor"],
    "ai": ["defer_ai_jobs"],
    "sync": ["browser_session_handoff"],
    "remoteControl": ["display_snapshot", "send_transport_commands", "send_chapter_jump", "send_interjection_commands"]
  },
  "forbiddenCapabilities": ["native_media", "prerendered_audio", "realtime_tts"],
  "notes": ["Browser observes or controls page-owned media and anchors to source media time, not wall-clock time."]
}
