{
  "schemaVersion": "session-trace.v1",
  "name": "lock-screen-widget-controls",
  "description": "Lock screen, widget, and Live Activity surfaces display PlaybackPosition-derived chapter/progress context and delegate transport, chapter, and interjection commands to the phone/tablet runtime.",
  "runtimeProfile": "lock-screen-widget",
  "requiresCapabilities": {
    "timeline": [
      "chapter_timing",
      "media_time",
      "transcript_segments"
    ],
    "interjection": [
      "delegate_interjection_to_canonical_runtime"
    ],
    "remoteControl": [
      "display_snapshot",
      "send_transport_commands",
      "send_chapter_jump",
      "send_interjection_commands"
    ]
  },
  "fixtures": {
    "item": "fixtures/items/text-with-listening-map.json",
    "listeningMap": "fixtures/maps/valid-listening-map.json"
  },
  "steps": [
    {
      "event": "sessionSnapshotReceived",
      "expect": {
        "title": "You Can't Inspect the Pill",
        "chapterTitle": "Reasonable distrust",
        "status": "playing",
        "compactSurfaceReady": true,
        "progressPercent": 46,
        "mediaTimeMs": 42000,
        "durationMs": 92000,
        "transcriptSegmentId": "seg-pill-003"
      }
    },
    {
      "command": "togglePlayPause",
      "expect": {
        "delegatedToCanonicalRuntime": true,
        "status": "paused"
      }
    },
    {
      "command": "jumpToChapter",
      "args": {
        "chapterId": "ch-anecdotes"
      },
      "expect": {
        "delegatedToCanonicalRuntime": true,
        "chapterTitle": "Anecdotes mislead"
      }
    },
    {
      "command": "beginInterjection",
      "expect": {
        "openedApp": true,
        "delegatedToCanonicalRuntime": true,
        "backendCommand": "SessionEngine.beginInterjection",
        "phase": "recording_interjection",
        "localRecordingStarted": false,
        "payload": {
          "mediaTimeMs": 42000,
          "durationMs": 92000,
          "chapterId": "ch-anecdotes",
          "transcriptSegmentId": "seg-pill-003"
        }
      }
    },
    {
      "command": "finishInterjection",
      "expect": {
        "delegatedToCanonicalRuntime": true,
        "phase": "item_playback"
      }
    }
  ],
  "assertions": [
    "The lock screen/widget/Live Activity does not own playback, recording, persistence, or AI.",
    "The surface only shows commands allowed by the active profile.",
    "Interjection commands open the app and delegate beginInterjection to the canonical phone/tablet runtime instead of starting local extension recording.",
    "Chapter and progress display prefer PlaybackPosition-derived mediaTimeMs and durationMs when available.",
    "Chapter jumps and interjection payloads preserve chapter and transcript segment anchors when available."
  ]
}
