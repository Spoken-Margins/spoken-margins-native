{
  "schemaVersion": "session-trace.v1",
  "name": "ai-malformed-structure-preserves-text",
  "description": "Assistant text remains playable and exportable when AI-generated chapter or map structure is malformed.",
  "runtimeProfile": "phone-tablet-online",
  "requiresCapabilities": {
    "playback": ["assistant_turn_tts"],
    "timeline": ["text_char_offsets"],
    "ai": ["continue_discussion"],
    "sync": ["canonical_persistence"]
  },
  "fixtures": {
    "item": "fixtures/items/text-with-listening-map.json",
    "session": "fixtures/sessions/summary-addendum-discussion.json"
  },
  "steps": [
    {
      "event": "aiStreamDelta",
      "args": {
        "turnId": "turn-response-malformed",
        "content": "<sm_response>Durable response body.</sm_response><sm_chapters_json>{not valid json</sm_chapters_json>"
      },
      "expect": {
        "turnText": "Durable response body.",
        "turnStatus": "streaming"
      }
    },
    {
      "event": "aiJobCompleted",
      "args": { "turnId": "turn-response-malformed" },
      "expect": {
        "turnStatus": "complete",
        "turnText": "Durable response body.",
        "chapters": [],
        "textPlayable": true,
        "textExportable": true
      }
    },
    {
      "command": "playTurn",
      "args": { "turnId": "turn-response-malformed" },
      "expect": { "phase": "ai_response_playback", "targetType": "assistant_turn_tts" }
    }
  ],
  "assertions": [
    "Malformed chapter JSON does not erase assistant response text.",
    "Malformed structure yields empty, failed, or repairable structure.",
    "The assistant response remains playable.",
    "The assistant response remains exportable."
  ]
}
