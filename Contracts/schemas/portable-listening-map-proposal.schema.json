{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenmargins.local/schemas/portable-listening-map-proposal.schema.json",
  "title": "Portable Listening Map proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schemaVersion", "createdAt", "generator", "scenes"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "schemaVersion": { "const": "spoken-margins.listening-map-proposal.v2" },
    "languageCode": { "type": ["string", "null"], "maxLength": 35 },
    "createdAt": { "type": "string", "format": "date-time" },
    "generator": { "type": "string", "minLength": 1, "maxLength": 200 },
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["anchorType", "machineEvidenceAssetIds"],
      "properties": {
        "anchorType": { "enum": ["text", "transcript", "media", "turn"] },
        "startChar": { "type": ["integer", "null"], "minimum": 0 },
        "endChar": { "type": ["integer", "null"], "minimum": 0 },
        "exactText": { "type": ["string", "null"], "maxLength": 1000 },
        "prefix": { "type": ["string", "null"], "maxLength": 500 },
        "suffix": { "type": ["string", "null"], "maxLength": 500 },
        "mediaTimeMs": { "type": ["integer", "null"], "minimum": 0 },
        "roughPercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "transcriptSegmentId": { "type": ["string", "null"], "maxLength": 300 },
        "chapterTitle": { "type": ["string", "null"], "maxLength": 500 },
        "machineEvidenceAssetIds": {
          "type": "array", "uniqueItems": true, "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order", "eligibility", "startAnchor", "endAnchor"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "order": { "type": "integer", "minimum": 0 },
        "title": { "type": ["string", "null"], "maxLength": 500 },
        "summaryText": { "type": ["string", "null"], "maxLength": 10000 },
        "summaryAssetId": { "type": ["string", "null"], "maxLength": 200 },
        "summaryProvenance": { "enum": ["publisher_supplied", "sender_authored", "deterministic", "model_generated", null] },
        "eligibility": { "enum": ["eligible", "excluded", "unknown"] },
        "eligibilityReason": { "type": ["string", "null"], "maxLength": 500 },
        "startAnchor": { "$ref": "#/$defs/anchor" },
        "endAnchor": { "$ref": "#/$defs/anchor" }
      }
    }
  }
}
