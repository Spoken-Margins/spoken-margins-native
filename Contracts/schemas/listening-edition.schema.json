{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Listening Edition",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "text",
    "generator",
    "overview",
    "scenes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "spoken-margins.listening-edition.v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sourceURL": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000000
    },
    "generator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "overview": {
      "type": "string",
      "maxLength": 10000
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "title",
          "description",
          "summary",
          "startBlock",
          "endBlock"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "startBlock": {
            "type": "integer",
            "minimum": 1
          },
          "endBlock": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
