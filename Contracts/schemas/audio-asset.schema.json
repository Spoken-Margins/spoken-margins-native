{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenmargins.local/schemas/audio-asset.schema.json",
  "title": "AudioAsset",
  "type": "object",
  "required": ["schemaVersion", "id", "itemId", "audioSourceType", "availability", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "audio-asset.v1" },
    "id": { "type": "string", "minLength": 1 },
    "itemId": { "type": "string", "minLength": 1 },
    "audioSourceType": {
      "enum": [
        "generated_tts_realtime",
        "generated_tts_prerendered",
        "native_media_file",
        "browser_owned_media",
        "remote_stream"
      ]
    },
    "availability": { "enum": ["local_phone", "local_watch", "remote", "browser_only", "missing"] },
    "filePath": { "type": ["string", "null"] },
    "url": { "type": ["string", "null"] },
    "durationMs": { "type": ["integer", "null"], "minimum": 0 },
    "codec": { "type": ["string", "null"] },
    "voiceId": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
