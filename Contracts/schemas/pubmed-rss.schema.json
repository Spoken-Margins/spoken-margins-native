{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pubmed-rss.schema.json",
  "title": "A recorded PubMed search RSS reply (third-party), as validate-contracts.py summarizes its XML",
  "description": "The reply a PubMed saved search's Create RSS link gives, recorded as served. scripts/validate-contracts.py reads the XML into this shape: the channel and, per item, only the fields PubMedPaperReader reads. Fields are open because the reply is PubMed's, not ours.",
  "type": "object",
  "required": ["generator", "title", "items"],
  "properties": {
    "generator": {"type": "string", "pattern": "^PubMed RSS feeds"},
    "title": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "guid", "pubDate", "identifiers", "content"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "guid": {"type": "string", "pattern": "^pubmed:[0-9]+$"},
          "pubDate": {"type": "string", "pattern": "^[A-Z][a-z]{2}, [0-9]{2} [A-Z][a-z]{2} [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2} [+-][0-9]{4}$"},
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "source": {"type": "string"},
          "creators": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "identifiers": {
            "type": "array",
            "contains": {"type": "string", "pattern": "^pmid:[0-9]+$"},
            "items": {"type": "string", "pattern": "^(pmid|doi|pmc|pii|mid):"}
          },
          "content": {"type": "string", "pattern": "<b>(NO )?ABSTRACT</b>"}
        }
      }
    }
  }
}
