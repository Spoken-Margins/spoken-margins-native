{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenmargins.local/schemas/session-export.schema.json",
  "title": "SessionExport",
  "type": "object",
  "required": ["schemaVersion", "item", "session", "timeline", "interjections"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": "spoken-margins.export.v1" },
    "item": {
      "type": "object",
      "required": ["id", "title", "includedFullText"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "externalReference": { "type": ["string", "null"] },
        "sourceURL": { "type": ["string", "null"] },
        "mediaSourceType": { "type": ["string", "null"] },
        "includedFullText": { "type": "boolean" },
        "text": { "type": ["string", "null"] },
        "sourceTranscript": { "type": ["string", "null"] }
      }
    },
    "session": {
      "type": "object",
      "required": ["id", "status", "completionPercent"],
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string" },
        "completionPercent": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "listeningMap": { "type": ["object", "null"] },
    "turns": { "type": "array", "items": { "type": "object" } },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" }
        }
      }
    },
    "interjections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sessionId", "targetType", "targetId", "transcriptionStatus"],
        "properties": {
          "id": { "type": "string" },
          "sessionId": { "type": "string" },
          "targetType": { "type": "string" },
          "targetId": { "type": "string" },
          "roughPercent": { "type": "integer" },
          "anchorBefore": { "type": ["string", "null"] },
          "anchorAfter": { "type": ["string", "null"] },
          "mediaTimeMs": { "type": ["integer", "null"] },
          "transcriptionStatus": { "type": "string" },
          "transcript": { "type": ["string", "null"] },
          "audioPath": { "type": ["string", "null"] },
          "captureKind": { "type": ["string", "null"], "enum": ["audio", "written", null] }
        }
      }
    }
  }
}
