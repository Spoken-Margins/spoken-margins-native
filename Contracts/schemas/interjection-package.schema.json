{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenmargins.local/schemas/interjection-package.schema.json",
  "title": "Spoken Margins reviewed interjection package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "createdAt",
    "contentDigest",
    "source",
    "interjections",
    "redactions"
  ],
  "properties": {
    "schemaVersion": { "const": "spoken-margins.interjection-package.v1" },
    "packageId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createdAt": { "type": "string", "format": "date-time" },
    "contentDigest": { "$ref": "#/$defs/sha256" },
    "senderDisplayLabel": { "type": ["string", "null"], "maxLength": 120 },
    "suggestedRevealMode": { "enum": ["fresh", "companion", "guided"] },
    "source": { "$ref": "#/$defs/source" },
    "interjections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/interjection" }
    },
    "redactions": { "$ref": "#/$defs/redactions" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "httpsURL": { "type": "string", "format": "uri", "pattern": "^[hH][tT][tT][pP][sS]://" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "canonicalURL", "title"],
      "properties": {
        "sourceType": { "enum": ["article", "podcast", "other"] },
        "canonicalURL": { "$ref": "#/$defs/httpsURL" },
        "originalURL": {
          "anyOf": [
            { "$ref": "#/$defs/httpsURL" },
            { "type": "null" }
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "author": { "type": ["string", "null"], "maxLength": 300 },
        "publisher": { "type": ["string", "null"], "maxLength": 300 },
        "showTitle": { "type": ["string", "null"], "maxLength": 500 },
        "episodeGUID": { "type": ["string", "null"], "maxLength": 1000 },
        "enclosureURL": {
          "anyOf": [
            { "$ref": "#/$defs/httpsURL" },
            { "type": "null" }
          ]
        },
        "publishedAt": { "type": ["string", "null"], "maxLength": 100 },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 },
        "normalizedContentSHA256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "exactEditionSHA256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchorType"],
      "properties": {
        "anchorType": { "enum": ["text", "transcript", "media", "turn"] },
        "startChar": { "type": ["integer", "null"], "minimum": 0 },
        "endChar": { "type": ["integer", "null"], "minimum": 0 },
        "exactText": { "type": ["string", "null"], "maxLength": 1000 },
        "prefix": { "type": ["string", "null"], "maxLength": 500 },
        "suffix": { "type": ["string", "null"], "maxLength": 500 },
        "mediaTimeMs": { "type": ["integer", "null"], "minimum": 0 },
        "roughPercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "transcriptSegmentId": { "type": ["string", "null"], "maxLength": 300 },
        "chapterTitle": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "approvedTranscript", "provenance"],
      "properties": {
        "kind": { "enum": ["cleaned_audio_and_text", "text_only"] },
        "approvedTranscript": { "type": "string", "minLength": 1, "maxLength": 50000 },
        "audioPath": { "type": ["string", "null"], "pattern": "^audio/[A-Za-z0-9._-]+\\.m4a$" },
        "audioMimeType": { "type": ["string", "null"], "enum": ["audio/mp4", null] },
        "audioDurationMs": { "type": ["integer", "null"], "minimum": 0, "maximum": 600000 },
        "provenance": {
          "enum": ["deterministic_cleanup_v1_sender_approved", "sender_approved_text_only"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "cleaned_audio_and_text" } } },
          "then": {
            "required": ["audioPath", "audioMimeType", "audioDurationMs"],
            "properties": {
              "audioPath": { "type": "string" },
              "audioMimeType": { "const": "audio/mp4" },
              "audioDurationMs": { "type": "integer" },
              "provenance": { "const": "deterministic_cleanup_v1_sender_approved" }
            }
          },
          "else": {
            "properties": {
              "audioPath": { "type": "null" },
              "audioMimeType": { "type": "null" },
              "audioDurationMs": { "type": "null" },
              "provenance": { "const": "sender_approved_text_only" }
            }
          }
        }
      ]
    },
    "interjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageScopedId", "createdAt", "anchor", "representation"],
      "properties": {
        "packageScopedId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "representation": { "$ref": "#/$defs/representation" }
      }
    },
    "redactions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawAudioOmitted",
        "rawTranscriptOmitted",
        "fullSourceTextOmitted",
        "sourceAudioOmitted",
        "diagnosticsOmitted",
        "filesystemPathsOmitted",
        "unrelatedTurnsOmitted",
        "privateRepresentationsOmitted"
      ],
      "properties": {
        "rawAudioOmitted": { "const": true },
        "rawTranscriptOmitted": { "const": true },
        "fullSourceTextOmitted": { "const": true },
        "sourceAudioOmitted": { "const": true },
        "diagnosticsOmitted": { "const": true },
        "filesystemPathsOmitted": { "const": true },
        "unrelatedTurnsOmitted": { "const": true },
        "privateRepresentationsOmitted": { "const": true }
      }
    }
  }
}
