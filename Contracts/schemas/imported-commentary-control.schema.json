{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenmargins.local/schemas/imported-commentary-control.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["pendingImportedInterjectionId", "commentarySenderLabel", "commentaryIndex", "commentaryCount", "isPlayingImportedCommentary", "availableCommands"],
  "properties": {
    "pendingImportedInterjectionId": { "type": ["string", "null"] },
    "commentarySenderLabel": { "type": ["string", "null"], "maxLength": 120 },
    "commentaryIndex": { "type": ["integer", "null"], "minimum": 1 },
    "commentaryCount": { "type": ["integer", "null"], "minimum": 1, "maximum": 50 },
    "isPlayingImportedCommentary": { "type": "boolean" },
    "availableCommands": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["playImportedInterjection", "stopImportedInterjection"] }
    }
  }
}
