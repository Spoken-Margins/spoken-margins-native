{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice-model-catalog-test-keys.schema.json",
  "title": "Voice catalog fixture keys (#1816)",
  "description": "The public halves of the two keys the voice catalog fixtures are signed with, for the host tests. Test keys only; no production key is ever kept here.",
  "type": "object",
  "required": ["note", "trusted", "untrusted"],
  "additionalProperties": false,
  "properties": {
    "note": {"type": "string"},
    "trusted": {"$ref": "#/$defs/key"},
    "untrusted": {"$ref": "#/$defs/key"}
  },
  "$defs": {
    "key": {
      "type": "object",
      "required": ["keyId", "publicKey"],
      "additionalProperties": false,
      "properties": {
        "keyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])"},
        "publicKey": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=(?![\\s\\S])", "description": "Base64 of the 32-byte Ed25519 public key."}
      }
    }
  }
}
