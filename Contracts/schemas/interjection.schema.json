{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spokenmargins.local/schemas/interjection.schema.json",
  "title": "Interjection",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "itemId",
    "sessionId",
    "targetType",
    "targetId",
    "createdAt",
    "anchor",
    "audio",
    "transcriptionStatus",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "interjection.v1" },
    "id": { "type": "string", "minLength": 1 },
    "itemId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "targetType": { "enum": ["item", "assistant_turn", "summary_turn", "external_media"] },
    "targetId": { "type": "string", "minLength": 1 },
    "chapterId": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "roughPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchorType"],
      "properties": {
        "anchorType": { "enum": ["text", "transcript", "media", "turn"] },
        "startChar": { "type": ["integer", "null"], "minimum": 0 },
        "endChar": { "type": ["integer", "null"], "minimum": 0 },
        "anchorBefore": { "type": ["string", "null"] },
        "anchorAfter": { "type": ["string", "null"] },
        "mediaTimeMs": { "type": ["integer", "null"], "minimum": 0 },
        "playbackRateObserved": { "type": ["number", "null"], "minimum": 0.25, "maximum": 4 },
        "transcriptSegmentId": { "type": ["string", "null"] },
        "turnSegmentIndex": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "saved", "failed", "discarded"] },
        "path": { "type": ["string", "null"] },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "transcriptionStatus": { "enum": ["pending", "transcribed", "failed"] },
    "transcript": { "type": ["string", "null"] },
    "cleanedTranscript": { "type": ["string", "null"] },
    "captureKind": { "type": ["string", "null"], "enum": ["audio", "written", null] },
    "isStarredForSharing": { "type": ["boolean", "null"] },
    "privateSharingNote": { "type": ["string", "null"], "maxLength": 500 },
    "sourceExactEditionSHA256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "podcastAnchorEvidence": {
      "type": ["array", "null"],
      "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "localPath", "durationMs", "anchorOffsetMs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "localPath": { "type": "string", "minLength": 1 },
          "durationMs": { "type": "integer", "minimum": 1 },
          "anchorOffsetMs": { "type": "integer", "minimum": -600000, "maximum": 600000 },
          "provenance": { "enum": ["decoded_playback_stream", "exact_local_playback_edition", "observed_decoded_playback", "source_window_reference", "downloaded_source_reference", null] },
          "windowRole": { "enum": ["pre_interjection", "post_resume", "source_window_before", "source_window_after", null] },
          "byteCount": { "type": ["integer", "null"], "minimum": 1 },
          "checksumSHA256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "podcastAnchorCaptureWindows": {
      "type": ["array", "null"],
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "state", "attempt", "anchorMediaTimeMs"],
        "properties": {
          "role": { "enum": ["pre_interjection", "post_resume"] },
          "state": { "enum": ["waiting", "collecting", "deriving", "committed", "retryableFailure", "unavailable"] },
          "attempt": { "type": "integer", "minimum": 0, "maximum": 3 },
          "anchorMediaTimeMs": { "type": "integer", "minimum": 0 },
          "firstFailureReason": { "type": ["string", "null"] },
          "latestFailureReason": { "type": ["string", "null"] }
        }
      }
    },
    "alignedTranscript": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schemaVersion", "text", "segments"],
      "properties": {
        "schemaVersion": { "const": "aligned-interjection-transcript.v1" },
        "text": { "type": "string" },
        "localeIdentifier": { "type": ["string", "null"] },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "startMs", "endMs"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "startMs": { "type": "integer", "minimum": 0 },
              "endMs": { "type": "integer", "minimum": 1 },
              "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "recognitionChunkId": { "type": ["string", "null"], "minLength": 1 },
              "chunkOffsetMs": { "type": ["integer", "null"], "minimum": 0 }
            }
          }
        }
      }
    },
    "status": { "enum": ["active", "deleted"] },
    "error": { "type": ["string", "null"] }
  }
}
