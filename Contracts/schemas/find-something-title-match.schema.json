{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Find-something title-match table (#5270)",
  "description": "Pairs of episode titles and whether they name the same episode. EpisodeLinkPaste.titlesMatch in SessionKit and titlesMatch in Site/quiz/quiz.js both run every pair, both ways round.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "a",
          "b",
          "match"
        ],
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "match": {
            "type": "boolean"
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
