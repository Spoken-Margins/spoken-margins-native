<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Disk relief: every 15 minutes, check free space; below 50 GiB free, free space until 70 GiB
  (ops/disk/README.md). The lane folder's size cap and evidence age-out run every time. Not installed
  by the PR. Install steps are in the README.
  It runs the main checkout's copy, which the hourly Mac tick fast-forwards to origin/main.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.spokenmargins.disk-relief</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>@HOME@/Documents/GitHub/spoken-margins-native/ops/disk/sm_disk_relief.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@HOME@/SpokenMarginsOps/disk-relief</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/SpokenMarginsOps/disk-relief/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/SpokenMarginsOps/disk-relief/launchd.log</string>
</dict>
</plist>
