<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keep awake: every minute, hold the Mac awake with Amphetamine while builds or agents are
  working, down to 10% battery, lid closed included (ops/power/README.md). Not installed by the PR.
  It runs the main checkout's copy, which the hourly Mac tick fast-forwards to origin/main.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.spokenmargins.keep-awake</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>@HOME@/Documents/GitHub/spoken-margins-native/ops/power/sm_keep_awake.py</string>
    <string>--lid</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@HOME@/SpokenMarginsOps/keep-awake</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/SpokenMarginsOps/keep-awake/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/SpokenMarginsOps/keep-awake/launchd.log</string>
</dict>
</plist>
