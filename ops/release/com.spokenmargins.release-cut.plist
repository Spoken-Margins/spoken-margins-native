<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  One release cut (#687). Template: not installed by the PR. Edit the arguments below (build
  number, start time, PRs to wait for, deadline, known-issues file), then load it as in
  ops/release/README.md. It runs once when loaded: the script waits for the start time itself,
  and its ~/SpokenMarginsOps/release/build-<N>.json stops it running again after a restart.
  Use a full date (YYYY-MM-DDTHH:MM) for times, so a restart after the cut can't mean tomorrow.
  It runs in the owner's login session, so phone-build's signing can use his login keychain.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.spokenmargins.release-cut</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/colemiller/Documents/GitHub/spoken-margins-native/ops/release/cut_candidate.py</string>
    <string>--build</string>
    <string>30</string>
    <string>--at</string>
    <string>2026-10-04T21:00</string>
    <string>--wait-for</string>
    <string>604</string>
    <string>--deadline</string>
    <string>2026-10-04T22:30</string>
    <string>--known-issues</string>
    <string>/Users/colemiller/SpokenMarginsOps/release/known-issues.md</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/colemiller/Documents/GitHub/spoken-margins-native</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>GH_PROMPT_DISABLED</key>
    <string>1</string>
    <key>GIT_TERMINAL_PROMPT</key>
    <string>0</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/colemiller/SpokenMarginsOps/release/log.txt</string>

  <key>StandardErrorPath</key>
  <string>/Users/colemiller/SpokenMarginsOps/release/log.txt</string>
</dict>
</plist>
