{
  "schemaVersion": "session-trace.v1",
  "name": "watch-chapter-navigation",
  "description": "Watch surface displays chapter context and jumps between resolved Listening Map chapters.",
  "runtimeProfile": "watch-tethered",
  "requiresCapabilities": {
    "timeline": ["chapter_timing"],
    "remoteControl": ["display_snapshot", "send_transport_commands", "send_chapter_jump", "send_ai_commands"]
  },
  "fixtures": {
    "item": "fixtures/items/text-with-listening-map.json",
    "listeningMap": "fixtures/maps/valid-listening-map.json"
  },
  "steps": [
    {
      "event": "sessionSnapshotReceived",
      "expect": { "chapterTitle": "Reasonable distrust", "compactSurfaceReady": true }
    },
    {
      "command": "togglePlayPause",
      "expect": { "delegatedToCanonicalRuntime": true, "status": "paused" }
    },
    {
      "command": "togglePlayPause",
      "expect": { "delegatedToCanonicalRuntime": true, "status": "playing" }
    },
    {
      "command": "jumpToChapter",
      "args": { "chapterId": "ch-anecdotes" },
      "expect": { "delegatedToCanonicalRuntime": true, "chapterTitle": "Anecdotes mislead", "targetType": "item_text_tts" }
    },
    {
      "command": "skipForward",
      "args": { "unit": "chapter" },
      "expect": { "delegatedToCanonicalRuntime": true, "chapterTitle": "Inspect process", "targetType": "item_text_tts" }
    },
    {
      "command": "skipForward",
      "args": { "unit": "chapter" },
      "expect": { "delegatedToCanonicalRuntime": true, "chapterTitle": "Inspect process", "noCrash": true }
    },
    {
      "command": "submitFollowup",
      "args": { "text": "Can you respond to my interjection?" },
      "expect": { "delegatedToCanonicalRuntime": true, "phase": "conversation", "lastUserTurnType": "user_response", "pendingAiJobKind": "assistant_response" }
    }
  ],
  "assertions": [
    "Chapter jumps use resolved anchors.",
    "Boundary chapter navigation is idempotent.",
    "Compact surface never needs the current source excerpt.",
    "Watch play/pause and discussion commands delegate to the canonical phone/tablet runtime.",
    "Watch-started interjection recording is intentionally absent until Watch-owned or background-safe capture is available."
  ]
}
