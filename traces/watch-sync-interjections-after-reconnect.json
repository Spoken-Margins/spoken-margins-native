{
  "schemaVersion": "session-trace.v1",
  "name": "watch-sync-interjections-after-reconnect",
  "description": "Phone receives watch-created audio and anchor events after the watch reconnects.",
  "runtimeProfile": "phone-tablet-online",
  "requiresCapabilities": {
    "timeline": ["transcript_segments", "media_time"],
    "interjection": ["capture_transcript_anchor", "capture_media_anchor"],
    "ai": ["cleanup_transcript", "defer_ai_jobs"],
    "sync": ["canonical_persistence", "import_offline_events"]
  },
  "fixtures": {
    "watchPackage": "fixtures/watch/offline-package.json",
    "interjectionEvent": "fixtures/watch/sync-interjection-event.json",
    "positionEvent": "fixtures/watch/sync-position-event.json"
  },
  "steps": [
    {
      "event": "watchReconnected",
      "expect": { "pendingWatchEventCount": 2 }
    },
    {
      "command": "importWatchSyncEvent",
      "args": { "eventId": "watch-event-ij-001" },
      "expect": {
        "createdInterjection": true,
        "lastInterjectionAnchorType": "transcript",
        "lastInterjectionMediaTimeMs": 42000,
        "transcriptionStatus": "pending"
      }
    },
    {
      "command": "importWatchSyncEvent",
      "args": { "eventId": "watch-event-position-001" },
      "expect": { "sessionPositionMediaTimeMs": 62000, "chapterId": "ch-process" }
    },
    {
      "event": "transcriptionCompleted",
      "args": { "interjectionId": "watch-ij-001", "transcript": "This may be answered later in the process section." },
      "expect": { "transcriptionStatus": "transcribed", "canSummarize": true }
    }
  ],
  "assertions": [
    "Watch audio is preserved before transcription.",
    "Phone/iPad handles transcription and cleanup after reconnect.",
    "Imported interjections remain linked to the original session.",
    "Session position updates do not overwrite newer interjection records."
  ]
}
