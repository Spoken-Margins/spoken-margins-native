{
  "schemaVersion": "session-trace.v1",
  "name": "mapless-session-export",
  "description": "A session without a Listening Map still exports useful anchors.",
  "runtimeProfile": "phone-tablet-offline",
  "requiresCapabilities": {
    "timeline": ["text_char_offsets"],
    "sync": ["canonical_persistence"]
  },
  "fixtures": {
    "item": "fixtures/items/text-mapless.json",
    "session": "fixtures/sessions/five-interjections-mapless.json",
    "interjection": "fixtures/interjections/source-interjection.json",
    "export": "fixtures/exports/mapless-session.json"
  },
  "steps": [
    {
      "command": "buildExport",
      "args": {
        "includeFullText": false,
        "includeReference": true,
        "includeListeningMap": false,
        "includeInterjections": true
      },
      "expect": {
        "schemaVersion": "session-export.v1",
        "interjectionCount": 1,
        "containsAnchorBefore": true,
        "containsAnchorAfter": true
      }
    }
  ],
  "assertions": [
    "Export does not depend on chapters.",
    "Portable surrounding text anchors are included.",
    "External reference is preferred over full text by default."
  ]
}
