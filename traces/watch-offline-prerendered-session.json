{
  "schemaVersion": "session-trace.v1",
  "name": "watch-offline-prerendered-session",
  "description": "Watch plays a pre-rendered item package offline and records an interjection with source position metadata.",
  "runtimeProfile": "watch-untethered",
  "requiresCapabilities": {
    "playback": ["prerendered_audio"],
    "timeline": ["transcript_segments", "media_time", "chapter_timing"],
    "interjection": ["record_audio", "capture_transcript_anchor", "capture_media_anchor", "queue_offline_interjections"],
    "sync": ["queue_offline_events", "receive_prepared_packages"]
  },
  "fixtures": {
    "watchPackage": "fixtures/watch/offline-package.json",
    "audioAsset": "fixtures/audio/prerendered-pill-audio.json"
  },
  "steps": [
    {
      "command": "loadWatchPackage",
      "args": { "watchPackageId": "watch-package-pill-001" },
      "expect": { "offlineReady": true, "chapterTitle": "Reasonable distrust", "targetType": "transcript_backed_media" }
    },
    {
      "command": "play",
      "expect": { "status": "playing", "mediaTimeMs": 0 }
    },
    {
      "command": "jumpToChapter",
      "args": { "chapterId": "ch-anecdotes" },
      "expect": { "status": "playing", "mediaTimeMs": 14000, "chapterTitle": "Anecdotes mislead" }
    },
    {
      "command": "beginInterjection",
      "expect": { "phase": "recording_interjection", "capturedMediaTimeMs": 42000, "capturedTranscriptSegmentId": "seg-pill-003" }
    },
    {
      "command": "finishInterjection",
      "args": { "audioRef": "watch-ij-001.m4a" },
      "expect": { "queuedWatchSyncEventType": "interjection_recorded", "status": "playing" }
    }
  ],
  "assertions": [
    "The watch does not need network connectivity.",
    "The watch does not transcribe or call AI.",
    "Interjection anchor uses package media time and transcript segment.",
    "Playback resumes from the package rollback unit."
  ]
}
