{
  "schemaVersion": "session-trace.v1",
  "name": "semantic-navigation-and-rollback",
  "description": "Back/forward and post-interjection rollback use coherent semantic units rather than local chunk ids.",
  "runtimeProfile": "phone-tablet-online",
  "requiresCapabilities": {
    "playback": ["realtime_tts"],
    "timeline": ["text_char_offsets", "chapter_timing"],
    "interjection": ["record_audio", "capture_text_anchor"],
    "sync": ["canonical_persistence"]
  },
  "fixtures": {
    "item": "fixtures/items/text-with-listening-map.json",
    "listeningMap": "fixtures/maps/valid-listening-map.json"
  },
  "steps": [
    {
      "command": "startSession",
      "args": { "itemId": "item-pill" },
      "expect": { "phase": "item_playback", "status": "playing" }
    },
    {
      "command": "skipForward",
      "args": { "unit": "sentence" },
      "expect": {
        "landedOnSemanticBoundary": true,
        "anchorType": "text",
        "notExposedAsChunkContract": true
      }
    },
    {
      "command": "skipBack",
      "args": { "unit": "paragraph" },
      "expect": {
        "landedOnSemanticBoundary": true,
        "noCrash": true
      }
    },
    {
      "command": "seekText",
      "args": { "charOffset": 40 },
      "expect": {
        "status": "playing",
        "landedOnSemanticBoundary": false
      }
    },
    {
      "command": "beginInterjection",
      "expect": {
        "phase": "recording_interjection",
        "capturedAnchorType": "text"
      }
    },
    {
      "command": "finishInterjection",
      "args": { "audioRef": "interjections/semantic-nav-001.m4a" },
      "expect": {
        "phase": "item_playback",
        "rollbackPolicyApplied": true,
        "listenerReoriented": true,
        "lastInterjectionAnchorType": "text"
      }
    }
  ],
  "assertions": [
    "Navigation is judged by coherent source units, not prototype chunk ids.",
    "Back/forward are safe at boundaries.",
    "Rollback policy is observable in tests.",
    "Rollback resumes with enough prior context to reorient the listener."
  ]
}
