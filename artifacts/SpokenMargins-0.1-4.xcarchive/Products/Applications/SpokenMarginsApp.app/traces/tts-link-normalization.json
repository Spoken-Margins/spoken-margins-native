{
  "schemaVersion": "session-trace.v1",
  "name": "tts-link-normalization",
  "description": "Text sent to speech removes distracting URLs while preserving source text and readable Markdown link labels.",
  "runtimeProfile": "phone-tablet-online",
  "requiresCapabilities": {
    "playback": ["realtime_tts"],
    "timeline": ["text_char_offsets"],
    "sync": ["canonical_persistence"]
  },
  "fixtures": {
    "item": "fixtures/items/text-with-links.json"
  },
  "steps": [
    {
      "command": "prepareSpeechText",
      "args": { "itemId": "item-links-001", "targetType": "item_text_tts" },
      "expect": {
        "spokenTextContains": ["Read the article at before the next paragraph.", "A labeled reference stays readable."],
        "spokenTextDoesNotContain": ["https://example.com/a/b?c=d", "https://example.com/essay", "example.org/path"],
        "sourceTextUnchanged": true
      }
    },
    {
      "command": "buildExport",
      "args": { "includeFullText": true, "includeReference": true, "includeListeningMap": false, "includeInterjections": false },
      "expect": {
        "exportContains": ["https://example.com/a/b?c=d", "[reference](https://example.com/essay)", "example.org/path"]
      }
    }
  ],
  "assertions": [
    "URL cleanup is a TTS rendering concern only.",
    "Markdown link labels remain readable in spoken output.",
    "Raw URLs and bare domains are not spoken.",
    "Source text and exports preserve original content."
  ]
}
