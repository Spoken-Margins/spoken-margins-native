{
  "schemaVersion": "session-trace.v1",
  "name": "interjection-representation-lifecycles",
  "description": "Interjection audio, raw transcript, cleaned transcript, and display text have separate lifecycle rules.",
  "runtimeProfile": "phone-tablet-online",
  "requiresCapabilities": {
    "interjection": ["record_audio", "capture_text_anchor"],
    "ai": ["cleanup_transcript", "defer_ai_jobs"],
    "sync": ["canonical_persistence"]
  },
  "fixtures": {
    "item": "fixtures/items/text-mapless.json",
    "session": "fixtures/sessions/five-interjections-mapless.json",
    "interjection": "fixtures/interjections/source-interjection.json"
  },
  "steps": [
    {
      "event": "transcriptionCompleted",
      "args": { "interjectionId": "ij-source-001", "transcript": "This list works, but it feels repetitive." },
      "expect": {
        "audioPreserved": true,
        "rawTranscriptSaved": true,
        "cleanedTranscriptStatus": "pending"
      }
    },
    {
      "event": "cleanupCompleted",
      "args": { "interjectionId": "ij-source-001", "cleanedTranscript": "This list works, but it feels repetitive." },
      "expect": {
        "audioPreserved": true,
        "rawTranscriptPreserved": true,
        "cleanedTranscriptSaved": true
      }
    },
    {
      "command": "deleteRepresentation",
      "args": { "interjectionId": "ij-source-001", "representation": "cleanedTranscript" },
      "expect": {
        "requiresExplicitIntent": true,
        "audioPreserved": true,
        "rawTranscriptPreserved": true,
        "interjectionPreserved": true
      }
    }
  ],
  "assertions": [
    "Audio, raw transcript, cleaned transcript, and display text are distinct representations.",
    "Deleting one representation does not silently delete the others.",
    "Destructive actions require explicit intent.",
    "The exact transcript deletion UX is not frozen by this trace."
  ]
}
