{
  "schemaVersion": "session-trace.v1",
  "name": "interject-into-summary-then-discuss",
  "description": "Finish original item, summarize interjections, interject into the summary, add an addendum, and start discussion.",
  "runtimeProfile": "phone-tablet-online",
  "requiresCapabilities": {
    "playback": ["summary_turn_tts", "assistant_turn_tts"],
    "interjection": ["record_audio", "capture_turn_anchor"],
    "ai": ["summarize_interjections", "continue_discussion"],
    "sync": ["canonical_persistence"]
  },
  "fixtures": {
    "item": "fixtures/items/text-with-listening-map.json",
    "session": "fixtures/sessions/summary-addendum-discussion.json",
    "turns": "fixtures/turns/summary-and-response.json"
  },
  "steps": [
    {
      "command": "generateInterjectionSummary",
      "args": { "scope": { "targetType": "item" } },
      "expect": { "pendingAiJobKind": "interjection_summary" }
    },
    {
      "event": "aiJobCompleted",
      "args": { "turnId": "turn-summary-001" },
      "expect": { "phase": "interjection_summary", "turnStatus": "complete" }
    },
    {
      "command": "playTurn",
      "args": { "turnId": "turn-summary-001" },
      "expect": { "phase": "summary_playback", "targetType": "summary_turn_tts" }
    },
    {
      "command": "beginInterjection",
      "expect": { "phase": "recording_interjection", "recordingTargetId": "turn-summary-001" }
    },
    {
      "command": "finishInterjection",
      "args": { "audioRef": "interjections/ij-summary-001.m4a" },
      "expect": { "phase": "summary_playback", "lastInterjectionTargetType": "summary_turn" }
    },
    {
      "command": "submitFollowup",
      "args": { "input": { "type": "text", "text": "Add that I am mainly worried about regression to the mean." } },
      "expect": { "phase": "conversation", "lastUserTurnType": "user_response", "pendingAiJobKind": "assistant_response" }
    },
    {
      "event": "aiJobCompleted",
      "args": { "turnId": "turn-response-001" },
      "expect": { "phase": "conversation", "turnStatus": "complete" }
    }
  ],
  "assertions": [
    "Summary turn remains linked to the original session.",
    "Summary interjection targets the summary turn, not the source item.",
    "Addendum/follow-up becomes a user turn in the same session.",
    "Discussion response can later be played and interjected into."
  ]
}
