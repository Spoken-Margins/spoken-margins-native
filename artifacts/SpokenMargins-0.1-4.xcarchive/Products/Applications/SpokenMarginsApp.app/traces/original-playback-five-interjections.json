{
  "schemaVersion": "session-trace.v1",
  "name": "original-playback-five-interjections",
  "description": "Start original text playback, record five interjections, and resume after rollback each time.",
  "runtimeProfile": "phone-tablet-online",
  "requiresCapabilities": {
    "playback": ["realtime_tts"],
    "timeline": ["text_char_offsets", "chapter_timing"],
    "interjection": ["record_audio", "capture_text_anchor"],
    "sync": ["canonical_persistence"]
  },
  "fixtures": {
    "item": "fixtures/items/text-with-listening-map.json",
    "listeningMap": "fixtures/maps/valid-listening-map.json",
    "session": null
  },
  "steps": [
    {
      "command": "startSession",
      "args": { "itemId": "item-pill" },
      "expect": { "phase": "item_playback", "status": "playing", "targetType": "item_text_tts" }
    },
    {
      "command": "beginInterjection",
      "expect": { "phase": "recording_interjection", "status": "recording", "isRecording": true }
    },
    {
      "command": "finishInterjection",
      "args": { "audioRef": "interjections/ij-001.m4a" },
      "expect": { "phase": "item_playback", "status": "playing", "activeInterjectionCount": 1 }
    },
    {
      "command": "beginInterjection",
      "expect": { "phase": "recording_interjection", "isRecording": true }
    },
    {
      "command": "finishInterjection",
      "args": { "audioRef": "interjections/ij-002.m4a" },
      "expect": { "phase": "item_playback", "status": "playing", "activeInterjectionCount": 2 }
    },
    {
      "command": "beginInterjection",
      "expect": { "phase": "recording_interjection", "isRecording": true }
    },
    {
      "command": "finishInterjection",
      "args": { "audioRef": "interjections/ij-003.m4a" },
      "expect": { "phase": "item_playback", "status": "playing", "activeInterjectionCount": 3 }
    },
    {
      "command": "beginInterjection",
      "expect": { "phase": "recording_interjection", "isRecording": true }
    },
    {
      "command": "finishInterjection",
      "args": { "audioRef": "interjections/ij-004.m4a" },
      "expect": { "phase": "item_playback", "status": "playing", "activeInterjectionCount": 4 }
    },
    {
      "command": "beginInterjection",
      "expect": { "phase": "recording_interjection", "isRecording": true }
    },
    {
      "command": "finishInterjection",
      "args": { "audioRef": "interjections/ij-005.m4a" },
      "expect": { "phase": "item_playback", "status": "playing", "activeInterjectionCount": 5 }
    }
  ],
  "assertions": [
    "Every interjection belongs to the session.",
    "Every interjection has a portable text anchor.",
    "Playback resumes from a rollback point after each saved interjection.",
    "No async map or transcript completion can overwrite the five interjections."
  ]
}
