{
  "schemaVersion": "session-trace.v1",
  "name": "phone-offline-deferred-ai",
  "description": "Phone/tablet offline playback and interjection capture continue, but summary and discussion AI work is deferred.",
  "runtimeProfile": "phone-tablet-offline",
  "requiresCapabilities": {
    "playback": ["realtime_tts"],
    "timeline": ["text_char_offsets"],
    "interjection": ["record_audio", "capture_text_anchor"],
    "ai": ["defer_ai_jobs"],
    "sync": ["canonical_persistence"]
  },
  "fixtures": {
    "item": "fixtures/items/text-mapless.json",
    "session": null
  },
  "steps": [
    {
      "command": "startSession",
      "args": { "itemId": "item-pill" },
      "expect": { "phase": "item_playback", "status": "playing", "targetType": "item_text_tts" }
    },
    {
      "command": "beginInterjection",
      "expect": { "phase": "recording_interjection", "isRecording": true }
    },
    {
      "command": "finishInterjection",
      "args": { "audioRef": "interjections/offline-ij-001.m4a" },
      "expect": {
        "phase": "item_playback",
        "status": "playing",
        "lastInterjectionAnchorType": "text",
        "transcriptionStatus": "pending"
      }
    },
    {
      "command": "generateInterjectionSummary",
      "args": { "scope": { "targetType": "item" } },
      "expect": {
        "pendingAiJobKind": "interjection_summary",
        "pendingAiJobStatus": "deferred",
        "providerCallStarted": false
      }
    },
    {
      "command": "submitFollowup",
      "args": { "input": { "type": "text", "text": "Save this as a question for later discussion." } },
      "expect": {
        "phase": "conversation",
        "pendingAiJobKind": "assistant_response",
        "pendingAiJobStatus": "deferred",
        "providerCallStarted": false
      }
    }
  ],
  "assertions": [
    "Offline phone/tablet mode can continue playback and recording.",
    "Interjections remain durable and anchored while offline.",
    "Summary and discussion commands create deferred AI jobs instead of remote provider calls.",
    "Provider diagnostics, map generation, summarization, and discussion are not treated as immediately available."
  ]
}
