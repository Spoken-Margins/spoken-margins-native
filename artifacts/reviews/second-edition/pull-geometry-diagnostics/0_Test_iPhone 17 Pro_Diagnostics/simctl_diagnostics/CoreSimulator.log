	        "LLVM_PROFILE_FILE" = "/var/folders/wl/bzxblr0n30l1_8v666j7xnx40000gn/T/com.spokenmargins.native/90D9A03E-0E13-4229-9A8C-8A5D127A1641-60207-00000117A87549E3/B4DE1AFE-9EA6-4602-A569-17FFB1F6406E-%p%c.profraw";
	        NSApplicationQuitWithoutSuddenTermination = YES;
